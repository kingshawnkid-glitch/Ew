<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX00000023">
		<Properties>
			<string name="Name">EWInteractionMenu</string>
		</Properties>
		<Item class="LocalScript" referent="RBX00000024">
			<Properties>
				<string name="Name">Controller</string>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[--[[
	EW Interaction Menu - Controller (LocalScript)
	Rebuilt from the provided "INTERACTION MENU" for EW equipment only. The Combat
	Breaching module, its ReplicatedStorage dependency and the INTERACT_MENU tag
	requirement are gone: any object holding an EWDetectable BoolValue (e.g. the
	EW jammer backpack) is picked up automatically.

	USE
	  Hold Left Alt (keyboard) or R3 (gamepad) near EW gear, or tap the EW button
	  on touch devices. A white dot + label appears on the gear (same look as the
	  original menu). Click it to open the device menu: Power, Emission, Mode >,
	  Battery >, Status. Labels and dot colours show the server's live state.

	INTERACTION POINTS (optional, for gear like the screenshot)
	  Add Attachments named "EWInteract" anywhere inside the device, with:
	    EWAction (string) = "Menu" | "Power" | "Emission" | "Battery" | "Mode" | "Status"
	    Text     (string) = optional label override, e.g. "JAMMER CONTROL"
	  Without any EWInteract attachment the device gets one "Menu" point at its
	  main part (the part holding the BoolValue, or Handle / PrimaryPart).

	ROOT RULES (mirror the server registry): EWDeviceRoot attribute ancestor,
	Tool, worn Accessory, Model, or the BasePart itself.

	The client only REQUESTS. The server validates ownership (carrier or nearby
	teammate), range, rate limits and replies with authoritative state.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Templates = require(script.Parent:WaitForChild("Templates"))
local interactsFolder = script.Parent:WaitForChild("Interacts")

local CONFIG = {
	HoldKeys = { Enum.KeyCode.LeftAlt, Enum.KeyCode.ButtonR3 },
	FlagName = "EWDetectable",
	PointAttachmentName = "EWInteract",
	RootOverrideAttribute = "EWDeviceRoot",
	DefaultModule = "EW",
	SelectorDegreesPerSecond = 110,
	VisibilityCheckSeconds = 0.1,
}

--------------------------------------------------------------------------------
-- Modules (Interacts folder): EW by default; a device may name another with
-- the attribute EWMenuModule on its root.
--------------------------------------------------------------------------------
local modules = {}
for _, module in ipairs(interactsFolder:GetChildren()) do
	if module:IsA("ModuleScript") then
		modules[module.Name] = require(module)
	end
end

--------------------------------------------------------------------------------
-- Local UI root (click sound, touch toggle)
--------------------------------------------------------------------------------
local screen = Instance.new("ScreenGui")
screen.Name = "EWInteractionMenu"
screen.ResetOnSpawn = false
screen.Parent = playerGui

local clickSound = Instance.new("Sound")
clickSound.Name = "Clicked"
clickSound.SoundId = Templates.ClickSoundId
clickSound.Volume = 0.1
clickSound.Parent = screen

local character = player.Character or player.CharacterAdded:Wait()
local characterRoot: BasePart? = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?

local holding = false
local touchToggled = false
local activeSelector: ImageLabel? = nil

--------------------------------------------------------------------------------
-- Device tracking
--------------------------------------------------------------------------------
type Point = {
	Attachment: Attachment,
	Action: string,
	Label: string?,
	Generated: boolean,
	Gui: BillboardGui?,
	Opened: string?, -- id of the entry whose third column is open
}

type Device = {
	Flag: BoolValue,
	Root: Instance,
	Anchor: BasePart?,
	DisplayName: string,
	Module: any,
	Points: { Point },
	PointsDirty: boolean,
	Connections: { RBXScriptConnection },
	InRange: boolean,
}

local devices: { [Instance]: Device } = {}

local function isCharacterModel(inst: Instance): boolean
	return inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") ~= nil
end

local function rootForPart(part: BasePart): Instance
	local model = part.Parent
	if model and model:IsA("Model") and model ~= workspace and not isCharacterModel(model) then
		return model
	end
	return part
end

local function resolveRoot(flag: Instance): Instance?
	local parent = flag.Parent
	if parent == nil or parent == workspace then
		return nil
	end
	local node: Instance? = parent
	while node and node ~= workspace and node ~= game do
		if node:GetAttribute(CONFIG.RootOverrideAttribute) == true then
			return node
		end
		node = node.Parent
	end
	if parent:IsA("Tool") then
		return parent
	end
	local tool = parent:FindFirstAncestorOfClass("Tool")
	if tool then
		return tool
	end
	if parent:IsA("Accessory") then
		return parent
	end
	local accessory = parent:FindFirstAncestorOfClass("Accessory")
	if accessory then
		return accessory
	end
	if parent:IsA("Model") and parent ~= workspace and not isCharacterModel(parent) then
		return parent
	end
	if parent:IsA("BasePart") then
		return rootForPart(parent)
	end
	local part = parent:FindFirstAncestorWhichIsA("BasePart")
	if part then
		return rootForPart(part)
	end
	return nil
end

local function findAnchor(flag: Instance, root: Instance): BasePart?
	if flag.Parent and flag.Parent:IsA("BasePart") then
		return flag.Parent :: BasePart
	end
	if root:IsA("BasePart") then
		return root
	end
	local handle = root:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then
		return handle
	end
	if root:IsA("Model") and root.PrimaryPart then
		return root.PrimaryPart
	end
	return root:FindFirstChildWhichIsA("BasePart", true)
end

local function destroyPointGui(point: Point)
	if point.Gui then
		point.Gui:Destroy()
		point.Gui = nil
	end
	point.Opened = nil
end

local function clearPoints(device: Device)
	for _, point in ipairs(device.Points) do
		destroyPointGui(point)
		if point.Generated and point.Attachment then
			point.Attachment:Destroy()
		end
	end
	table.clear(device.Points)
end

local function buildPoints(device: Device)
	clearPoints(device)
	for _, desc in ipairs(device.Root:GetDescendants()) do
		if desc:IsA("Attachment") and (desc.Name == CONFIG.PointAttachmentName or desc:GetAttribute("EWAction") ~= nil) then
			local action = desc:GetAttribute("EWAction")
			local label = desc:GetAttribute("Text")
			table.insert(device.Points, {
				Attachment = desc,
				Action = if type(action) == "string" then action else "Menu",
				Label = if type(label) == "string" then label else nil,
				Generated = false,
				Gui = nil,
				Opened = nil,
			})
		end
	end
	if #device.Points == 0 and device.Anchor then
		local attachment = Instance.new("Attachment")
		attachment.Name = "EWMenuPoint"
		attachment.Parent = device.Anchor -- local only; never replicates
		table.insert(device.Points, {
			Attachment = attachment,
			Action = "Menu",
			Label = nil,
			Generated = true,
			Gui = nil,
			Opened = nil,
		})
	end
	device.PointsDirty = false
end

local function untrack(flag: Instance)
	local device = devices[flag]
	if not device then
		return
	end
	devices[flag] = nil
	clearPoints(device)
	for _, connection in ipairs(device.Connections) do
		connection:Disconnect()
	end
	if device.Module.Detach then
		device.Module:Detach(device)
	end
end

local refreshDevice -- forward

local function track(flag: Instance)
	if devices[flag] or not flag:IsA("BoolValue") or flag.Name ~= CONFIG.FlagName then
		return
	end
	local root = resolveRoot(flag)
	if not root then
		return
	end
	local moduleName = root:GetAttribute("EWMenuModule")
	local module = modules[if type(moduleName) == "string" then moduleName else CONFIG.DefaultModule] or modules[CONFIG.DefaultModule]
	if not module then
		return
	end
	local nameAttr = root:GetAttribute("CustomDisplayName")
	local device: Device = {
		Flag = flag :: BoolValue,
		Root = root,
		Anchor = findAnchor(flag, root),
		DisplayName = if type(nameAttr) == "string" and nameAttr ~= "" then nameAttr else root.Name,
		Module = module,
		Points = {},
		PointsDirty = true,
		Connections = {},
		InRange = false,
	}
	devices[flag] = device
	local function markDirty(desc: Instance)
		if desc:IsA("Attachment") or desc:IsA("BasePart") then
			device.PointsDirty = true
		end
	end
	table.insert(device.Connections, root.DescendantAdded:Connect(markDirty))
	table.insert(device.Connections, root.DescendantRemoving:Connect(markDirty))
	if module.Attach then
		module:Attach(device)
	end
end

-- Discovery: one scan, then events (handles streaming in/out and respawns).
workspace.DescendantAdded:Connect(function(inst)
	if inst.ClassName == "BoolValue" and inst.Name == CONFIG.FlagName then
		task.defer(track, inst)
	end
end)
workspace.DescendantRemoving:Connect(function(inst)
	if devices[inst] then
		untrack(inst)
		-- Reparented within the world (e.g. gear moved between models)? Track again.
		task.defer(function()
			if inst.Parent and inst:IsDescendantOf(workspace) then
				track(inst)
			end
		end)
	end
end)
for _, inst in ipairs(workspace:GetDescendants()) do
	if inst.ClassName == "BoolValue" and inst.Name == CONFIG.FlagName then
		track(inst)
	end
end

--------------------------------------------------------------------------------
-- GUI behaviour
--------------------------------------------------------------------------------
local function connectHover(button: TextButton, selector: ImageLabel, onClick: () -> ())
	button.MouseEnter:Connect(function()
		if activeSelector and activeSelector ~= selector then
			activeSelector.Visible = false
		end
		activeSelector = selector
		selector.Visible = true
	end)
	button.MouseLeave:Connect(function()
		if activeSelector == selector then
			selector.Visible = false
			activeSelector = nil
		end
	end)
	button.Activated:Connect(function()
		clickSound:Play()
		onClick()
	end)
end

local function setLabel(button: Instance, text: string, color: Color3?)
	local object = button:FindFirstChild("Object") :: ImageLabel
	local title = object and object:FindFirstChild("Title") :: TextLabel
	if title then
		title.Text = text
	end
	if object and color then
		object.ImageColor3 = color
	end
end

local function clearList(frame: Instance)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

local fillSection -- forward

local function fillList(device: Device, point: Point, frame: Frame, entries, isThirdColumn: boolean)
	clearList(frame)
	local gui = point.Gui :: BillboardGui
	local third = gui:FindFirstChild("Interacts") :: Frame
	for _, entry in ipairs(entries) do
		local option = Templates.CreateOption()
		option.Name = entry.Id
		option.LayoutOrder = entry.Order or 0
		option.Visible = true
		setLabel(option, entry.Text)
		local object = option:FindFirstChild("Object") :: ImageLabel
		connectHover(option, object:FindFirstChild("Selector") :: ImageLabel, function()
			if entry.Children and not isThirdColumn then
				if point.Opened == entry.Id then
					point.Opened = nil
					third.Visible = false
					clearList(third)
				else
					point.Opened = entry.Id
					third.Visible = true
					fillList(device, point, third, entry.Children(), true)
				end
			elseif entry.Run then
				entry.Run()
			end
		end)
		option.Parent = frame
	end
end

fillSection = function(device: Device, point: Point)
	local gui = point.Gui
	if not gui then
		return
	end
	local section = gui:FindFirstChild("Section") :: Frame
	local third = gui:FindFirstChild("Interacts") :: Frame
	fillList(device, point, section, device.Module:Entries(point.Action, device), false)
	-- Keep an open third column in sync with fresh state.
	if point.Opened then
		local opened = nil
		for _, entry in ipairs(device.Module:Entries(point.Action, device)) do
			if entry.Id == point.Opened and entry.Children then
				opened = entry
			end
		end
		if opened then
			fillList(device, point, third, opened.Children(), true)
		else
			point.Opened = nil
			third.Visible = false
			clearList(third)
		end
	end
end

local function createPointGui(device: Device, point: Point)
	local gui = Templates.CreateBillboard()
	gui.Adornee = point.Attachment
	gui.Parent = playerGui
	point.Gui = gui
	local main = gui:FindFirstChild("Main") :: TextButton
	local object = main:FindFirstChild("Object") :: ImageLabel
	local section = gui:FindFirstChild("Section") :: Frame
	local third = gui:FindFirstChild("Interacts") :: Frame
	setLabel(main, device.Module:PointLabel(point.Action, device, point.Label), device.Module:PointColor(point.Action, device))
	connectHover(main, object:FindFirstChild("Selector") :: ImageLabel, function()
		if device.Module:OpensList(point.Action) then
			section.Visible = not section.Visible
			if section.Visible then
				fillSection(device, point)
				device.Module:RequestStatus(device, true)
			else
				third.Visible = false
				point.Opened = nil
			end
		else
			device.Module:Run(point.Action, device)
		end
	end)
	device.Module:RequestStatus(device, false)
end

refreshDevice = function(device: Device)
	for _, point in ipairs(device.Points) do
		local gui = point.Gui
		if gui then
			local main = gui:FindFirstChild("Main") :: TextButton
			setLabel(main, device.Module:PointLabel(point.Action, device, point.Label), device.Module:PointColor(point.Action, device))
			local section = gui:FindFirstChild("Section") :: Frame
			if section.Visible then
				fillSection(device, point)
			end
		end
	end
end

for _, module in pairs(modules) do
	if module.StatusChanged then
		module.StatusChanged:Connect(function(device)
			if devices[device.Flag] == device then
				refreshDevice(device)
			end
		end)
	end
end

local function hideDevice(device: Device)
	for _, point in ipairs(device.Points) do
		destroyPointGui(point)
	end
	device.InRange = false
end

local function clearMenus()
	for _, device in pairs(devices) do
		hideDevice(device)
	end
	if activeSelector then
		activeSelector.Visible = false
		activeSelector = nil
	end
end

local function distanceTo(device: Device): number
	local root = characterRoot
	local anchor = device.Anchor
	if not (root and anchor and anchor.Parent) then
		return math.huge
	end
	return (anchor.Position - root.Position).Magnitude
end

local function updateVisibility()
	for _, device in pairs(devices) do
		if not (device.Anchor and device.Anchor.Parent) then
			device.Anchor = findAnchor(device.Flag, device.Root)
			device.PointsDirty = true
		end
		local inRange = distanceTo(device) <= (device.Module.Settings and device.Module.Settings.Distance or 10)
		if inRange then
			if device.PointsDirty then
				buildPoints(device)
			end
			for _, point in ipairs(device.Points) do
				if not point.Gui and point.Attachment.Parent then
					createPointGui(device, point)
				end
			end
			device.InRange = true
			device.Module:RequestStatus(device, false)
		elseif device.InRange then
			hideDevice(device)
		end
	end
end

--------------------------------------------------------------------------------
-- Input
--------------------------------------------------------------------------------
local function setHolding(value: boolean)
	if holding == value then
		return
	end
	holding = value
	if holding then
		updateVisibility()
	else
		clearMenus()
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if table.find(CONFIG.HoldKeys, input.KeyCode) then
		setHolding(true)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if table.find(CONFIG.HoldKeys, input.KeyCode) then
		if not touchToggled then
			setHolding(false)
		end
	end
end)

if UserInputService.TouchEnabled then
	local toggle = Instance.new("TextButton")
	toggle.Name = "EWMenuToggle"
	toggle.AnchorPoint = Vector2.new(1, 1)
	toggle.Position = UDim2.new(1, -16, 1, -180)
	toggle.Size = UDim2.fromOffset(64, 40)
	toggle.BackgroundColor3 = Color3.fromRGB(18, 22, 18)
	toggle.BackgroundTransparency = 0.25
	toggle.TextColor3 = Color3.new(1, 1, 1)
	toggle.Font = Enum.Font.SourceSansBold
	toggle.TextSize = 18
	toggle.Text = "EW"
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = toggle
	toggle.Parent = screen
	toggle.Activated:Connect(function()
		touchToggled = not touchToggled
		toggle.Text = if touchToggled then "EW ON" else "EW"
		setHolding(touchToggled)
	end)
end

player.CharacterAdded:Connect(function(newCharacter)
	character = newCharacter
	characterRoot = newCharacter:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	clearMenus()
	holding = touchToggled
end)

local sinceCheck = 0
RunService.PreRender:Connect(function(dt)
	if holding then
		sinceCheck += dt
		if sinceCheck >= CONFIG.VisibilityCheckSeconds then
			sinceCheck = 0
			updateVisibility()
		end
	end
	if activeSelector then
		activeSelector.Rotation += CONFIG.SelectorDegreesPerSecond * dt
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX00000025">
			<Properties>
				<string name="Name">Interacts</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX00000026">
				<Properties>
					<string name="Name">EW</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EW (Interaction Menu module)
	EW-equipment options for the Interaction Menu: the jammer backpack and any
	other device carrying an EWDetectable BoolValue (radios, beacons, sensors).

	Everything here is a REQUEST. The server validates rate, schema, carrier /
	teammate / range authorization and replies with the authoritative state,
	which this module caches to drive the labels.

	POINT ACTIONS (attribute EWAction on an "EWInteract" Attachment)
	  Menu      opens the full device menu (default when a device has no points)
	  Power     toggles power directly
	  Emission  toggles radiating (jammers / beacons; radios use PTT)
	  Battery   opens battery options (swap / check)
	  Mode      opens the operating-mode list (e.g. BARRAGE VHF / BARRAGE UHF / SPOT)
	  Status    shows a status readout
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("EWShared")
local EWRemotes = require(Shared:WaitForChild("EWRemotes"))
local SharedUtilities = require(Shared:WaitForChild("SharedUtilities"))

local commandRemote = EWRemotes.Get("DeviceCommand") :: RemoteEvent?
local statusRemote = EWRemotes.Get("DeviceStatus") :: RemoteEvent?

local EW = {}

EW.Settings = {
	Distance = 10, -- display distance; the server enforces its own interaction range
	StatusRefreshSeconds = 2.5, -- while a device's menu is visible
}

-- Pure-Lua signal: BindableEvents would copy the device table and break identity.
EW.StatusChanged = SharedUtilities.Signal.new("EWMenuStatusChanged") -- fires (device)

local statuses: { [Instance]: any } = {} -- device.Flag -> last server payload
local lastQuery: { [Instance]: number } = {}
local pendingReadout: { [Instance]: boolean } = {}
local devices: { [Instance]: any } = {} -- flag -> device (attached by the controller)
local lastGlobalQuery = 0

local C = {
	On = "#7CFC00",
	Busy = "#FFD24A",
	Off = "#FF4B4B",
	Dim = "#A8A8A8",
	Hot = "#FF8A1F",
}

local function tag(text: string, color: string): string
	return string.format('<font color="%s">[%s]</font>', color, text)
end

local function notify(title: string, text: string)
	pcall(function()
		StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = 5 })
	end)
end

local function send(action: string, device, extra: { [string]: any }?)
	if not commandRemote then
		return
	end
	local payload = { Action = action, Device = device.Flag }
	if extra then
		for k, v in pairs(extra) do
			payload[k] = v
		end
	end
	commandRemote:FireServer(payload)
end

local function readout(status): string
	local parts = { status.PowerState or "?" }
	if type(status.BatteryPercent) == "number" then
		table.insert(parts, string.format("BATT %d%%", status.BatteryPercent))
	end
	if status.ManualEmission then
		table.insert(parts, if status.Emitting then "RADIATING" else "SILENT")
	end
	if status.ModeLabel then
		table.insert(parts, status.ModeLabel)
	end
	if type(status.FrequencyMHz) == "number" then
		table.insert(parts, string.format("%.3f MHz", status.FrequencyMHz))
	end
	if type(status.SpareBatteries) == "number" then
		table.insert(parts, string.format("%d spare", status.SpareBatteries))
	end
	return table.concat(parts, "  |  ")
end

-- Server replies: match them to every tracked device inside the reported root.
if statusRemote then
	statusRemote.OnClientEvent:Connect(function(payload)
		if type(payload) ~= "table" or typeof(payload.Root) ~= "Instance" then
			return
		end
		for flag, device in pairs(devices) do
			if device.Root == payload.Root or flag:IsDescendantOf(payload.Root) then
				statuses[flag] = payload
				if pendingReadout[flag] then
					pendingReadout[flag] = nil
					notify(payload.DisplayName or "EW device", readout(payload))
				end
				EW.StatusChanged:Fire(device)
			end
		end
	end)
end

function EW:Attach(device)
	devices[device.Flag] = device
end

function EW:Detach(device)
	devices[device.Flag] = nil
	statuses[device.Flag] = nil
	lastQuery[device.Flag] = nil
	pendingReadout[device.Flag] = nil
end

function EW:GetStatus(device)
	return statuses[device.Flag]
end

-- Throttled status request (stays well inside the server's rate limit).
function EW:RequestStatus(device, force: boolean?)
	local now = os.clock()
	local last = lastQuery[device.Flag] or 0
	if not force and now - last < self.Settings.StatusRefreshSeconds then
		return
	end
	if now - lastGlobalQuery < 0.35 and not force then
		return
	end
	lastQuery[device.Flag] = now
	lastGlobalQuery = now
	send("QueryStatus", device)
end

local function powerTag(status): string
	if not status then
		return tag("--", C.Dim)
	end
	local s = status.PowerState
	if s == "On" then
		return tag("ON", C.On)
	elseif s == "Booting" then
		return tag("BOOTING", C.Busy)
	elseif s == "Depleted" then
		return tag("DEPLETED", C.Off)
	elseif s == "Fault" then
		return tag("FAULT", C.Off)
	end
	return tag("OFF", C.Off)
end

local function emissionTag(status): string
	if not status then
		return tag("--", C.Dim)
	end
	if status.Emitting then
		return tag("RADIATING", C.Hot)
	end
	return tag("SILENT", C.Dim)
end

local function batteryText(status): string
	if not status or type(status.BatteryPercent) ~= "number" then
		return "BATTERY"
	end
	local p = status.BatteryPercent
	local color = if p > 30 then C.On elseif p > 10 then C.Busy else C.Off
	return string.format('BATTERY <font color="%s">%d%%</font>', color, p)
end

-- Label for an interaction point (the main button).
function EW:PointLabel(action: string, device, custom: string?): string
	local status = statuses[device.Flag]
	if action == "Power" then
		return (custom or "POWER") .. "  " .. powerTag(status)
	elseif action == "Emission" then
		return (custom or "EMISSION") .. "  " .. emissionTag(status)
	elseif action == "Battery" then
		return custom or batteryText(status)
	elseif action == "Mode" then
		return (custom or "MODE") .. "  " .. (if status and status.ModeLabel then tag(status.ModeLabel, C.Busy) else "")
	elseif action == "Status" then
		return custom or "STATUS"
	end
	local name = custom or (status and status.DisplayName) or device.DisplayName
	return string.upper(name) .. "  " .. powerTag(status)
end

-- Dot colour for an interaction point.
function EW:PointColor(_action: string, device): Color3
	local status = statuses[device.Flag]
	if not status then
		return Color3.new(1, 1, 1)
	end
	if status.Emitting then
		return Color3.fromRGB(255, 138, 31)
	elseif status.PowerState == "On" then
		return Color3.fromRGB(124, 252, 0)
	elseif status.PowerState == "Booting" then
		return Color3.fromRGB(255, 210, 74)
	end
	return Color3.new(1, 1, 1)
end

local function modeEntries(device)
	local status = statuses[device.Flag]
	local out = {}
	for i, mode in ipairs(status and status.Modes or {}) do
		local current = status.ModeId == mode.Id
		table.insert(out, {
			Id = "Mode:" .. mode.Id,
			Order = i,
			Text = if current then mode.Label .. "  " .. tag("ACTIVE", C.On) else mode.Label,
			Run = function()
				send("SetMode", device, { Mode = mode.Id })
			end,
		})
	end
	if #out == 0 then
		table.insert(out, { Id = "Mode:none", Order = 1, Text = tag("NO MODES", C.Dim), Run = function() end })
	end
	return out
end

local function batteryEntries(device)
	local status = statuses[device.Flag]
	local spares = status and status.SpareBatteries
	return {
		{
			Id = "Battery:Swap",
			Order = 1,
			Text = string.format("SWAP BATTERY  %s", tag(if type(spares) == "number" then tostring(spares) .. " SPARE" else "--", C.Dim)),
			Run = function()
				send("SwapBattery", device)
			end,
		},
		{
			Id = "Battery:Check",
			Order = 2,
			Text = "CHECK CHARGE",
			Run = function()
				pendingReadout[device.Flag] = true
				send("QueryStatus", device)
			end,
		},
	}
end

-- Run a direct action (from a point or a menu entry).
function EW:Run(action: string, device)
	if action == "Power" then
		send("TogglePower", device)
	elseif action == "Emission" then
		send("ToggleEmission", device)
	elseif action == "Status" then
		pendingReadout[device.Flag] = true
		send("QueryStatus", device)
	end
end

-- True when a point action opens a list instead of acting directly.
function EW:OpensList(action: string): boolean
	return action == "Menu" or action == "Battery" or action == "Mode"
end

-- Entries for the first list opened by a point. Entries with Children open the
-- third column (the Interaction Menu's "Interacts" level).
function EW:Entries(action: string, device)
	if action == "Battery" then
		return batteryEntries(device)
	elseif action == "Mode" then
		return modeEntries(device)
	end
	local status = statuses[device.Flag]
	local entries = {
		{
			Id = "Power",
			Order = 1,
			Text = "POWER  " .. powerTag(status),
			Run = function()
				send("TogglePower", device)
			end,
		},
	}
	if status == nil or status.ManualEmission then
		table.insert(entries, {
			Id = "Emission",
			Order = 2,
			Text = "EMISSION  " .. emissionTag(status),
			Run = function()
				send("ToggleEmission", device)
			end,
		})
	end
	if status == nil or (status.Modes and #status.Modes > 0) then
		table.insert(entries, {
			Id = "Mode",
			Order = 3,
			Text = "MODE  " .. (if status and status.ModeLabel then tag(status.ModeLabel, C.Busy) else "") .. "  >",
			Children = function()
				return modeEntries(device)
			end,
		})
	end
	if status == nil or type(status.BatteryPercent) == "number" then
		table.insert(entries, {
			Id = "Battery",
			Order = 4,
			Text = batteryText(status) .. "  >",
			Children = function()
				return batteryEntries(device)
			end,
		})
	end
	table.insert(entries, {
		Id = "Status",
		Order = 5,
		Text = "STATUS",
		Run = function()
			pendingReadout[device.Flag] = true
			send("QueryStatus", device)
		end,
	})
	return entries
end

return EW
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="ModuleScript" referent="RBX00000027">
			<Properties>
				<string name="Name">Templates</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Templates
	Builds the Interaction Menu GUI pieces in code, using the exact layout values
	decoded from the original "INTERACTION MENU" model (BillboardGui "Interact",
	"Main" button, "Section"/"Interacts" lists and the option "Template"), so the
	look matches: a white dot, a red rotating selector ring on hover, and a white
	label with a soft stroke. No template instances or binary assets are needed.

	EW additions: RichText titles (coloured state tags) and a tintable dot.
]]

local Templates = {}

Templates.DotImage = "rbxassetid://14938897283"
Templates.SelectorImage = "rbxassetid://117671255762193"
Templates.ClickSoundId = "rbxassetid://6324790483"

local FONT = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)

local function list(parent: Instance, vertical: Enum.VerticalAlignment)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	layout.VerticalAlignment = vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 5)
	layout.Parent = parent
end

local function listFrame(name: string, position: UDim2, vertical: Enum.VerticalAlignment): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Position = position
	frame.Size = UDim2.new(0.1, 0, 0.1, 0)
	frame.SizeConstraint = Enum.SizeConstraint.RelativeXX
	frame.Visible = false
	list(frame, vertical)
	return frame
end

-- The dot + selector + title group shared by the main button and option rows.
local function decorate(button: TextButton)
	local object = Instance.new("ImageLabel")
	object.Name = "Object"
	object.AnchorPoint = Vector2.new(0.5, 0.5)
	object.BackgroundTransparency = 1
	object.BorderSizePixel = 0
	object.Image = Templates.DotImage
	object.ImageColor3 = Color3.new(1, 1, 1)
	object.Position = UDim2.new(0.2, 0, 0.5, 0)
	object.Size = UDim2.new(0.09, 0, 0.09, 0)
	object.SizeConstraint = Enum.SizeConstraint.RelativeXX
	object.ScaleType = Enum.ScaleType.Stretch
	object.Parent = button

	local selector = Instance.new("ImageLabel")
	selector.Name = "Selector"
	selector.AnchorPoint = Vector2.new(0.5, 0.5)
	selector.BackgroundTransparency = 1
	selector.BorderSizePixel = 0
	selector.Image = Templates.SelectorImage
	selector.ImageColor3 = Color3.fromRGB(255, 0, 4)
	selector.Position = UDim2.new(0.5, 0, 0.5, 0)
	selector.Size = UDim2.new(2, 0, 2, 0)
	selector.Visible = false
	selector.ZIndex = 2
	selector.Parent = object

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.BackgroundTransparency = 1
	title.BorderSizePixel = 0
	title.FontFace = FONT
	title.Position = UDim2.new(5.464, 0, 0.5, 0)
	title.Size = UDim2.new(8.101, 0, 1.2, 0)
	title.Text = "Object"
	title.RichText = true
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextScaled = true
	title.TextSize = 14
	title.TextStrokeColor3 = Color3.new(0, 0, 0)
	title.TextStrokeTransparency = 0.7
	title.TextWrapped = true
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.TextYAlignment = Enum.TextYAlignment.Center
	title.Parent = object

	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = 15
	constraint.MinTextSize = 1
	constraint.Parent = title
end

local function baseButton(name: string, size: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.AnchorPoint = Vector2.new(0.2, 0.5)
	button.AutoButtonColor = true
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.FontFace = FONT
	button.Position = UDim2.new(0.5, 0, 0.5, 0)
	button.Size = size
	button.Text = ""
	button.TextSize = 14
	decorate(button)
	return button
end

-- One interaction point: BillboardGui with the main button and two list levels.
function Templates.CreateBillboard(): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = "EWInteract"
	gui.Active = true
	gui.AlwaysOnTop = true
	gui.ClipsDescendants = true
	gui.LightInfluence = 0
	gui.MaxDistance = 100
	gui.ResetOnSpawn = false
	gui.Size = UDim2.new(20, 0, 20, 0)
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

	listFrame("Interacts", UDim2.new(0.77, 0, 0.5, 0), Enum.VerticalAlignment.Top).Parent = gui
	listFrame("Section", UDim2.new(0.65, 0, 0.5, 0), Enum.VerticalAlignment.Center).Parent = gui
	baseButton("Main", UDim2.new(0.1, 0, 0.02, 0)).Parent = gui
	return gui
end

-- One row in the Section / Interacts lists.
function Templates.CreateOption(): TextButton
	return baseButton("Option", UDim2.new(1, 0, 0.2, 0))
end

return Templates
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
