<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="ModuleScript" referent="RBX00000023">
		<Properties>
			<string name="Name">EWDevice</string>
			<ProtectedString name="Source"><![CDATA[--[[
	EWDevice - Interaction Menu module (for the provided "INTERACTION MENU" model)

	PLACEMENT
	  StarterPlayerScripts > Interaction Menu (Configuration) > Controller (LocalScript)
	      > Interacts (Folder) > EWDevice (ModuleScript)  <- this file

	SETUP ON ANY EW DEVICE (jammer backpack, radio, generator, sensor ...)
	  1. Add an Attachment inside one of the device's parts where the prompt
	     should appear.
	  2. Tag the attachment "INTERACT_MENU" (CollectionService / Tag Editor).
	  3. Attributes on the attachment:
	        Text   (string) = label shown on the main button, e.g. "EW JAMMER"
	        Module (string) = "EWDevice"
	  Hold Left Alt (or R3 on gamepad) near the device, click the main button,
	  then choose Power or Status.

	HOW IT TALKS TO THE SERVER
	  Fires ReplicatedStorage.EWShared.Remotes.DeviceCommand with the attachment
	  as the device reference. The server resolves the owning registered device,
	  checks rate limits, carrier ownership / interaction range, and replies with
	  a DeviceStatus notification. The client never decides the outcome.

	MENU CONTRACT NOTES (from reading the Controller source)
	  * Entries returned by Add() are plain tables. The Controller reads
	    info.Order / info.Image and falls back to info:GetAttribute(...) when a
	    field is missing, so every entry carries a GetAttribute method.
	  * Folder() returns nil, so the Controller only shows the Add() entries.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("EWShared")
local EWRemotes = require(Shared:WaitForChild("EWRemotes"))

local commandRemote = EWRemotes.Get("DeviceCommand")

local EWDevice = {}

EWDevice.Settings = {
	Distance = 12, -- client display distance; the server enforces its own range
}

local function noAttribute()
	return nil
end

local function entry(text: string, order: number, callback: () -> ())
	return {
		Name = text,
		Text = text,
		Order = order,
		Function = callback,
		GetAttribute = noAttribute,
	}
end

local function send(action: string, attachment: Instance)
	if commandRemote then
		(commandRemote :: RemoteEvent):FireServer({ Action = action, Device = attachment })
	end
end

function EWDevice:Add(layer, attachment)
	if layer ~= "Second" then
		return nil
	end
	return {
		entry("Power", 1, function()
			send("TogglePower", attachment)
		end),
		entry("Status", 2, function()
			send("QueryStatus", attachment)
		end),
	}
end

function EWDevice:Check(_layer, _attachment, _object)
	return true -- no folder children to filter
end

function EWDevice:Folder(_attachment)
	return nil
end

function EWDevice:Grab(_layer, _folder, _attachment)
	return {}
end

function EWDevice:Second(_attachment, _sections, _interacts, _object)
	return nil
end

function EWDevice:Third(_object, _attachment) end

function EWDevice:First(_attachment, sections, interacts)
	sections.Visible = not sections.Visible
	if interacts.Visible then
		interacts.Visible = false
		interacts:SetAttribute("Opened", nil)
	end
end

return EWDevice
]]></ProtectedString>
		</Properties>
	</Item>
</roblox>
