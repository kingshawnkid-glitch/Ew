<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX0000000B">
		<Properties>
			<string name="Name">EWServer</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX0000000C">
			<Properties>
				<string name="Name">EW</string>
				<ProtectedString name="Source"><![CDATA[--[[
	EW (server facade)
	The one module other server scripts (map logic, later equipment phases,
	weather systems) require to reach the running EW services.

	    local EW = require(game.ServerScriptService.EWServer.EW)
	    local ctx = EW.WaitForReady()
	    ctx.Terrain:NotifyTerrainChanged(minCorner, maxCorner)
	    local record = ctx.Registry:RegisterDevice(myRadioTool, { ElectronicType = "Communications" })

	Context fields: Config, Remotes, Diagnostics, Scheduler, Environment, Terrain,
	Registry, Power, Quality, RF, Security, DeviceCommands, Root.
	Services are singletons: requiring a service module directly returns the
	same instance, but only use it after WaitForReady().
]]

local EW = {}

EW.Ready = false
EW.Context = nil

local readyEvent = Instance.new("BindableEvent")

function EW.WaitForReady(timeoutSeconds: number?)
	if EW.Ready then
		return EW.Context
	end
	if timeoutSeconds then
		local done = false
		local thread = coroutine.running()
		local connection
		connection = readyEvent.Event:Connect(function()
			if not done then
				done = true
				connection:Disconnect()
				task.spawn(thread)
			end
		end)
		task.delay(timeoutSeconds, function()
			if not done then
				done = true
				connection:Disconnect()
				task.spawn(thread)
			end
		end)
		coroutine.yield()
		return EW.Context
	end
	readyEvent.Event:Wait()
	return EW.Context
end

function EW._SetContext(context)
	EW.Context = context
	EW.Ready = true
	readyEvent:Fire()
end

return EW
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0000000D">
			<Properties>
				<string name="Name">EWBootstrap</string>
				<bool name="Disabled">false</bool>
				<ProtectedString name="Source"><![CDATA[--[[
	EWBootstrap (Script)
	Creates remotes, wires every EW service through a shared context
	(dependency injection - no service requires another service directly, so
	there are no circular dependencies), then starts the scheduler.

	INIT ORDER   Diagnostics -> Scheduler -> Environment -> Terrain -> Registry
	             -> Power -> Quality -> RF -> Security -> DeviceCommands
	START ORDER  Environment -> Terrain -> Registry -> Power -> RF -> Security
	             -> DeviceCommands -> Diagnostics -> Scheduler (heartbeat last)

	Attributes on this script's parent folder (EWServer):
	  EW_PerformanceProfile  string   "Auto" | "Development" | "Normal" | "HighPopulation"
	  EW_MetersPerStud       number   RF geometric scale override
	  EW_RunTests            boolean  Studio: run the Phase 1 test suite (also settable at runtime)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local root = script.Parent
local Services = root:WaitForChild("Services")
local Shared = ReplicatedStorage:WaitForChild("EWShared")

local Config = require(Shared.EWConfig)
local EWRemotes = require(Shared.EWRemotes)
local EW = require(root:WaitForChild("EW"))

-- Attribute overrides (read once at boot).
local metersPerStud = root:GetAttribute("EW_MetersPerStud")
if type(metersPerStud) == "number" and metersPerStud > 0 then
	Config.Units.MetersPerStud = metersPerStud
end
local rangeScale = root:GetAttribute("EW_RangeScale")
if type(rangeScale) == "number" and rangeScale > 0 then
	Config.Units.RangeScale = rangeScale
end
local requestedProfile = root:GetAttribute("EW_PerformanceProfile")
if type(requestedProfile) == "string" then
	Config.DefaultPerformanceProfile = requestedProfile
end

local context = {
	Config = Config,
	Root = root,
	Remotes = EWRemotes.CreateAll(),
}

context.Diagnostics = require(Services.EWDiagnostics)
context.Scheduler = require(Services.EWScheduler)
context.Environment = require(Services.EnvironmentalConditionsAdapter)
context.Terrain = require(Services.TerrainPropagationService)
context.Registry = require(Services.ElectronicDeviceRegistry)
context.Power = require(Services.EquipmentPowerService)
context.Quality = require(Services.SignalQualityService)
context.RF = require(Services.RFSimulationService)
context.Security = require(Services.EWSecurityService)
context.DeviceCommands = require(Services.DeviceCommandService)

local INIT_ORDER = {
	"Diagnostics",
	"Scheduler",
	"Environment",
	"Terrain",
	"Registry",
	"Power",
	"Quality",
	"RF",
	"Security",
	"DeviceCommands",
}
local START_ORDER = {
	"Environment",
	"Terrain",
	"Registry",
	"Power",
	"RF",
	"Security",
	"DeviceCommands",
	"Diagnostics",
}

for _, name in ipairs(INIT_ORDER) do
	context[name]:Init(context)
end
for _, name in ipairs(START_ORDER) do
	local service = context[name]
	if service.Start then
		service:Start()
	end
end
context.Scheduler:Start()

context.Diagnostics:Log(
	"Bootstrap",
	string.format(
		"EW %s ready: %d devices registered, profile %s, %.2f m/stud, range scale %.1f",
		Config.Version,
		context.Registry:Count(),
		select(2, context.Scheduler:GetProfile()),
		Config.Units.MetersPerStud,
		Config.Units.RangeScale
	)
)

EW._SetContext(context)

local function maybeRunTests()
	if root:GetAttribute("EW_RunTests") == true then
		root:SetAttribute("EW_RunTests", false)
		local ok, err = context.Diagnostics:RunTests(nil)
		if not ok then
			warn("[EW] Tests not started: " .. tostring(err))
		end
	end
end
root:GetAttributeChangedSignal("EW_RunTests"):Connect(maybeRunTests)
task.defer(maybeRunTests)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX0000000E">
			<Properties>
				<string name="Name">Services</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX0000000F">
				<Properties>
					<string name="Name">DeviceCommandService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DeviceCommandService
	Handles the DeviceCommand RemoteEvent (power control and status queries)
	used by the Interaction Menu module and later equipment UIs.

	Request : { Action = "TogglePower" | "SetPower" | "QueryStatus", Device = Instance, On = boolean? }
	Reply   : DeviceStatus RemoteEvent to the requesting player only
	          { Ok, DisplayName, PowerState, BatteryPercent?, Message? }

	Battery warnings are pushed to the carrier of the device (if any).
]]

local Players = game:GetService("Players")

local DeviceCommandService = {}

local context
local registry
local power
local security
local statusRemote: RemoteEvent

local SCHEMA = {
	Action = { Type = "string", Enum = { "TogglePower", "SetPower", "QueryStatus" } },
	Device = { Type = "Instance" },
	On = { Type = "boolean", Optional = true },
}

local MESSAGES = {
	POWERING_ON = "Powering on",
	POWERED_OFF = "Powered off",
	ALREADY_ON = "Already on",
	ALREADY_OFF = "Already off",
	DEVICE_FAULT = "Device fault",
	BATTERY_DEPLETED = "Battery depleted",
	NOT_OWNER = "Not your equipment",
	OUT_OF_RANGE = "Too far away",
	NO_CHARACTER = "No character",
	WRONG_FACTION = "Access denied",
	UNKNOWN_DEVICE = "Not an electronic device",
}

local function statusPayload(record, ok: boolean, message: string?)
	return {
		Ok = ok,
		DisplayName = record and record.DisplayName or "Unknown",
		PowerState = record and record.PowerState or "Unknown",
		BatteryPercent = if record and record.Battery then math.floor(power:GetBatteryFraction(record) * 100 + 0.5) else nil,
		Message = message,
	}
end

local function reply(player: Player, record, ok: boolean, code: string?)
	statusRemote:FireClient(player, statusPayload(record, ok, code and (MESSAGES[code] or code) or nil))
end

function DeviceCommandService:Init(ctx)
	context = ctx
	registry = ctx.Registry
	power = ctx.Power
	security = ctx.Security
end

function DeviceCommandService:Start()
	statusRemote = context.Remotes.DeviceStatus :: RemoteEvent
	local commandRemote = context.Remotes.DeviceCommand :: RemoteEvent

	commandRemote.OnServerEvent:Connect(function(player: Player, payload: any)
		if not security:CheckRate(player, "DeviceCommand") then
			security:Reject(player, "DeviceCommand", "RATE_LIMIT")
			return
		end
		local valid, why = security:ValidatePayload(payload, SCHEMA)
		if not valid then
			security:Reject(player, "DeviceCommand", why or "INVALID")
			return
		end
		local record = registry:FindDeviceFromInstance(payload.Device)
		if not record then
			security:Reject(player, "DeviceCommand", "UNKNOWN_DEVICE")
			reply(player, nil, false, "UNKNOWN_DEVICE")
			return
		end
		local allowed, reason = security:CanControlDevice(player, record)
		if not allowed then
			security:Reject(player, "DeviceCommand", reason or "DENIED")
			reply(player, record, false, reason)
			return
		end
		if payload.Action == "QueryStatus" then
			reply(player, record, true, nil)
		elseif payload.Action == "TogglePower" then
			local on = not (record.PowerState == "On" or record.PowerState == "Booting")
			local ok, code = power:SetPower(record, on, "Player")
			reply(player, record, ok, code)
		elseif payload.Action == "SetPower" then
			if payload.On == nil then
				security:Reject(player, "DeviceCommand", "MISSING_ON")
				return
			end
			local ok, code = power:SetPower(record, payload.On, "Player")
			reply(player, record, ok, code)
		end
	end)

	power.BatteryWarning:Connect(function(record, level, fraction)
		if record.OwnerUserId then
			local player = Players:GetPlayerByUserId(record.OwnerUserId)
			if player then
				statusRemote:FireClient(player, statusPayload(record, true, string.format("BATTERY %s (%d%%)", string.upper(level), math.floor(fraction * 100 + 0.5))))
			end
		end
	end)
	power.PowerStateChanged:Connect(function(record, _, newState, reason)
		if newState == "Depleted" and record.OwnerUserId then
			local player = Players:GetPlayerByUserId(record.OwnerUserId)
			if player then
				statusRemote:FireClient(player, statusPayload(record, false, "BATTERY DEPLETED - SHUTDOWN"))
			end
		elseif reason == "BootComplete" and record.OwnerUserId then
			local player = Players:GetPlayerByUserId(record.OwnerUserId)
			if player then
				statusRemote:FireClient(player, statusPayload(record, true, "Ready"))
			end
		end
	end)
end

return DeviceCommandService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000010">
				<Properties>
					<string name="Name">EWDiagnostics</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EWDiagnostics
	Developer-only observability for the EW simulation.

	  * Log / Warn ring buffer (warnings rate-limited per message key)
	  * Snapshots: registry counters, devices, watched links with full link
	    budget breakdowns and degradation explanations, scheduler cost per job,
	    raycast / voxel usage, cache statistics, security rejections
	  * Streaming to subscribed developers via DiagnosticsStream with per-device
	    delta rows (full refresh every FullRefreshSeconds)
	  * Debug path data (signal paths + obstruction points) rendered LOCALLY by
	    the developer client - nothing is created in the shared Workspace, so
	    ordinary players never see hidden information
	  * DiagnosticsRequest RemoteFunction handler (Snapshot, Subscribe, RunTests,
	    SetDebugPaths, SetProfile, WatchLink, UnwatchLink)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local EWDiagnostics = {}

local context
local config
local logBuffer: { string } = {}
local LOG_LIMIT = 200
local lastWarn: { [string]: number } = {}
local counters: { [string]: number } = {}

type Subscriber = { Player: Player, DebugPaths: boolean, RowHashes: { [string]: string }, LastFull: number }
local subscribers: { [Player]: Subscriber } = {}
local FULL_REFRESH_SECONDS = 10
local testRunning = false

local function push(line: string)
	table.insert(logBuffer, line)
	if #logBuffer > LOG_LIMIT then
		table.remove(logBuffer, 1)
	end
end

function EWDiagnostics:Init(ctx)
	context = ctx
	config = ctx.Config
end

function EWDiagnostics:Log(category: string, message: string)
	local line = string.format("[%7.1f] %s: %s", os.clock(), category, message)
	push(line)
	if RunService:IsStudio() then
		print("[EW] " .. category .. ": " .. message)
	end
end

function EWDiagnostics:Warn(category: string, message: string)
	local key = category .. message
	local now = os.clock()
	local last = lastWarn[key]
	if last and now - last < config.Diagnostics.WarnRateLimitSeconds then
		self:Increment("SuppressedWarnings")
		return
	end
	lastWarn[key] = now
	push(string.format("[%7.1f] WARN %s: %s", now, category, message))
	warn("[EW] " .. category .. ": " .. message)
end

function EWDiagnostics:Increment(name: string, amount: number?)
	counters[name] = (counters[name] or 0) + (amount or 1)
end

local function finite(x: any): any
	if type(x) ~= "number" then
		return x
	end
	if x ~= x then
		return 0
	elseif x == math.huge then
		return 999
	elseif x == -math.huge then
		return -999
	end
	return math.floor(x * 10 + 0.5) / 10
end

local function deviceRow(record)
	local emitter = record.Emitters[1]
	local battery = context.Power:GetBatteryFraction(record)
	return {
		Id = record.Id,
		Name = record.DisplayName,
		Type = record.ElectronicType,
		Class = record.DetectionClass,
		Detectable = record.Detectable,
		Power = record.PowerState,
		Battery = if battery then finite(battery * 100) else nil,
		Owner = record.OwnerUserId,
		InWorld = record.InWorld,
		Position = Vector3.new(finite(record.Position.X), finite(record.Position.Y), finite(record.Position.Z)),
		Emitting = emitter ~= nil and emitter.Transmitting and record.PowerState == "On",
		FrequencyMHz = emitter and emitter.FrequencyMHz or 0,
		Profile = emitter and emitter.ProfileId or "",
		TxPowerDbm = emitter and finite(emitter.TxPowerDbm) or 0,
		Sources = string.format(
			"%s%s%s",
			if record.RegistrationSources.Flag then "F" else "-",
			if record.RegistrationSources.Tag then "T" else "-",
			if record.RegistrationSources.API then "A" else "-"
		),
		Notes = if record.ConfigurationNotes and #record.ConfigurationNotes > 0 then table.concat(record.ConfigurationNotes, ",") else nil,
	}
end

local function rowHash(row): string
	return string.format(
		"%s|%s|%s|%s|%s|%s|%.0f|%.0f|%.0f|%s",
		row.Name,
		tostring(row.Detectable),
		row.Power,
		tostring(row.Battery),
		tostring(row.Emitting),
		tostring(row.InWorld),
		row.Position.X,
		row.Position.Y,
		row.Position.Z,
		tostring(row.FrequencyMHz)
	)
end

local function linkRow(watch)
	local r = watch.LastResult
	if not r then
		return { Id = watch.Id, Label = watch.Label, State = "Pending" }
	end
	local p = r.Propagation
	local explanation = {}
	if p then
		for i, line in ipairs(p.Explanation) do
			if i > 8 then
				break
			end
			table.insert(explanation, line)
		end
	end
	return {
		Id = watch.Id,
		Label = watch.Label,
		TxId = watch.TxId,
		RxId = watch.RxId,
		State = r.Quality.State,
		Readability = r.Quality.Readability,
		Strength = r.Quality.Strength,
		MarginDb = finite(r.Quality.MarginDb),
		SinrDb = finite(r.SinrDb),
		SnrDb = finite(r.SnrDb),
		RxDbm = finite(r.InBandSignalDbm),
		NoiseDbm = finite(r.NoiseFloorDbm),
		InterferenceDbm = finite(r.InterferenceDbm),
		FrequencyMHz = r.FrequencyMHz,
		DistanceStuds = finite(r.DistanceStuds),
		EirpDbm = finite(r.EirpDbm),
		BasicDb = finite(r.BasicLossDb),
		BasicModel = r.BasicModel,
		ExcessDb = p and finite(p.ExcessDb) or nil,
		DiffractionDb = p and finite(p.DiffractionDb) or nil,
		StructureDb = p and finite(p.StructureDb) or nil,
		TerrainDb = p and finite(p.TerrainPenetrationDb) or nil,
		VegetationDb = p and finite(p.VegetationDb) or nil,
		WaterDb = p and finite(p.WaterDb) or nil,
		Class = p and p.Class or "?",
		Dominant = p and p.DominantPath or "?",
		FadingDb = finite(r.ShadowFadingDb + r.FastFadingDb + r.EquipmentJitterDb),
		PolarizationDb = finite(r.PolarizationLossDb),
		WeatherDb = finite(r.WeatherLossDb),
		TxActive = r.TxActive,
		Mode = r.AnalysisMode,
		Stale = r.Stale,
		Reasons = table.concat(r.Reasons, ","),
		Explanation = explanation,
		Evaluations = watch.Evaluations,
	}
end

function EWDiagnostics:BuildSnapshot(subscriber: Subscriber?)
	local now = os.clock()
	local full = subscriber == nil or (now - subscriber.LastFull) >= FULL_REFRESH_SECONDS
	local devices = {}
	local removed = {}
	local seen = {}
	local list = context.Registry:GetDeviceList()
	for i, record in ipairs(list) do
		if i > config.Diagnostics.MaxDevicesInSnapshot then
			break
		end
		local row = deviceRow(record)
		seen[record.Id] = true
		if subscriber then
			local hash = rowHash(row)
			if full or subscriber.RowHashes[record.Id] ~= hash then
				subscriber.RowHashes[record.Id] = hash
				table.insert(devices, row)
			end
		else
			table.insert(devices, row)
		end
	end
	if subscriber then
		for id in pairs(subscriber.RowHashes) do
			if not seen[id] then
				subscriber.RowHashes[id] = nil
				table.insert(removed, id)
			end
		end
		if full then
			subscriber.LastFull = now
		end
	end
	local links = {}
	for i, watch in ipairs(context.RF:GetWatches()) do
		if i > config.Diagnostics.MaxLinksInSnapshot then
			break
		end
		table.insert(links, linkRow(watch))
	end
	local tail = {}
	for i = math.max(1, #logBuffer - 30), #logBuffer do
		table.insert(tail, logBuffer[i])
	end
	local schedulerStats = context.Scheduler:GetStats()
	for _, job in ipairs(schedulerStats.Jobs) do
		job.AvgCostMs = finite(job.AvgCostMs)
		job.MaxCostMs = finite(job.MaxCostMs)
	end
	schedulerStats.FrameCostMsAvg = finite(schedulerStats.FrameCostMsAvg)
	schedulerStats.FrameCostMsMax = finite(schedulerStats.FrameCostMsMax)
	local terrainStats = context.Terrain:GetStats()
	terrainStats.AnalysisMsAvg = finite(terrainStats.AnalysisMsAvg)
	terrainStats.AnalysisMsMax = finite(terrainStats.AnalysisMsMax)
	terrainStats.CacheHitRate = finite(terrainStats.CacheHitRate * 100)
	terrainStats.HeightCacheAgeSeconds = finite(terrainStats.HeightCacheAgeSeconds)
	local rfStats = context.RF:GetStats()
	rfStats.EvaluationMsAvg = finite(rfStats.EvaluationMsAvg)
	rfStats.EvaluationMsMax = finite(rfStats.EvaluationMsMax)

	return {
		Version = config.Version,
		Time = finite(now),
		Full = full,
		Registry = context.Registry:GetCounters(),
		Scheduler = schedulerStats,
		Terrain = terrainStats,
		RF = rfStats,
		Security = context.Security:GetStats(),
		Environment = context.Environment:GetConditions(),
		Counters = table.clone(counters),
		Devices = devices,
		RemovedDevices = removed,
		Links = links,
		Log = tail,
		MetersPerStud = config.Units.MetersPerStud,
		TestRunning = testRunning,
	}
end

local function debugVisualsAllowed(): boolean
	return RunService:IsStudio() or config.Diagnostics.AllowDebugVisualsInLiveServers
end

local function buildDebugPaths()
	local paths = {}
	for i, watch in ipairs(context.RF:GetWatches()) do
		if i > 24 then
			break
		end
		local tx = context.Registry:GetDevice(watch.TxId)
		local rx = context.Registry:GetDevice(watch.RxId)
		if tx and rx and watch.LastResult and watch.LastResult.Propagation then
			-- Cache hit in the common case; never forced, so it cannot blow the budget.
			local geometry = context.Terrain:AnalyzePath(tx.Position, rx.Position, { ExcludeInstances = { tx.Root, rx.Root } })
			if geometry then
				local path = context.Terrain:BuildDebugPath(geometry, watch.LastResult.Propagation)
				path.State = watch.LastResult.Quality.State
				path.Label = watch.Label
				table.insert(paths, path)
			end
		end
	end
	return paths
end

function EWDiagnostics:Stream(player: Player, kind: string, data: any)
	local remote = context.Remotes.DiagnosticsStream :: RemoteEvent
	if context.Security:IsDeveloper(player) then
		remote:FireClient(player, { Kind = kind, Data = data })
	end
end

function EWDiagnostics:StreamToSubscribers(kind: string, data: any)
	for player in pairs(subscribers) do
		self:Stream(player, kind, data)
	end
end

local REQUEST_SCHEMA = {
	Action = {
		Type = "string",
		Enum = { "Snapshot", "Subscribe", "Unsubscribe", "RunTests", "SetDebugPaths", "SetProfile", "WatchLink", "UnwatchLink", "ResetMaxima" },
	},
	Enabled = { Type = "boolean", Optional = true },
	Profile = { Type = "string", Optional = true, Enum = { "Auto", "Development", "Normal", "HighPopulation" } },
	TxId = { Type = "string", Optional = true, MaxLength = 24 },
	RxId = { Type = "string", Optional = true, MaxLength = 24 },
	WatchId = { Type = "string", Optional = true, MaxLength = 24 },
}

function EWDiagnostics:RunTests(requester: Player?)
	if testRunning then
		return false, "TESTS_ALREADY_RUNNING"
	end
	if not (RunService:IsStudio() or config.Diagnostics.AllowTestsInLiveServers) then
		return false, "TESTS_STUDIO_ONLY"
	end
	local testsFolder = context.Root:FindFirstChild("Tests")
	local runnerModule = testsFolder and testsFolder:FindFirstChild("EWTestRunner")
	if not runnerModule then
		return false, "TEST_RUNNER_MISSING"
	end
	testRunning = true
	task.spawn(function()
		local runner = require(runnerModule)
		local ok, err = pcall(function()
			runner.RunAll(context, function(line: string)
				self:Log("Test", line)
				if requester and requester.Parent then
					self:Stream(requester, "TestLog", line)
				end
			end)
		end)
		if not ok then
			self:Warn("Test", "Test runner crashed: " .. tostring(err))
			if requester and requester.Parent then
				self:Stream(requester, "TestLog", "TEST RUNNER CRASHED: " .. tostring(err))
			end
		end
		testRunning = false
	end)
	return true, nil
end

local function handleRequest(player: Player, payload: any)
	local security = context.Security
	if not security:IsDeveloper(player) then
		security:Reject(player, "DiagnosticsRequest", "NOT_DEVELOPER")
		return { Ok = false, Error = "NOT_AUTHORIZED" }
	end
	if not security:CheckRate(player, "DiagnosticsRequest") then
		security:Reject(player, "DiagnosticsRequest", "RATE_LIMIT")
		return { Ok = false, Error = "RATE_LIMIT" }
	end
	local valid, why = security:ValidatePayload(payload, REQUEST_SCHEMA)
	if not valid then
		security:Reject(player, "DiagnosticsRequest", why or "INVALID")
		return { Ok = false, Error = why }
	end
	local action = payload.Action
	if action == "Snapshot" then
		return { Ok = true, Data = EWDiagnostics:BuildSnapshot(nil) }
	elseif action == "Subscribe" then
		subscribers[player] = subscribers[player] or { Player = player, DebugPaths = false, RowHashes = {}, LastFull = 0 }
		return { Ok = true }
	elseif action == "Unsubscribe" then
		subscribers[player] = nil
		return { Ok = true }
	elseif action == "SetDebugPaths" then
		local sub = subscribers[player]
		if not sub then
			return { Ok = false, Error = "NOT_SUBSCRIBED" }
		end
		if payload.Enabled and not debugVisualsAllowed() then
			return { Ok = false, Error = "DEBUG_VISUALS_STUDIO_ONLY" }
		end
		sub.DebugPaths = payload.Enabled == true
		return { Ok = true }
	elseif action == "SetProfile" then
		if not payload.Profile then
			return { Ok = false, Error = "MISSING_PROFILE" }
		end
		context.Scheduler:SetProfile(payload.Profile)
		return { Ok = true }
	elseif action == "RunTests" then
		local ok, err = EWDiagnostics:RunTests(player)
		return { Ok = ok, Error = err }
	elseif action == "WatchLink" then
		if not payload.TxId or not payload.RxId then
			return { Ok = false, Error = "MISSING_IDS" }
		end
		local id = context.RF:WatchLink(payload.TxId, payload.RxId, { Priority = 2 })
		return { Ok = id ~= nil, Data = id, Error = if id then nil else "UNKNOWN_DEVICE" }
	elseif action == "UnwatchLink" then
		if not payload.WatchId then
			return { Ok = false, Error = "MISSING_WATCH_ID" }
		end
		context.RF:UnwatchLink(payload.WatchId, "Developer")
		return { Ok = true }
	elseif action == "ResetMaxima" then
		context.Scheduler:ResetMaxima()
		return { Ok = true }
	end
	return { Ok = false, Error = "UNKNOWN_ACTION" }
end

function EWDiagnostics:Start()
	local request = context.Remotes.DiagnosticsRequest :: RemoteFunction
	request.OnServerInvoke = function(player, payload)
		local ok, result = pcall(handleRequest, player, payload)
		if ok then
			return result
		end
		EWDiagnostics:Warn("Diagnostics", "Request handler error: " .. tostring(result))
		return { Ok = false, Error = "SERVER_ERROR" }
	end
	Players.PlayerRemoving:Connect(function(player)
		subscribers[player] = nil
	end)
	context.Scheduler:AddJob("DiagnosticsPublish", config.Diagnostics.PublishIntervalSeconds, 9, function()
		if next(subscribers) == nil then
			return
		end
		local paths = nil
		for player, sub in pairs(subscribers) do
			if not context.Security:IsDeveloper(player) then
				subscribers[player] = nil
			else
				self:Stream(player, "Snapshot", self:BuildSnapshot(sub))
				if sub.DebugPaths and debugVisualsAllowed() then
					paths = paths or buildDebugPaths()
					self:Stream(player, "DebugPaths", paths)
				end
			end
		end
	end)
	-- Surface security rejections in the counters panel.
	context.Security.Rejected:Connect(function()
		self:Increment("SecurityRejections")
	end)
end

return EWDiagnostics
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000011">
				<Properties>
					<string name="Name">EWScheduler</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EWScheduler
	One Heartbeat-driven scheduler for all EW server work.

	* Jobs declare an interval and a priority. Each frame, due jobs run in
	  priority order while the per-frame time budget lasts.
	* Incremental jobs (link evaluation, device positions) receive the remaining
	  budget and must stop when it is spent; unfinished work carries over.
	* Raycast and voxel-read budgets are reset every frame and consumed by the
	  TerrainPropagationService, which degrades gracefully (cache / profile-only)
	  instead of exceeding them.
	* Every job runs inside pcall and a MicroProfiler label ("EW:<job>") so
	  costs are visible in the Roblox MicroProfiler and in EW diagnostics.

	API
	  Scheduler:Init(context)
	  Scheduler:AddJob(name, intervalSeconds, priority, callback, options) -> Job
	      callback(dtSinceLastRun: number, budgetSeconds: number, job: Job)
	      options = { Essential: boolean? }  -- essential jobs run even when over budget
	  Scheduler:SetProfile(name)
	  Scheduler:Start() / Scheduler:Stop()
	  Scheduler:TryConsumeRaycasts(n) -> boolean      (also :ConsumeRaycasts(n) forced)
	  Scheduler:TryConsumeVoxelReads(n) -> boolean
	  Scheduler:GetStats() -> table
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local EWScheduler = {}

export type Job = {
	Name: string,
	Interval: number,
	Priority: number,
	Callback: (number, number, any) -> (),
	Essential: boolean,
	Enabled: boolean,
	NextRun: number,
	LastRun: number,
	Runs: number,
	Skipped: number,
	Errors: number,
	LastError: string?,
	AvgCostMs: number,
	MaxCostMs: number,
}

local context
local config
local jobs: { Job } = {}
local heartbeatConnection: RBXScriptConnection? = nil
local activeProfileName = "Normal"
local activeProfile = nil

local raycastsThisFrame = 0
local raycastBudgetThisFrame = 0
local voxelReadsThisFrame = 0
local voxelBudgetThisFrame = 0

local stats = {
	Frames = 0,
	FrameCostMsAvg = 0,
	FrameCostMsMax = 0,
	OverBudgetFrames = 0,
	RaycastsTotal = 0,
	RaycastsLastSecond = 0,
	VoxelReadsTotal = 0,
	VoxelReadsLastSecond = 0,
	BudgetDenials = 0,
}
local secondWindowStart = os.clock()
local raycastsWindow = 0
local voxelWindow = 0

local function resolveProfileName(requested: string): string
	if requested == "Auto" then
		if RunService:IsStudio() then
			return "Development"
		end
		if #Players:GetPlayers() >= config.HighPopulationPlayers then
			return "HighPopulation"
		end
		return "Normal"
	end
	if config.PerformanceProfiles[requested] then
		return requested
	end
	warn(string.format("[EW] Unknown performance profile '%s', using Normal", tostring(requested)))
	return "Normal"
end

function EWScheduler:Init(ctx)
	context = ctx
	config = ctx.Config
	self.RequestedProfile = config.DefaultPerformanceProfile
	self:SetProfile(self.RequestedProfile)
end

function EWScheduler:SetProfile(name: string)
	self.RequestedProfile = name
	activeProfileName = resolveProfileName(name)
	activeProfile = config.PerformanceProfiles[activeProfileName]
	if context and context.Diagnostics then
		context.Diagnostics:Log("Scheduler", "Performance profile: " .. activeProfileName)
	end
end

function EWScheduler:GetProfile()
	return activeProfile, activeProfileName
end

function EWScheduler:AddJob(name: string, interval: number, priority: number, callback, options): Job
	local job: Job = {
		Name = name,
		Interval = interval,
		Priority = priority,
		Callback = callback,
		Essential = options ~= nil and options.Essential == true,
		Enabled = true,
		NextRun = os.clock() + math.random() * math.min(interval, 0.5), -- desynchronize job phases
		LastRun = os.clock(),
		Runs = 0,
		Skipped = 0,
		Errors = 0,
		LastError = nil,
		AvgCostMs = 0,
		MaxCostMs = 0,
	}
	table.insert(jobs, job)
	table.sort(jobs, function(a, b)
		return a.Priority < b.Priority
	end)
	return job
end

function EWScheduler:RemoveJob(job: Job)
	local index = table.find(jobs, job)
	if index then
		table.remove(jobs, index)
	end
end

function EWScheduler:TryConsumeRaycasts(n: number): boolean
	if raycastsThisFrame + n > raycastBudgetThisFrame then
		stats.BudgetDenials += 1
		return false
	end
	raycastsThisFrame += n
	return true
end

-- Forced consumption (on-demand evaluations such as tests or PTT events) is
-- still counted so diagnostics reflect true raycast usage.
function EWScheduler:ConsumeRaycasts(n: number)
	raycastsThisFrame += n
end

function EWScheduler:RemainingRaycasts(): number
	return math.max(0, raycastBudgetThisFrame - raycastsThisFrame)
end

function EWScheduler:TryConsumeVoxelReads(n: number): boolean
	if voxelReadsThisFrame + n > voxelBudgetThisFrame then
		stats.BudgetDenials += 1
		return false
	end
	voxelReadsThisFrame += n
	return true
end

function EWScheduler:ConsumeVoxelReads(n: number)
	voxelReadsThisFrame += n
end

function EWScheduler:RemainingVoxelReads(): number
	return math.max(0, voxelBudgetThisFrame - voxelReadsThisFrame)
end

local function endFrameAccounting()
	stats.RaycastsTotal += raycastsThisFrame
	stats.VoxelReadsTotal += voxelReadsThisFrame
	raycastsWindow += raycastsThisFrame
	voxelWindow += voxelReadsThisFrame
	local now = os.clock()
	if now - secondWindowStart >= 1 then
		local span = now - secondWindowStart
		stats.RaycastsLastSecond = math.floor(raycastsWindow / span + 0.5)
		stats.VoxelReadsLastSecond = math.floor(voxelWindow / span + 0.5)
		raycastsWindow = 0
		voxelWindow = 0
		secondWindowStart = now
	end
end

function EWScheduler:Step()
	-- Usage that happened between frames (on-demand calls) is attributed to this frame.
	endFrameAccounting()
	raycastsThisFrame = 0
	voxelReadsThisFrame = 0
	raycastBudgetThisFrame = activeProfile.RaycastsPerFrame
	voxelBudgetThisFrame = activeProfile.VoxelReadsPerFrame

	local frameStart = os.clock()
	local budget = activeProfile.FrameBudgetMs / 1000
	local deadline = frameStart + budget

	for _, job in ipairs(jobs) do
		if job.Enabled then
			local now = os.clock()
			if now >= job.NextRun then
				local remaining = deadline - now
				if remaining <= 0 and not job.Essential then
					job.Skipped += 1
				else
					local t0 = os.clock()
					debug.profilebegin("EW:" .. job.Name)
					local ok, err = pcall(job.Callback, now - job.LastRun, math.max(remaining, 0.0002), job)
					debug.profileend()
					local costMs = (os.clock() - t0) * 1000
					job.Runs += 1
					job.LastRun = now
					job.NextRun = now + job.Interval
					job.AvgCostMs = job.AvgCostMs * 0.9 + costMs * 0.1
					if costMs > job.MaxCostMs then
						job.MaxCostMs = costMs
					end
					if not ok then
						job.Errors += 1
						job.LastError = tostring(err)
						if context and context.Diagnostics then
							context.Diagnostics:Warn("Scheduler", string.format("Job %s failed: %s", job.Name, tostring(err)))
						else
							warn("[EW] job failed", job.Name, err)
						end
					end
				end
			end
		end
	end

	local frameCostMs = (os.clock() - frameStart) * 1000
	stats.Frames += 1
	stats.FrameCostMsAvg = stats.FrameCostMsAvg * 0.98 + frameCostMs * 0.02
	if frameCostMs > stats.FrameCostMsMax then
		stats.FrameCostMsMax = frameCostMs
	end
	if frameCostMs > activeProfile.FrameBudgetMs then
		stats.OverBudgetFrames += 1
	end
end

function EWScheduler:Start()
	if heartbeatConnection then
		return
	end
	raycastBudgetThisFrame = activeProfile.RaycastsPerFrame
	voxelBudgetThisFrame = activeProfile.VoxelReadsPerFrame
	heartbeatConnection = RunService.Heartbeat:Connect(function()
		self:Step()
	end)
	-- Re-resolve "Auto" periodically so player-count changes move between profiles.
	self:AddJob("ProfileCheck", config.Scheduler.ProfileCheckSeconds, 9, function()
		if self.RequestedProfile == "Auto" then
			local resolved = resolveProfileName("Auto")
			if resolved ~= activeProfileName then
				self:SetProfile("Auto")
			end
		end
	end)
end

function EWScheduler:Stop()
	if heartbeatConnection then
		heartbeatConnection:Disconnect()
		heartbeatConnection = nil
	end
end

function EWScheduler:ResetMaxima()
	stats.FrameCostMsMax = 0
	for _, job in ipairs(jobs) do
		job.MaxCostMs = 0
	end
end

function EWScheduler:GetStats()
	local jobStats = {}
	for _, job in ipairs(jobs) do
		table.insert(jobStats, {
			Name = job.Name,
			Interval = job.Interval,
			Runs = job.Runs,
			Skipped = job.Skipped,
			Errors = job.Errors,
			LastError = job.LastError,
			AvgCostMs = job.AvgCostMs,
			MaxCostMs = job.MaxCostMs,
		})
	end
	return {
		Profile = activeProfileName,
		RequestedProfile = self.RequestedProfile,
		FrameBudgetMs = activeProfile.FrameBudgetMs,
		RaycastsPerFrame = activeProfile.RaycastsPerFrame,
		Frames = stats.Frames,
		FrameCostMsAvg = stats.FrameCostMsAvg,
		FrameCostMsMax = stats.FrameCostMsMax,
		OverBudgetFrames = stats.OverBudgetFrames,
		RaycastsTotal = stats.RaycastsTotal,
		RaycastsLastSecond = stats.RaycastsLastSecond,
		VoxelReadsTotal = stats.VoxelReadsTotal,
		VoxelReadsLastSecond = stats.VoxelReadsLastSecond,
		BudgetDenials = stats.BudgetDenials,
		Jobs = jobStats,
	}
end

return EWScheduler
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000012">
				<Properties>
					<string name="Name">EWSecurityService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EWSecurityService
	Every client request passes through here. Clients can only REQUEST; the
	server decides using its own authoritative state.

	Protections
	  * Per-player, per-remote token-bucket rate limits (EWConfig.Security.RateLimits)
	  * Strict payload schemas: table shape, field types, enum values, string
	    lengths, no unexpected keys
	  * Device control authorization: carried devices only by their carrier;
	    world devices only within InteractionDistance of the player's character
	    (server-side positions, never client-supplied)
	  * Developer-only diagnostics (Studio, place creator, allowlist, group rank)
	  * Rejection counters per reason for diagnostics (Test J)

	The player attribute "EWDeveloper" (bool) is set by the server so the client
	knows whether to load the diagnostics UI. It grants nothing by itself: every
	diagnostics request is re-checked here.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EWShared")
local SharedUtilities = require(Shared.SharedUtilities)

local Security = {}

Security.Rejected = SharedUtilities.Signal.new("SecurityRejected")

local context
local config
local buckets: { [Player]: { [string]: any } } = {}
local developers: { [Player]: boolean } = {}
local rejections: { [string]: number } = {}
local totalRejections = 0
local bag = SharedUtilities.ConnectionBag.new()

export type FieldSpec = {
	Type: string, -- Luau typeof() name: "string" | "number" | "boolean" | "Instance" | "Vector3" ...
	Optional: boolean?,
	Enum: { string }?,
	MaxLength: number?,
	Min: number?,
	Max: number?,
	Finite: boolean?,
}

function Security:Init(ctx)
	context = ctx
	config = ctx.Config
end

local function computeDeveloper(player: Player): boolean
	local s = config.Security
	if s.StudioUsersAreDevelopers and RunService:IsStudio() then
		return true
	end
	if table.find(s.DeveloperUserIds, player.UserId) then
		return true
	end
	if s.CreatorIsDeveloper then
		if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
			return true
		end
		if game.CreatorType == Enum.CreatorType.Group then
			local ok, rank = pcall(function()
				return player:GetRankInGroup(game.CreatorId)
			end)
			if ok and rank >= 255 then
				return true
			end
		end
	end
	if s.DeveloperGroupId and s.DeveloperGroupId > 0 then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(s.DeveloperGroupId)
		end)
		if ok and rank >= s.DeveloperMinRank then
			return true
		end
	end
	return false
end

local function onPlayerAdded(player: Player)
	buckets[player] = {}
	developers[player] = false
	task.spawn(function()
		local isDev = computeDeveloper(player)
		if player.Parent then
			developers[player] = isDev
			player:SetAttribute("EWDeveloper", isDev)
		end
	end)
end

function Security:Start()
	bag:Add(Players.PlayerAdded:Connect(onPlayerAdded))
	bag:Add(Players.PlayerRemoving:Connect(function(player)
		buckets[player] = nil
		developers[player] = nil
	end))
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
end

function Security:IsDeveloper(player: Player): boolean
	return developers[player] == true
end

function Security:CheckRate(player: Player, remoteName: string): boolean
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local bucket = perPlayer[remoteName]
	if not bucket then
		local limits = config.Security.RateLimits[remoteName] or { Capacity = 5, RefillPerSecond = 1 }
		bucket = SharedUtilities.TokenBucket.new(limits.Capacity, limits.RefillPerSecond)
		perPlayer[remoteName] = bucket
	end
	return bucket:TryTake(1)
end

function Security:Reject(player: Player?, remoteName: string, reason: string)
	totalRejections += 1
	local key = remoteName .. ":" .. reason
	rejections[key] = (rejections[key] or 0) + 1
	Security.Rejected:Fire(player, remoteName, reason)
	if context.Diagnostics then
		context.Diagnostics:Warn(
			"Security",
			string.format("Rejected %s from %s: %s", remoteName, if player then player.Name else "?", reason)
		)
	end
end

function Security:ValidatePayload(payload: any, schema: { [string]: FieldSpec }): (boolean, string?)
	if type(payload) ~= "table" then
		return false, "PAYLOAD_NOT_TABLE"
	end
	-- Reject unexpected keys and metatables (clients cannot send metatables, but be explicit).
	if getmetatable(payload) ~= nil then
		return false, "PAYLOAD_METATABLE"
	end
	local keys = 0
	for key in pairs(payload) do
		keys += 1
		if type(key) ~= "string" or schema[key] == nil then
			return false, "UNEXPECTED_FIELD"
		end
		if keys > 16 then
			return false, "TOO_MANY_FIELDS"
		end
	end
	for name, spec in pairs(schema) do
		local value = payload[name]
		if value == nil then
			if not spec.Optional then
				return false, "MISSING_" .. string.upper(name)
			end
		else
			if typeof(value) ~= spec.Type then
				return false, "BAD_TYPE_" .. string.upper(name)
			end
			if spec.Type == "string" then
				local maxLength = spec.MaxLength or config.Security.MaxStringLength
				if #value > maxLength then
					return false, "STRING_TOO_LONG_" .. string.upper(name)
				end
				if spec.Enum and not table.find(spec.Enum, value) then
					return false, "BAD_ENUM_" .. string.upper(name)
				end
			elseif spec.Type == "number" then
				if value ~= value or value == math.huge or value == -math.huge then
					return false, "NON_FINITE_" .. string.upper(name)
				end
				if spec.Min and value < spec.Min then
					return false, "OUT_OF_RANGE_" .. string.upper(name)
				end
				if spec.Max and value > spec.Max then
					return false, "OUT_OF_RANGE_" .. string.upper(name)
				end
			end
		end
	end
	return true, nil
end

-- Authorization for commanding a device (power, configuration).
function Security:CanControlDevice(player: Player, record): (boolean, string?)
	if record.OwnerUserId ~= nil then
		if record.OwnerUserId == player.UserId then
			return true, nil
		end
		return false, "NOT_OWNER"
	end
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not (hrp and hrp:IsA("BasePart")) then
		return false, "NO_CHARACTER"
	end
	local distance = (hrp.Position - record.Position).Magnitude
	if distance > config.Security.InteractionDistanceStuds then
		return false, "OUT_OF_RANGE"
	end
	local faction = record.Faction
	if faction and config.Security.EnforceFactions and player.Team and player.Team.Name ~= faction then
		return false, "WRONG_FACTION"
	end
	return true, nil
end

function Security:GetStats()
	local developerCount = 0
	for _, isDev in pairs(developers) do
		if isDev then
			developerCount += 1
		end
	end
	return {
		TotalRejections = totalRejections,
		Rejections = table.clone(rejections),
		Developers = developerCount,
	}
end

return Security
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000013">
				<Properties>
					<string name="Name">ElectronicDeviceRegistry</string>
					<ProtectedString name="Source"><![CDATA[--[[
	ElectronicDeviceRegistry
	Event-driven registry of every electronic object participating in the EW
	simulation. See docs/PHASE1_ARCHITECTURE.md section 3 for the full rules.

	REGISTRATION SOURCES
	  Flag : a BoolValue named "EWDetectable" inside a Model, Tool or BasePart
	         (Value true = eligible for detection, false = tracked but excluded
	          from detection results, removed BoolValue = unregistered)
	  Tag  : CollectionService tag "EWDevice" on the root (no BoolValue needed)
	  API  : Registry:RegisterDevice(root, options) used by equipment systems

	ROOT RESOLUTION (first match wins, starting at the BoolValue's parent)
	  1. nearest ancestor with attribute EWDeviceRoot = true
	  2. the parent Tool or nearest Tool ancestor
	  3. the parent Model (never Workspace)
	  4. a BasePart: its parent Model if that Model is not a character, else the part
	  5. any other container: apply rules 3/4 to the nearest Model/BasePart ancestor

	WORLD CONTAINERS
	  Devices exist only while inside Workspace or a player's Backpack. A Tool in
	  a Backpack is positioned at its owner's character. Moving a device out of
	  the world (e.g. ServerStorage) unregisters it but keeps its power/battery
	  state (weak-keyed by instance, and by the EWSerial attribute for respawns).

	No polling: discovery uses DescendantAdded, Changed, AncestryChanged,
	AttributeChanged, Destroying and CollectionService signals. All changes are
	coalesced with task.defer so reparenting (Removing + Added) is one update.

	SIGNALS
	  DeviceRegistered(record)
	  DeviceUnregistered(record, reason)
	  DeviceChanged(record, changeKind)   changeKind = "Detectable" | "Configuration"
	                                       | "Owner" | "Emission" | "PowerAttribute" | "Pose"
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EWShared")
local SharedUtilities = require(Shared.SharedUtilities)
local SignalProfiles = require(Shared.SignalProfiles)
local DeviceDefinitions = require(Shared.DeviceDefinitions)
local Types = require(Shared.EWTypes)

local SpatialIndex = require(script.Parent.SpatialIndex)

type DeviceRecord = Types.DeviceRecord
type Emitter = Types.Emitter
type Receiver = Types.Receiver

local Signal = SharedUtilities.Signal
local ConnectionBag = SharedUtilities.ConnectionBag

local Registry = {}

Registry.DeviceRegistered = Signal.new("DeviceRegistered")
Registry.DeviceUnregistered = Signal.new("DeviceUnregistered")
Registry.DeviceChanged = Signal.new("DeviceChanged")

-- Attributes read from the root (or, as a fallback, from the EWDetectable BoolValue).
Registry.SupportedAttributes = {
	"ElectronicType",
	"SignalProfile",
	"EmissionEnabled",
	"TransmissionChannel",
	"PowerState",
	"DetectionDifficulty",
	"SignalStrength",
	"ElectronicFaction",
	"CustomDisplayName",
	"EWAntennaHeight",
	"EWAntennaGain",
	"EWAntennaPattern",
	"EWBandwidthKHz",
	"EWNetworkId",
	"EWSecurityProfile",
	"EWSerial",
	"EWOwnerUserId",
	"EWPriority",
}

local context
local config
local FLAG_NAME = "EWDetectable"

local devices: { [string]: DeviceRecord } = {}
local deviceList: { DeviceRecord } = {}
local deviceIndex: { [DeviceRecord]: number } = {}
local byRoot: { [Instance]: DeviceRecord } = {}

type RootSources = {
	Flags: { [Instance]: boolean },
	Tag: boolean,
	API: { [string]: any }?,
	Bag: any, -- ConnectionBag for root-level watches (tag/API roots)
}
local rootSources: { [Instance]: RootSources } = {}
local flagRoot: { [Instance]: Instance } = {}
local flagBags: { [Instance]: any } = {}
local deviceBags: { [string]: any } = {}

local pendingFlags: { [Instance]: boolean } = {}
local pendingRoots: { [Instance]: boolean } = {}
local pendingReconfigure: { [DeviceRecord]: boolean } = {}
local pendingPose: { [DeviceRecord]: boolean } = {}
local processScheduled = false

local persisted = setmetatable({}, { __mode = "k" }) :: { [Instance]: any }
local serialCache: { [string]: { State: any, ExpiresAt: number } } = {}

local globalBag = ConnectionBag.new()
local playerBags: { [Player]: any } = {}
local backpackBags: { [Instance]: any } = {}

local spatial = SpatialIndex.new(256)
local nextDeviceNumber = 0
local positionCursor = 1

local counters = {
	Registrations = 0,
	Unregistrations = 0,
	FlagDiscoveries = 0,
	FlagChanges = 0,
	Reconfigurations = 0,
	RootMigrations = 0,
	OrphanFlags = 0,
	MultiFlagRoots = 0,
	PositionUpdates = 0,
	DeferredBatches = 0,
	RestoredStates = 0,
}

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function now(): number
	return os.clock()
end

local function isInWorld(inst: Instance): boolean
	if inst.Parent == nil then
		return false
	end
	if inst:IsDescendantOf(workspace) then
		return true
	end
	local backpack = inst:FindFirstAncestorOfClass("Backpack")
	return backpack ~= nil and backpack.Parent ~= nil and backpack.Parent:IsA("Player")
end

local function isCharacterLike(model: Instance): boolean
	return model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function rootForPart(part: BasePart): Instance
	local model = part.Parent
	if model and model:IsA("Model") and model ~= workspace and not isCharacterLike(model) then
		return model
	end
	return part
end

local function resolveRoot(flag: Instance): Instance?
	local parent = flag.Parent
	if parent == nil or parent == workspace or parent == game then
		return nil
	end
	-- 1. Explicit override
	local node: Instance? = parent
	local depth = 0
	while node and node ~= workspace and node ~= game and depth < config.Registry.MaxRootSearchDepth do
		if node:IsA("Backpack") or node:IsA("Player") then
			break
		end
		if node:GetAttribute(config.Registry.RootOverrideAttribute) == true then
			return node
		end
		node = node.Parent
		depth += 1
	end
	-- 2. Tool
	if parent:IsA("Tool") then
		return parent
	end
	local tool = parent:FindFirstAncestorOfClass("Tool")
	if tool then
		return tool
	end
	-- 3. Model
	if parent:IsA("Model") and parent ~= workspace then
		return parent
	end
	-- 4. BasePart
	if parent:IsA("BasePart") then
		return rootForPart(parent)
	end
	-- 5. Other containers: nearest Model / BasePart ancestor
	local ancestor = parent.Parent
	depth = 0
	while ancestor and ancestor ~= workspace and ancestor ~= game and depth < config.Registry.MaxRootSearchDepth do
		if ancestor:IsA("BasePart") then
			return rootForPart(ancestor)
		elseif ancestor:IsA("Model") then
			return ancestor
		elseif ancestor:IsA("Backpack") or ancestor:IsA("Player") then
			break
		end
		ancestor = ancestor.Parent
		depth += 1
	end
	return nil
end

local function resolveOwner(root: Instance): number?
	local backpack = root:FindFirstAncestorOfClass("Backpack")
	if backpack and backpack.Parent and backpack.Parent:IsA("Player") then
		return (backpack.Parent :: Player).UserId
	end
	local node = root
	local depth = 0
	while node and node ~= workspace and depth < 12 do
		if node:IsA("Model") then
			local player = Players:GetPlayerFromCharacter(node)
			if player then
				return player.UserId
			end
		end
		node = node.Parent
		depth += 1
	end
	local attr = root:GetAttribute("EWOwnerUserId")
	if type(attr) == "number" then
		return attr
	end
	return nil
end

local function resolveAnchor(root: Instance): BasePart?
	if root:IsA("BasePart") then
		return root
	end
	if root:IsA("Tool") then
		local handle = root:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			return handle
		end
	end
	if root:IsA("Model") and root.PrimaryPart then
		return root.PrimaryPart
	end
	return root:FindFirstChildWhichIsA("BasePart", true)
end

local function resolveAntenna(root: Instance): Attachment?
	local found = root:FindFirstChild(config.Registry.AntennaAttachmentName, true)
	if found and found:IsA("Attachment") then
		return found
	end
	return nil
end

local function readAttributes(root: Instance, sources: RootSources?): { [string]: any }
	local attrs = {}
	local fallbacks = {}
	if sources then
		for flag in pairs(sources.Flags) do
			table.insert(fallbacks, flag)
		end
	end
	for _, name in ipairs(Registry.SupportedAttributes) do
		local value = root:GetAttribute(name)
		if value == nil then
			for _, flag in ipairs(fallbacks) do
				value = flag:GetAttribute(name)
				if value ~= nil then
					break
				end
			end
		end
		attrs[name] = value
	end
	if sources and sources.API then
		for k, v in pairs(sources.API) do
			if attrs[k] == nil then
				attrs[k] = v
			end
		end
	end
	return attrs
end

local function resolveFrequency(value: any, fallback: number): (number, string?)
	if type(value) == "number" and value > 0 then
		return value, nil
	end
	if type(value) == "string" then
		local planned = config.ChannelPlan[value]
		if planned then
			return planned, nil
		end
		local parsed = tonumber(value)
		if parsed and parsed > 0 then
			return parsed, nil
		end
		return fallback, "UNKNOWN_CHANNEL:" .. value
	end
	return fallback, nil
end

local function resolvePower(value: any, profile): number
	if type(value) == "number" then
		return value
	end
	if type(value) == "string" and profile.PowerLevelsDbm then
		local level = profile.PowerLevelsDbm[string.upper(value)]
		if level then
			return level
		end
	end
	return profile.TxPowerDbm
end

local function buildRadioConfiguration(record: DeviceRecord, attrs: { [string]: any }, keepTransmitting: boolean)
	local definition = DeviceDefinitions.Resolve(attrs.ElectronicType)
	local profileId = attrs.SignalProfile or definition.DefaultSignalProfile
	local profile = SignalProfiles.Get(profileId)
	local notes = {}
	if not profile then
		table.insert(notes, "UNKNOWN_SIGNAL_PROFILE:" .. tostring(profileId))
		profile = SignalProfiles.GetOrDefault(definition.DefaultSignalProfile)
	end
	local frequency, freqNote = resolveFrequency(attrs.TransmissionChannel, profile.DefaultFrequencyMHz)
	if freqNote then
		table.insert(notes, freqNote)
	end
	if frequency < profile.MinFrequencyMHz or frequency > profile.MaxFrequencyMHz then
		table.insert(notes, "FREQUENCY_OUTSIDE_PROFILE_RANGE")
	end

	local antenna = SignalProfiles.CopyAntenna(profile.Antenna)
	if type(attrs.EWAntennaGain) == "number" then
		antenna.GainDbi = attrs.EWAntennaGain
	end
	if type(attrs.EWAntennaHeight) == "number" then
		antenna.HeightOffsetStuds = attrs.EWAntennaHeight
	end
	if attrs.EWAntennaPattern == "Omni" or attrs.EWAntennaPattern == "Directional" or attrs.EWAntennaPattern == "Isotropic" then
		antenna.Pattern = attrs.EWAntennaPattern
	end

	local bandwidth = if type(attrs.EWBandwidthKHz) == "number" and attrs.EWBandwidthKHz > 0
		then attrs.EWBandwidthKHz
		else profile.BandwidthKHz
	local difficulty = if type(attrs.DetectionDifficulty) == "number"
		then math.clamp(attrs.DetectionDifficulty, 0, 1)
		else 0

	local previous = record.Emitters[1]
	local emissionEnabled: boolean
	if type(attrs.EmissionEnabled) == "boolean" then
		emissionEnabled = attrs.EmissionEnabled
	elseif keepTransmitting and previous then
		emissionEnabled = previous.Transmitting
	else
		emissionEnabled = definition.EmissionEnabledByDefault
	end

	local priority = if type(attrs.EWPriority) == "number" then math.clamp(math.floor(attrs.EWPriority), 1, 3) else definition.Priority

	local emitter: Emitter = {
		Id = record.Id .. ":TX1",
		DeviceId = record.Id,
		ProfileId = profile.Id,
		SignalType = profile.SignalType,
		Modulation = profile.Modulation,
		Intentional = profile.Intentional,
		FrequencyMHz = frequency,
		BandwidthKHz = bandwidth,
		TxPowerDbm = resolvePower(attrs.SignalStrength, profile),
		DutyCycle = profile.DutyCycle,
		Transmitting = emissionEnabled,
		ContinuousEmission = profile.ContinuousEmission,
		NetworkId = if type(attrs.EWNetworkId) == "string" then attrs.EWNetworkId else nil,
		SecurityProfile = if type(attrs.EWSecurityProfile) == "string" then attrs.EWSecurityProfile else nil,
		Priority = priority,
		Stability = profile.Stability,
		Antenna = antenna,
		SignatureReductionDb = 25 * difficulty,
	}
	record.Emitters = { emitter }

	local receivers = {}
	if definition.HasReceiver then
		local receiver: Receiver = {
			Id = record.Id .. ":RX1",
			DeviceId = record.Id,
			ProfileId = profile.Id,
			Modulation = profile.Modulation,
			FrequencyMHz = frequency,
			BandwidthKHz = bandwidth,
			SensitivityDbm = profile.SensitivityDbm,
			NoiseFigureDb = profile.NoiseFigureDb,
			RequiredSinrDb = profile.RequiredSinrDb,
			InterferenceRejectionDb = profile.InterferenceRejectionDb,
			NetworkId = emitter.NetworkId,
			SecurityProfile = emitter.SecurityProfile,
			Antenna = antenna,
			Enabled = true,
		}
		table.insert(receivers, receiver)
	end
	record.Receivers = receivers

	record.DefinitionId = definition.Id
	record.ElectronicType = definition.ElectronicType
	record.DetectionClass = profile.DetectionClass
	record.DetectionDifficulty = difficulty
	record.DisplayName = if type(attrs.CustomDisplayName) == "string" and attrs.CustomDisplayName ~= ""
		then attrs.CustomDisplayName
		else record.Root.Name
	record.Faction = if type(attrs.ElectronicFaction) == "string" then attrs.ElectronicFaction else nil
	record.Serial = if type(attrs.EWSerial) == "string" and attrs.EWSerial ~= "" then attrs.EWSerial else nil
	record.Attributes = attrs
	record.ConfigurationNotes = notes
	return definition
end

local function buildBattery(definition): Types.BatteryState?
	local spec = definition.Battery
	if not spec then
		return nil
	end
	return {
		CapacityWh = spec.CapacityWh,
		ChargeWh = spec.CapacityWh,
		IdleDrawW = spec.IdleDrawW,
		ReceiveDrawW = spec.ReceiveDrawW,
		TransmitDrawW = spec.TransmitDrawW,
		LowFraction = config.Power.LowBatteryFraction,
		CriticalFraction = config.Power.CriticalBatteryFraction,
		Removable = spec.Removable,
		LowWarned = false,
		CriticalWarned = false,
	}
end

local function initialPowerState(attrs, definition): Types.PowerState
	local attr = attrs.PowerState
	if attr == true or attr == "On" or attr == "on" or attr == "ON" then
		return "On"
	elseif attr == false or attr == "Off" or attr == "off" or attr == "OFF" then
		return "Off"
	end
	return definition.DefaultPowerState
end

local function captureState(record: DeviceRecord)
	return {
		PowerState = record.PowerState,
		Battery = record.Battery and table.clone(record.Battery) or nil,
		Transmitting = record.Emitters[1] and record.Emitters[1].Transmitting or false,
	}
end

local function computeDetectable(root: Instance, sources: RootSources): boolean
	local anyFlag = false
	local anyTrue = false
	for flag in pairs(sources.Flags) do
		anyFlag = true
		if flag:IsA("BoolValue") and (flag :: BoolValue).Value == true then
			anyTrue = true
		end
	end
	if anyFlag then
		return anyTrue
	end
	if sources.API and sources.API.Detectable == false then
		return false
	end
	if sources.Tag and root:GetAttribute(FLAG_NAME) == false then
		return false
	end
	return true
end

--------------------------------------------------------------------------------
-- Pose (position / antenna frame)
--------------------------------------------------------------------------------

local function computePose(record: DeviceRecord): (Vector3?, CFrame?)
	local root = record.Root
	local backpack = root:FindFirstAncestorOfClass("Backpack")
	if backpack then
		local player = backpack.Parent
		if player and player:IsA("Player") then
			local character = player.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") then
				-- Carried on the vest/back: upright antenna slightly above the torso.
				local base = hrp.Position
				local look = hrp.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude < 1e-3 then
					flat = Vector3.new(0, 0, -1)
				end
				local pos = base + Vector3.new(0, 1.0 + record.Emitters[1].Antenna.HeightOffsetStuds * 0.5, 0)
				return pos, CFrame.lookAt(pos, pos + flat.Unit)
			end
		end
		return nil, nil
	end
	if not root:IsDescendantOf(workspace) then
		return nil, nil
	end
	local antenna = record.AntennaAttachment
	if antenna and antenna.Parent and antenna:IsDescendantOf(root) then
		return antenna.WorldPosition, antenna.WorldCFrame
	end
	local anchor = record.AnchorPart
	if not (anchor and anchor.Parent and (anchor == root or anchor:IsDescendantOf(root))) then
		anchor = resolveAnchor(root)
		record.AnchorPart = anchor
	end
	local heightOffset = record.Emitters[1] and record.Emitters[1].Antenna.HeightOffsetStuds or 1
	local basePosition: Vector3? = nil
	local look = Vector3.new(0, 0, -1)
	if anchor then
		basePosition = anchor.Position
		look = anchor.CFrame.LookVector
	elseif root:IsA("Model") then
		local pivot = root:GetPivot()
		basePosition = pivot.Position
		look = pivot.LookVector
	end
	if not basePosition then
		return nil, nil
	end
	local pos = basePosition + Vector3.new(0, heightOffset, 0)
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	-- Without an explicit EWAntenna attachment the element is assumed upright,
	-- so arbitrary tool/handle orientations never create surprise polarization loss.
	return pos, CFrame.lookAt(pos, pos + flat.Unit)
end

function Registry:RefreshPose(record: DeviceRecord, timestamp: number?)
	local t = timestamp or now()
	local pos, cf = computePose(record)
	counters.PositionUpdates += 1
	if not pos then
		if record.InWorld then
			record.InWorld = false
			spatial:Remove(record.Id)
		end
		return false
	end
	local dt = t - record.LastPositionUpdate
	if dt > 0 and record.LastPositionUpdate > 0 and record.InWorld then
		local v = (pos - record.Position) / dt
		-- Smooth to avoid spikes from irregular sampling.
		record.Velocity = record.Velocity:Lerp(v, 0.5)
	end
	record.Position = pos
	record.AntennaCFrame = cf :: CFrame
	record.LastPositionUpdate = t
	record.InWorld = true
	spatial:Update(record.Id, pos)
	return true
end

--------------------------------------------------------------------------------
-- Register / unregister
--------------------------------------------------------------------------------

local function addToList(record: DeviceRecord)
	table.insert(deviceList, record)
	deviceIndex[record] = #deviceList
end

local function removeFromList(record: DeviceRecord)
	local index = deviceIndex[record]
	if not index then
		return
	end
	local last = deviceList[#deviceList]
	deviceList[index] = last
	deviceIndex[last] = index
	deviceList[#deviceList] = nil
	deviceIndex[record] = nil
end

local scheduleProcess -- forward declaration

local function connectDevice(record: DeviceRecord)
	local bag = ConnectionBag.new()
	local root = record.Root
	bag:Add(root.AttributeChanged:Connect(function(name)
		if name == "PowerState" then
			Registry.DeviceChanged:Fire(record, "PowerAttribute")
		end
		if table.find(Registry.SupportedAttributes, name) or name == FLAG_NAME then
			pendingReconfigure[record] = true
			scheduleProcess()
		end
	end))
	bag:Add(root.DescendantAdded:Connect(function(desc)
		if desc:IsA("Attachment") and desc.Name == config.Registry.AntennaAttachmentName then
			pendingPose[record] = true
			scheduleProcess()
		elseif desc:IsA("BasePart") and record.AnchorPart == nil then
			pendingPose[record] = true
			scheduleProcess()
		end
	end))
	bag:Add(root.DescendantRemoving:Connect(function(desc)
		if desc == record.AntennaAttachment or desc == record.AnchorPart then
			pendingPose[record] = true
			scheduleProcess()
		end
	end))
	bag:Add(root.Destroying:Connect(function()
		pendingRoots[root] = true
		scheduleProcess()
	end))
	deviceBags[record.Id] = bag
end

local function register(root: Instance, sources: RootSources, detectable: boolean): DeviceRecord
	nextDeviceNumber += 1
	local t = now()
	local record: DeviceRecord = {
		Id = SharedUtilities.ShortId("EW", nextDeviceNumber),
		Root = root,
		DefinitionId = "Generic",
		ElectronicType = "Generic",
		DetectionClass = "PassiveElectronic",
		DisplayName = root.Name,
		Faction = nil,
		Serial = nil,
		OwnerUserId = resolveOwner(root),
		Detectable = detectable,
		RegistrationSources = {},
		PowerState = "Off",
		PowerStateChangedAt = t,
		BootCompleteAt = nil,
		FaultReason = nil,
		Battery = nil,
		Emitters = {},
		Receivers = {},
		DetectionDifficulty = 0,
		Position = Vector3.zero,
		AntennaCFrame = CFrame.identity,
		Velocity = Vector3.zero,
		LastPositionUpdate = 0,
		NextPositionUpdate = 0,
		PositionInterval = config.Scheduler.DevicePositionMinInterval,
		InWorld = false,
		AnchorPart = resolveAnchor(root),
		AntennaAttachment = resolveAntenna(root),
		Revision = 1,
		RegisteredAt = t,
		Attributes = {},
	}
	record.RegistrationSources = {
		Flag = next(sources.Flags) ~= nil,
		Tag = sources.Tag,
		API = sources.API ~= nil,
	}
	local attrs = readAttributes(root, sources)
	local definition = buildRadioConfiguration(record, attrs, false)
	record.Battery = buildBattery(definition)
	record.PowerState = initialPowerState(attrs, definition)

	-- Restore persisted runtime state (unequip/re-insert or respawn with the same serial).
	local state = persisted[root]
	if record.Serial then
		local cached = serialCache[record.Serial]
		if not state and cached and cached.ExpiresAt > t then
			state = cached.State
		end
		-- Always consume: a serial's cached state must never resurrect on a later device.
		serialCache[record.Serial] = nil
	end
	if state then
		counters.RestoredStates += 1
		if attrs.PowerState == nil then
			record.PowerState = state.PowerState
		end
		if state.Battery and record.Battery then
			record.Battery.ChargeWh = math.clamp(state.Battery.ChargeWh, 0, record.Battery.CapacityWh)
			record.Battery.LowWarned = state.Battery.LowWarned
			record.Battery.CriticalWarned = state.Battery.CriticalWarned
		end
		if type(attrs.EmissionEnabled) ~= "boolean" and record.Emitters[1] then
			record.Emitters[1].Transmitting = state.Transmitting
		end
		persisted[root] = nil
	end
	if record.Battery and record.Battery.ChargeWh <= 0 and record.PowerState == "On" then
		record.PowerState = "Depleted"
	end

	devices[record.Id] = record
	byRoot[root] = record
	addToList(record)
	connectDevice(record)
	Registry:RefreshPose(record, t)
	counters.Registrations += 1
	Registry.DeviceRegistered:Fire(record)
	return record
end

local function unregister(record: DeviceRecord, reason: string)
	local root = record.Root
	local state = captureState(record)
	persisted[root] = state
	if record.Serial then
		serialCache[record.Serial] = { State = state, ExpiresAt = now() + config.Registry.PersistSecondsAfterRemoval }
	end
	local bag = deviceBags[record.Id]
	if bag then
		bag:Clean()
		deviceBags[record.Id] = nil
	end
	spatial:Remove(record.Id)
	devices[record.Id] = nil
	if byRoot[root] == record then
		byRoot[root] = nil
	end
	removeFromList(record)
	pendingReconfigure[record] = nil
	pendingPose[record] = nil
	record.InWorld = false
	counters.Unregistrations += 1
	Registry.DeviceUnregistered:Fire(record, reason)
end

--------------------------------------------------------------------------------
-- Source tracking
--------------------------------------------------------------------------------

local function getSources(root: Instance): RootSources
	local sources = rootSources[root]
	if not sources then
		local bag = ConnectionBag.new()
		sources = { Flags = {}, Tag = false, API = nil, Bag = bag }
		rootSources[root] = sources
		-- Root-level watches let tag/API devices re-register when they come back into the world.
		bag:Add(root.AncestryChanged:Connect(function()
			pendingRoots[root] = true
			scheduleProcess()
		end))
	end
	return sources
end

local function releaseSourcesIfEmpty(root: Instance)
	local sources = rootSources[root]
	if sources and next(sources.Flags) == nil and not sources.Tag and sources.API == nil then
		sources.Bag:Clean()
		rootSources[root] = nil
	end
end

local function evaluateRoot(root: Instance)
	local sources = rootSources[root]
	local record = byRoot[root]
	local hasSource = sources ~= nil and (next(sources.Flags) ~= nil or sources.Tag or sources.API ~= nil)
	local alive = root.Parent ~= nil and isInWorld(root)

	if hasSource and alive then
		local s = sources :: RootSources
		local flagCount = 0
		for _ in pairs(s.Flags) do
			flagCount += 1
		end
		if flagCount > 1 then
			counters.MultiFlagRoots += 1
		end
		local detectable = computeDetectable(root, s)
		if not record then
			register(root, s, detectable)
		else
			record.RegistrationSources = { Flag = flagCount > 0, Tag = s.Tag, API = s.API ~= nil }
			if record.Detectable ~= detectable then
				record.Detectable = detectable
				record.Revision += 1
				Registry.DeviceChanged:Fire(record, "Detectable")
			end
			local owner = resolveOwner(root)
			if owner ~= record.OwnerUserId then
				record.OwnerUserId = owner
				Registry.DeviceChanged:Fire(record, "Owner")
			end
			record.AnchorPart = resolveAnchor(root)
			record.AntennaAttachment = resolveAntenna(root)
			Registry:RefreshPose(record)
		end
	else
		if record then
			unregister(record, if root.Parent == nil then "Destroyed" elseif not hasSource then "SourceRemoved" else "LeftWorld")
		end
		if not hasSource then
			releaseSourcesIfEmpty(root)
		end
	end
end

local function untrackFlag(flag: Instance)
	local bag = flagBags[flag]
	if bag then
		bag:Clean()
		flagBags[flag] = nil
	end
	local root = flagRoot[flag]
	if root then
		flagRoot[flag] = nil
		local sources = rootSources[root]
		if sources then
			sources.Flags[flag] = nil
		end
		pendingRoots[root] = true
	end
end

local function processFlag(flag: Instance)
	if flag.Parent == nil or flag.Name ~= FLAG_NAME or not flag:IsA("BoolValue") or not isInWorld(flag) then
		untrackFlag(flag)
		return
	end
	local root = resolveRoot(flag)
	local oldRoot = flagRoot[flag]
	if root == nil then
		counters.OrphanFlags += 1
		if oldRoot then
			local sources = rootSources[oldRoot]
			if sources then
				sources.Flags[flag] = nil
			end
			flagRoot[flag] = nil
			pendingRoots[oldRoot] = true
		end
		return
	end
	if oldRoot ~= root then
		if oldRoot then
			counters.RootMigrations += 1
			local oldSources = rootSources[oldRoot]
			if oldSources then
				oldSources.Flags[flag] = nil
			end
			pendingRoots[oldRoot] = true
		end
		flagRoot[flag] = root
		getSources(root).Flags[flag] = true
	end
	pendingRoots[root] = true
end

local function trackFlag(flag: Instance)
	if flagBags[flag] then
		pendingFlags[flag] = true
		scheduleProcess()
		return
	end
	counters.FlagDiscoveries += 1
	local bag = ConnectionBag.new()
	flagBags[flag] = bag
	local function mark()
		pendingFlags[flag] = true
		scheduleProcess()
	end
	bag:Add((flag :: BoolValue).Changed:Connect(function()
		counters.FlagChanges += 1
		mark()
	end))
	bag:Add(flag.AncestryChanged:Connect(mark))
	bag:Add(flag.AttributeChanged:Connect(function()
		local root = flagRoot[flag]
		local record = root and byRoot[root]
		if record then
			pendingReconfigure[record] = true
		end
		mark()
	end))
	bag:Add(flag.Destroying:Connect(mark))
	mark()
end

local function processPending()
	processScheduled = false
	counters.DeferredBatches += 1
	local guard = 0
	while (next(pendingFlags) or next(pendingRoots) or next(pendingReconfigure) or next(pendingPose)) and guard < 8 do
		guard += 1
		local flags = pendingFlags
		pendingFlags = {}
		for flag in pairs(flags) do
			processFlag(flag)
		end
		local roots = pendingRoots
		pendingRoots = {}
		for root in pairs(roots) do
			evaluateRoot(root)
		end
		local reconfig = pendingReconfigure
		pendingReconfigure = {}
		for record in pairs(reconfig) do
			if devices[record.Id] == record then
				Registry:Reconfigure(record)
			end
		end
		local poses = pendingPose
		pendingPose = {}
		for record in pairs(poses) do
			if devices[record.Id] == record then
				record.AnchorPart = resolveAnchor(record.Root)
				record.AntennaAttachment = resolveAntenna(record.Root)
				Registry:RefreshPose(record)
				Registry.DeviceChanged:Fire(record, "Pose")
			end
		end
	end
end

scheduleProcess = function()
	if not processScheduled then
		processScheduled = true
		task.defer(processPending)
	end
end

local function onDescendantAdded(inst: Instance)
	if inst.ClassName ~= "BoolValue" then
		return
	end
	if inst.Name == FLAG_NAME then
		trackFlag(inst)
	elseif inst.Name == "Value" then
		-- Catch the common "parent first, rename after" pattern exactly once.
		task.defer(function()
			if inst.Name == FLAG_NAME and inst.Parent then
				trackFlag(inst)
			end
		end)
	end
end

local function hookBackpack(backpack: Instance)
	if backpackBags[backpack] then
		return
	end
	local bag = ConnectionBag.new()
	backpackBags[backpack] = bag
	bag:Add(backpack.DescendantAdded:Connect(onDescendantAdded))
	bag:Add(backpack.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			bag:Clean()
			backpackBags[backpack] = nil
		end
	end))
	for _, desc in ipairs(backpack:GetDescendants()) do
		onDescendantAdded(desc)
	end
end

local function hookPlayer(player: Player)
	if playerBags[player] then
		return
	end
	local bag = ConnectionBag.new()
	playerBags[player] = bag
	bag:Add(player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			hookBackpack(child)
		end
	end))
	for _, child in ipairs(player:GetChildren()) do
		if child:IsA("Backpack") then
			hookBackpack(child)
		end
	end
end

local function onTagAdded(inst: Instance)
	local sources = getSources(inst)
	sources.Tag = true
	pendingRoots[inst] = true
	scheduleProcess()
end

local function onTagRemoved(inst: Instance)
	local sources = rootSources[inst]
	if sources then
		sources.Tag = false
	end
	pendingRoots[inst] = true
	scheduleProcess()
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

function Registry:Init(ctx)
	context = ctx
	config = ctx.Config
	FLAG_NAME = config.Registry.FlagName
end

function Registry:Start()
	-- Initial discovery: one pass over existing content, then events only.
	globalBag:Add(workspace.DescendantAdded:Connect(onDescendantAdded))
	for _, desc in ipairs(workspace:GetDescendants()) do
		onDescendantAdded(desc)
	end
	globalBag:Add(Players.PlayerAdded:Connect(hookPlayer))
	globalBag:Add(Players.PlayerRemoving:Connect(function(player)
		local bag = playerBags[player]
		if bag then
			bag:Clean()
			playerBags[player] = nil
		end
	end))
	for _, player in ipairs(Players:GetPlayers()) do
		hookPlayer(player)
	end
	local tag = config.Registry.TagName
	globalBag:Add(CollectionService:GetInstanceAddedSignal(tag):Connect(onTagAdded))
	globalBag:Add(CollectionService:GetInstanceRemovedSignal(tag):Connect(onTagRemoved))
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		onTagAdded(inst)
	end
	processPending()

	-- Adaptive pose refresh: moving / emitting devices often, idle ones rarely.
	context.Scheduler:AddJob("DevicePoses", 0, 2, function(_, budget)
		local deadline = os.clock() + budget * 0.35
		local count = #deviceList
		if count == 0 then
			return
		end
		local t = now()
		local minI = config.Scheduler.DevicePositionMinInterval
		local maxI = config.Scheduler.DevicePositionMaxInterval
		local processed = 0
		while processed < count and os.clock() < deadline do
			if positionCursor > #deviceList then
				positionCursor = 1
			end
			local record = deviceList[positionCursor]
			positionCursor += 1
			processed += 1
			if record and t >= record.NextPositionUpdate then
				local before = record.Position
				Registry:RefreshPose(record, t)
				local moved = (record.Position - before).Magnitude
				local emitting = record.Emitters[1] ~= nil and record.Emitters[1].Transmitting and record.PowerState == "On"
				if moved > 0.05 or emitting or record.Velocity.Magnitude > config.Scheduler.MovingSpeedThreshold then
					record.PositionInterval = minI
				else
					record.PositionInterval = math.min(record.PositionInterval * 1.5, maxI)
				end
				record.NextPositionUpdate = t + record.PositionInterval
			end
		end
	end)

	context.Scheduler:AddJob("RegistryMaintenance", 10, 8, function()
		local t = now()
		for serial, entry in pairs(serialCache) do
			if entry.ExpiresAt <= t then
				serialCache[serial] = nil
			end
		end
	end)
end

function Registry:Reconfigure(record: DeviceRecord)
	local sources = rootSources[record.Root]
	local attrs = readAttributes(record.Root, sources)
	local previous = record.Attributes or {}
	local oldDefinition = record.DefinitionId
	local definition = buildRadioConfiguration(record, attrs, true)
	if definition.Id ~= oldDefinition then
		-- Equipment type changed: rebuild the battery model but keep the charge fraction.
		local oldBattery = record.Battery
		record.Battery = buildBattery(definition)
		if oldBattery and record.Battery then
			record.Battery.ChargeWh = record.Battery.CapacityWh * (oldBattery.ChargeWh / math.max(oldBattery.CapacityWh, 1e-6))
		end
	end
	if sources then
		local detectable = computeDetectable(record.Root, sources)
		if detectable ~= record.Detectable then
			record.Detectable = detectable
			Registry.DeviceChanged:Fire(record, "Detectable")
		end
	end
	record.Revision += 1
	counters.Reconfigurations += 1
	if previous.EWOwnerUserId ~= attrs.EWOwnerUserId then
		record.OwnerUserId = resolveOwner(record.Root)
	end
	Registry.DeviceChanged:Fire(record, "Configuration")
end

-- Explicit registration for equipment systems (PRC-163, jammer, drones...).
-- options: any SupportedAttributes key plus { Detectable: boolean? }
function Registry:RegisterDevice(root: Instance, options: { [string]: any }?): DeviceRecord?
	local sources = getSources(root)
	sources.API = options or {}
	evaluateRoot(root)
	return byRoot[root]
end

function Registry:UnregisterDevice(root: Instance)
	local sources = rootSources[root]
	if sources then
		sources.API = nil
	end
	evaluateRoot(root)
end

-- Process queued registry changes immediately (tests, deterministic tooling).
function Registry:Flush()
	processPending()
end

function Registry:GetDevice(id: string): DeviceRecord?
	return devices[id]
end

function Registry:GetByRoot(root: Instance): DeviceRecord?
	return byRoot[root]
end

function Registry:FindDeviceFromInstance(inst: Instance?): DeviceRecord?
	local node = inst
	local depth = 0
	while node and depth < config.Registry.MaxRootSearchDepth do
		local record = byRoot[node]
		if record then
			return record
		end
		node = node.Parent
		depth += 1
	end
	return nil
end

function Registry:GetDeviceList(): { DeviceRecord }
	return deviceList
end

function Registry:Count(): number
	return #deviceList
end

function Registry:CountDetectable(): number
	local n = 0
	for _, record in ipairs(deviceList) do
		if record.Detectable then
			n += 1
		end
	end
	return n
end

-- Devices eligible for electronic DETECTION (EWDetectable true, in world).
function Registry:IsEligibleForDetection(record: DeviceRecord): boolean
	return record.Detectable and record.InWorld and devices[record.Id] == record
end

function Registry:QueryRadius(position: Vector3, radius: number): { DeviceRecord }
	local ids = spatial:QueryRadius(position, radius)
	local out = table.create(#ids)
	for _, id in ipairs(ids) do
		local record = devices[id]
		if record then
			table.insert(out, record)
		end
	end
	return out
end

function Registry:SetEmitterTransmitting(record: DeviceRecord, index: number, transmitting: boolean)
	local emitter = record.Emitters[index]
	if not emitter or emitter.Transmitting == transmitting then
		return
	end
	emitter.Transmitting = transmitting
	record.Revision += 1
	Registry.DeviceChanged:Fire(record, "Emission")
end

function Registry:GetCounters()
	local flagsTracked = 0
	for _ in pairs(flagBags) do
		flagsTracked += 1
	end
	local rootsTracked = 0
	for _ in pairs(rootSources) do
		rootsTracked += 1
	end
	local serials = 0
	for _ in pairs(serialCache) do
		serials += 1
	end
	local out = table.clone(counters)
	out.Devices = #deviceList
	out.Detectable = self:CountDetectable()
	out.FlagsTracked = flagsTracked
	out.RootsTracked = rootsTracked
	out.SerialCacheEntries = serials
	out.SpatialItems = spatial:Count()
	out.DeviceConnectionBags = 0
	for _ in pairs(deviceBags) do
		out.DeviceConnectionBags += 1
	end
	out.LiveConnections = SharedUtilities.GetLiveConnectionCount()
	return out
end

return Registry
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000014">
				<Properties>
					<string name="Name">EnvironmentalConditionsAdapter</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EnvironmentalConditionsAdapter
	The only place the EW simulation reads weather / environmental state. Any
	weather system integrates by either:
	  * setting Attributes on Workspace (event-driven, no polling):
	        EW_RainRate        number  mm/h
	        EW_SnowRate        number  mm/h liquid-equivalent
	        EW_Fog             number  0..1  (0.5 = dense fog, ~0.5 g/m^3 liquid water)
	        EW_StormIntensity  number  0..1  (lightning / atmospheric noise)
	        EW_Wind            number  studs/s (cosmetic + antenna sway hook, no RF effect)
	        EW_NoiseEnvironment string "City" | "Residential" | "Rural" | "QuietRural"
	        EW_ExtraNoiseDb    number  added to external noise everywhere
	  * or calling Adapter:SetCondition(name, value) from server code.

	Local noise zones: BaseParts tagged "EWNoiseZone" (invisible volumes) with
	optional attributes NoiseEnvironment (string) and ExtraNoiseDb (number).
	A receiver inside the zone's box uses the zone values.

	PHYSICAL PLAUSIBILITY RULES (implemented below)
	  * Rain/snow/fog attenuation is computed with ITU-R P.838-style coefficients
	    and is negligible below ~2 GHz, so VHF/UHF tactical radios are not hurt
	    by ordinary rain; drone links at 5.8 GHz or Ku-band links are.
	  * Storms raise atmospheric noise mostly at low VHF (lightning noise falls
	    off steeply with frequency).
	  * Wind and visual weather intensity are exposed separately as COSMETIC
	    state so presentation layers never confuse them with propagation.
]]

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EWShared")
local RFMath = require(Shared.RFMath)
local SharedUtilities = require(Shared.SharedUtilities)

local Adapter = {}

Adapter.Changed = SharedUtilities.Signal.new("EnvironmentChanged")

local context
local config
local bag = SharedUtilities.ConnectionBag.new()

local conditions = {
	RainRate = 0,
	SnowRate = 0,
	Fog = 0,
	StormIntensity = 0,
	Wind = 0,
	NoiseEnvironment = "Rural",
	ExtraNoiseDb = 0,
}

local ATTRIBUTE_MAP = {
	EW_RainRate = "RainRate",
	EW_SnowRate = "SnowRate",
	EW_Fog = "Fog",
	EW_StormIntensity = "StormIntensity",
	EW_Wind = "Wind",
	EW_NoiseEnvironment = "NoiseEnvironment",
	EW_ExtraNoiseDb = "ExtraNoiseDb",
}

local zones: { BasePart } = {}

local function sanitize(name: string, value: any): any
	if name == "NoiseEnvironment" then
		if type(value) == "string" and config.Noise.Categories[value] then
			return value
		end
		return config.Noise.DefaultCategory
	end
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	if name == "Fog" or name == "StormIntensity" then
		return math.clamp(value, 0, 1)
	end
	if name == "ExtraNoiseDb" then
		return math.clamp(value, -20, 60)
	end
	return math.max(0, value)
end

function Adapter:Init(ctx)
	context = ctx
	config = ctx.Config
	conditions.NoiseEnvironment = config.Noise.DefaultCategory
end

function Adapter:Start()
	for attribute, name in pairs(ATTRIBUTE_MAP) do
		local value = workspace:GetAttribute(attribute)
		if value ~= nil then
			conditions[name] = sanitize(name, value)
		end
	end
	bag:Add(workspace.AttributeChanged:Connect(function(attribute)
		local name = ATTRIBUTE_MAP[attribute]
		if name then
			conditions[name] = sanitize(name, workspace:GetAttribute(attribute))
			Adapter.Changed:Fire(name, conditions[name])
		end
	end))
	local tag = config.Noise.NoiseZoneTag
	local function addZone(inst)
		if inst:IsA("BasePart") and not table.find(zones, inst) then
			table.insert(zones, inst)
		end
	end
	local function removeZone(inst)
		local i = table.find(zones, inst)
		if i then
			table.remove(zones, i)
		end
	end
	bag:Add(CollectionService:GetInstanceAddedSignal(tag):Connect(addZone))
	bag:Add(CollectionService:GetInstanceRemovedSignal(tag):Connect(removeZone))
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		addZone(inst)
	end
end

function Adapter:SetCondition(name: string, value: any)
	if conditions[name] == nil then
		error("Unknown environmental condition: " .. tostring(name))
	end
	conditions[name] = sanitize(name, value)
	Adapter.Changed:Fire(name, conditions[name])
end

function Adapter:GetConditions()
	return table.clone(conditions)
end

-- Presentation-only state (rain sound, screen effects, antenna sway).
function Adapter:GetCosmeticState()
	return {
		RainIntensity = math.clamp(conditions.RainRate / 50, 0, 1),
		SnowIntensity = math.clamp(conditions.SnowRate / 10, 0, 1),
		Fog = conditions.Fog,
		Storm = conditions.StormIntensity,
		Wind = conditions.Wind,
	}
end

local function zoneAt(position: Vector3): BasePart?
	for _, zone in ipairs(zones) do
		if zone.Parent then
			local localPos = zone.CFrame:PointToObjectSpace(position)
			local half = zone.Size / 2
			if math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z then
				return zone
			end
		end
	end
	return nil
end

-- External (environmental) noise figure Fa in dB above kTB at a receiver.
function Adapter:GetExternalNoiseFigureDb(position: Vector3, frequencyMHz: number): (number, string)
	local category = conditions.NoiseEnvironment
	local extra = conditions.ExtraNoiseDb
	local zone = zoneAt(position)
	if zone then
		local zc = zone:GetAttribute("NoiseEnvironment")
		if type(zc) == "string" and config.Noise.Categories[zc] then
			category = zc
		end
		local ze = zone:GetAttribute("ExtraNoiseDb")
		if type(ze) == "number" then
			extra += ze
		end
	end
	local curve = config.Noise.Categories[category] or config.Noise.Categories[config.Noise.DefaultCategory]
	local fa = RFMath.ManMadeNoiseFigureDb(curve.c, curve.d, frequencyMHz)
	local galactic = config.Noise.Categories.Galactic
	-- Galactic noise sets a floor for an outdoor antenna in the VHF range.
	local faGalactic = RFMath.ManMadeNoiseFigureDb(galactic.c, galactic.d, frequencyMHz)
	fa = RFMath.LinearToDb(RFMath.DbToLinear(fa) + RFMath.DbToLinear(faGalactic))
	if conditions.StormIntensity > 0 then
		-- Atmospheric noise boost: StormNoiseMaxDb at 30 MHz, falling 15 dB per decade.
		local boost = conditions.StormIntensity
			* math.max(0, config.Noise.StormNoiseMaxDb - 15 * math.log10(math.max(frequencyMHz, 1) / 30))
		fa += boost
	end
	return fa + extra, category
end

-- Weather path attenuation (dB) over a path length in meters.
function Adapter:GetPathWeatherLossDb(frequencyMHz: number, pathMeters: number): (number, { [string]: number })
	local fGHz = frequencyMHz / 1000
	local km = pathMeters / 1000
	local rain = RFMath.RainSpecificAttenuationDbPerKm(fGHz, conditions.RainRate) * km
	-- Wet snow is approximated as half the attenuation of equivalent liquid rain rate.
	local snow = RFMath.RainSpecificAttenuationDbPerKm(fGHz, conditions.SnowRate) * 0.5 * km
	local fog = RFMath.FogSpecificCoefficient(fGHz) * (conditions.Fog * 1.0) * km
	return rain + snow + fog, { Rain = rain, Snow = snow, Fog = fog }
end

return Adapter
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000015">
				<Properties>
					<string name="Name">EquipmentPowerService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EquipmentPowerService
	Authoritative power and battery state for every registered device.

	STATES
	  Off      -> (power on)      -> Booting -> On     (BootTimeSeconds from definition)
	  On       -> (power off)     -> Off
	  On       -> (battery empty) -> Depleted          (shutdown, emissions stop)
	  any      -> (SetFault)      -> Fault             (malfunction; must be cleared)
	  Depleted -> (ReplaceBattery)-> Off

	Battery drain per tick (W -> Wh):
	  draw = IdleDrawW + ReceiveDrawW (if a receiver is enabled)
	       + TransmitDrawW * DutyCycle (while any emitter is keyed)
	  charge -= draw * dt / 3600 * EWConfig.Power.BatteryDrainMultiplier

	Map developers can drive power with the PowerState attribute ("On"/"Off").
	Equipment code uses SetPower / ReplaceBattery / SetFault.

	SIGNALS
	  PowerStateChanged(record, oldState, newState, reason)
	  BatteryWarning(record, level: "Low" | "Critical", fraction)
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EWShared")
local SharedUtilities = require(Shared.SharedUtilities)
local DeviceDefinitions = require(Shared.DeviceDefinitions)

local EquipmentPowerService = {}

EquipmentPowerService.PowerStateChanged = SharedUtilities.Signal.new("PowerStateChanged")
EquipmentPowerService.BatteryWarning = SharedUtilities.Signal.new("BatteryWarning")

local context
local config
local registry

local function setState(record, newState: string, reason: string)
	local old = record.PowerState
	if old == newState then
		return
	end
	record.PowerState = newState
	record.PowerStateChangedAt = os.clock()
	record.Revision += 1
	if newState ~= "On" and newState ~= "Booting" then
		-- Powered-down radios cannot stay keyed. Continuous emitters keep their
		-- "enabled" configuration but the RF engine only radiates while On.
		for index, emitter in ipairs(record.Emitters) do
			if emitter.Transmitting and not emitter.ContinuousEmission then
				registry:SetEmitterTransmitting(record, index, false)
			end
		end
	end
	EquipmentPowerService.PowerStateChanged:Fire(record, old, newState, reason)
end

function EquipmentPowerService:Init(ctx)
	context = ctx
	config = ctx.Config
	registry = ctx.Registry
end

function EquipmentPowerService:Start()
	registry.DeviceChanged:Connect(function(record, kind)
		if kind == "PowerAttribute" then
			local value = record.Root:GetAttribute("PowerState")
			if value == true or value == "On" or value == "on" or value == "ON" then
				self:SetPower(record, true, "Attribute")
			elseif value == false or value == "Off" or value == "off" or value == "OFF" then
				self:SetPower(record, false, "Attribute")
			end
		end
	end)

	context.Scheduler:AddJob("PowerTick", config.Power.TickSeconds, 1, function(dt)
		self:Tick(math.min(dt, 5))
	end, { Essential = true })
end

function EquipmentPowerService:IsOperational(record): boolean
	return record.PowerState == "On"
end

function EquipmentPowerService:GetBatteryFraction(record): number?
	local battery = record.Battery
	if not battery then
		return nil
	end
	return math.clamp(battery.ChargeWh / math.max(battery.CapacityWh, 1e-6), 0, 1)
end

-- Returns (ok, reasonCode)
function EquipmentPowerService:SetPower(record, on: boolean, reason: string?): (boolean, string)
	reason = reason or "API"
	if on then
		if record.PowerState == "On" or record.PowerState == "Booting" then
			return true, "ALREADY_ON"
		end
		if record.PowerState == "Fault" then
			return false, "DEVICE_FAULT"
		end
		local battery = record.Battery
		if battery and battery.ChargeWh <= 0 then
			setState(record, "Depleted", reason)
			return false, "BATTERY_DEPLETED"
		end
		local definition = DeviceDefinitions.Get(record.DefinitionId) or DeviceDefinitions.Resolve(record.ElectronicType)
		local boot = definition.BootTimeSeconds or config.Power.DefaultBootSeconds
		if boot > 0 then
			record.BootCompleteAt = os.clock() + boot
			setState(record, "Booting", reason)
		else
			setState(record, "On", reason)
		end
		return true, "POWERING_ON"
	else
		if record.PowerState == "Off" then
			return true, "ALREADY_OFF"
		end
		if record.PowerState == "Fault" then
			return false, "DEVICE_FAULT"
		end
		record.BootCompleteAt = nil
		setState(record, if record.PowerState == "Depleted" then "Depleted" else "Off", reason)
		return true, "POWERED_OFF"
	end
end

function EquipmentPowerService:SetFault(record, faultReason: string)
	record.FaultReason = faultReason
	setState(record, "Fault", faultReason)
end

function EquipmentPowerService:ClearFault(record)
	if record.PowerState == "Fault" then
		record.FaultReason = nil
		setState(record, "Off", "FaultCleared")
	end
end

-- Replace (or recharge) a removable battery. Swapping interrupts power.
function EquipmentPowerService:ReplaceBattery(record, chargeFraction: number?): (boolean, string)
	local battery = record.Battery
	if not battery then
		return false, "NO_BATTERY"
	end
	if not battery.Removable then
		return false, "BATTERY_NOT_REMOVABLE"
	end
	if record.PowerState == "On" or record.PowerState == "Booting" then
		setState(record, "Off", "BatterySwap")
	end
	battery.ChargeWh = battery.CapacityWh * math.clamp(chargeFraction or 1, 0, 1)
	battery.LowWarned = false
	battery.CriticalWarned = false
	if record.PowerState == "Depleted" then
		setState(record, "Off", "BatterySwap")
	end
	record.Revision += 1
	return true, "BATTERY_REPLACED"
end

-- Developer/test helper.
function EquipmentPowerService:SetCharge(record, fraction: number)
	local battery = record.Battery
	if not battery then
		return
	end
	battery.ChargeWh = battery.CapacityWh * math.clamp(fraction, 0, 1)
	if battery.ChargeWh <= 0 and (record.PowerState == "On" or record.PowerState == "Booting") then
		setState(record, "Depleted", "BatteryEmpty")
	end
end

function EquipmentPowerService:CurrentDrawW(record): number
	local battery = record.Battery
	if not battery then
		return 0
	end
	local draw = battery.IdleDrawW
	for _, receiver in ipairs(record.Receivers) do
		if receiver.Enabled then
			draw += battery.ReceiveDrawW
			break
		end
	end
	for _, emitter in ipairs(record.Emitters) do
		if emitter.Transmitting then
			draw += battery.TransmitDrawW * math.clamp(emitter.DutyCycle, 0, 1)
			break
		end
	end
	return draw
end

function EquipmentPowerService:Tick(dt: number)
	local nowT = os.clock()
	local multiplier = config.Power.BatteryDrainMultiplier
	for _, record in ipairs(registry:GetDeviceList()) do
		local state = record.PowerState
		if state == "Booting" and record.BootCompleteAt and nowT >= record.BootCompleteAt then
			record.BootCompleteAt = nil
			setState(record, "On", "BootComplete")
			state = "On"
		end
		local battery = record.Battery
		if battery and (state == "On" or state == "Booting") then
			local draw = self:CurrentDrawW(record)
			battery.ChargeWh = math.max(0, battery.ChargeWh - draw * dt / 3600 * multiplier)
			local fraction = battery.ChargeWh / math.max(battery.CapacityWh, 1e-6)
			if fraction <= 0 then
				setState(record, "Depleted", "BatteryEmpty")
			elseif fraction <= battery.CriticalFraction and not battery.CriticalWarned then
				battery.CriticalWarned = true
				EquipmentPowerService.BatteryWarning:Fire(record, "Critical", fraction)
			elseif fraction <= battery.LowFraction and not battery.LowWarned then
				battery.LowWarned = true
				EquipmentPowerService.BatteryWarning:Fire(record, "Low", fraction)
			end
		end
	end
end

return EquipmentPowerService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000016">
				<Properties>
					<string name="Name">RFSimulationService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	RFSimulationService
	The central electromagnetic environment. Every system that needs to know
	"how strong is emitter X at point Y" or "does this link work" asks here, so
	radios, jammers, ES receivers, drones and relays share one consistent model.

	LINK BUDGET (all in dB / dBm, see docs/PHASE1_ARCHITECTURE.md section 4)
	  EIRP      = TxPower + TxAntennaGain(direction)
	  PathLoss  = Basic(FSPL | plane-earth, effective antenna heights)
	            + Excess(terrain diffraction / penetration, structures, vegetation, water)
	            + Weather(rain/snow/fog, frequency dependent)
	            + Polarization mismatch
	  Fading    = shadow (spatially correlated) + small-scale (Rician/Rayleigh, Doppler-correlated)
	            + equipment instability jitter
	  Received  = EIRP + RxAntennaGain - PathLoss + Fading
	  InBand    = Received - CouplingLoss (frequency / bandwidth overlap)
	  Noise     = kTB + (receiver NF combined with ITU-R P.372 external noise)
	  SINR      = InBand - (Noise (+) Interference)      (+) = power sum
	  Quality   = SignalQualityService(SINR - RequiredSinr, compatibility, power)

	A LinkResult describes the POTENTIAL quality of the link if the transmitter
	keys (TxActive tells whether it actually is). Presentation of traffic is done
	by later phases using this result.

	API
	  RF:EvaluateLink(txRecord, rxRecord, options) -> LinkResult
	      options = { EmitterIndex?, ReceiverIndex?, Force?, Deterministic?,
	                  IncludeInterference?, Priority?, Previous?, FadeState?, RefreshPose? }
	  RF:ComputeReceivedPower(txRecord, emitterIndex, rxPosition, rxCFrame, rxAntenna, options)
	      -> (receivedDbm, breakdown)   generic propagation for any receiver point
	  RF:ComputeInterferenceDbm(receiver, rxRecord, rxPosition, rxCFrame, excludeEmitterId, options)
	      -> (interferenceDbm, count, contributions)
	  RF:WatchLink(txId, rxId, options) -> watchId     (scheduler keeps it updated)
	  RF:UnwatchLink(watchId)
	  RF:GetWatch(watchId) / RF:GetWatches()
	  RF:GetActiveEmissions() -> { {Record, Emitter, Index} }
	  RF:GetDetectableEmissions() -> same, filtered by EWDetectable eligibility
	SIGNALS
	  LinkUpdated(watchId, LinkResult)
	  LinkRemoved(watchId, reason)
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EWShared")
local RFMath = require(Shared.RFMath)
local SignalCompatibility = require(Shared.SignalCompatibility)
local SharedUtilities = require(Shared.SharedUtilities)
local Types = require(Shared.EWTypes)

type DeviceRecord = Types.DeviceRecord
type LinkResult = Types.LinkResult

local RF = {}

RF.LinkUpdated = SharedUtilities.Signal.new("LinkUpdated")
RF.LinkRemoved = SharedUtilities.Signal.new("LinkRemoved")

local context
local config
local registry
local terrainService
local qualityService
local environment

local activeEmissions: { [string]: { Record: DeviceRecord, Emitter: any, Index: number } } = {}
local activeCount = 0

type Watch = {
	Id: string,
	TxId: string,
	RxId: string,
	EmitterIndex: number,
	ReceiverIndex: number,
	Priority: number,
	Label: string,
	IncludeInterference: boolean,
	Deterministic: boolean,
	NextDue: number,
	LastTxPos: Vector3?,
	LastRxPos: Vector3?,
	LastResult: LinkResult?,
	FadeState: any,
	Evaluations: number,
	CreatedAt: number,
}
local watches: { [string]: Watch } = {}
local watchList: { Watch } = {}
local watchCursor = 1
local nextWatchNumber = 0
local oneShotRandom = Random.new()

local stats = {
	Evaluations = 0,
	ForcedEvaluations = 0,
	DeferredEvaluations = 0,
	InterferenceEvaluations = 0,
	EvaluationMsAvg = 0,
	EvaluationMsMax = 0,
	WatchEvaluations = 0,
}

--------------------------------------------------------------------------------
-- Active emission bookkeeping (event driven)
--------------------------------------------------------------------------------

local function refreshActive(record: DeviceRecord)
	for index, emitter in ipairs(record.Emitters) do
		local key = emitter.Id
		local active = record.PowerState == "On" and emitter.Transmitting and record.InWorld and registry:GetDevice(record.Id) == record
		if active and not activeEmissions[key] then
			activeEmissions[key] = { Record = record, Emitter = emitter, Index = index }
			activeCount += 1
		elseif not active and activeEmissions[key] then
			activeEmissions[key] = nil
			activeCount -= 1
		elseif active then
			-- Emitter table may have been rebuilt by a reconfiguration.
			activeEmissions[key].Emitter = emitter
		end
	end
	-- Drop stale entries for emitters that no longer exist on this record.
	for key, entry in pairs(activeEmissions) do
		if entry.Record == record and not record.Emitters[entry.Index] then
			activeEmissions[key] = nil
			activeCount -= 1
		end
	end
end

local function removeAllFor(record: DeviceRecord)
	for key, entry in pairs(activeEmissions) do
		if entry.Record == record then
			activeEmissions[key] = nil
			activeCount -= 1
		end
	end
end

function RF:GetActiveEmissions()
	local out = {}
	for _, entry in pairs(activeEmissions) do
		table.insert(out, entry)
	end
	return out
end

-- Emissions eligible to appear in electronic DETECTION results (EWDetectable = true).
function RF:GetDetectableEmissions()
	local out = {}
	for _, entry in pairs(activeEmissions) do
		if registry:IsEligibleForDetection(entry.Record) then
			table.insert(out, entry)
		end
	end
	return out
end

function RF:GetActiveEmissionCount(): number
	return activeCount
end

--------------------------------------------------------------------------------
-- Geometry helpers
--------------------------------------------------------------------------------

local function antennaAxis(cf: CFrame, polarization: string): Vector3
	if polarization == "Horizontal" then
		return cf.RightVector
	end
	return cf.UpVector
end

local function effectiveHeightMeters(position: Vector3, ground: number, meanGround: number, antenna, mps: number): number
	local localStuds = position.Y - ground
	if localStuds < 0 then
		-- Antenna under a roof/overhang: assume it stands on a floor at its mounting height.
		localStuds = antenna.HeightOffsetStuds
	end
	local aboveMean = position.Y - meanGround
	return math.max(math.max(localStuds, aboveMean) * mps, 0.5)
end

local function newFadeState(seed: number)
	return { G1 = 0, G2 = 0, Time = os.clock(), Rng = Random.new(seed), Initialized = false }
end

local function gaussian(rng: Random): number
	local u1 = math.max(rng:NextNumber(), 1e-9)
	local u2 = rng:NextNumber()
	return math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2)
end

-- Returns (shadowDb, fastDb, jitterDb) as GAINS (positive = stronger signal).
local function computeFading(class: string, txRecord: DeviceRecord, rxRecord: DeviceRecord?, txPos: Vector3, rxPos: Vector3, frequencyMHz: number, stability: number, fadeState)
	local F = config.Fading
	if not F.Enabled then
		return 0, 0, 0
	end
	local sigma = F.ShadowSigmaDb[class] or 3
	local decor = F.ShadowDecorrelationStuds
	local seed = 7919 + math.floor(math.log10(math.max(frequencyMHz, 1)) * 10)
	local n1 = RFMath.GaussianValueNoise2D(txPos.X, txPos.Z, decor, seed)
	local n2 = RFMath.GaussianValueNoise2D(rxPos.X, rxPos.Z, decor, seed + 31)
	local shadow = sigma * (n1 + n2) / math.sqrt(2)

	local k = F.RicianK[class] or 1
	local rng = if fadeState then fadeState.Rng else oneShotRandom
	local g1, g2
	if fadeState then
		local t = os.clock()
		local dt = math.max(t - fadeState.Time, 0)
		fadeState.Time = t
		local relative = txRecord.Velocity - (if rxRecord then rxRecord.Velocity else Vector3.zero)
		local speed = relative.Magnitude * config.Units.MetersPerStud
		local doppler = speed / RFMath.WavelengthMeters(frequencyMHz) + F.MinDopplerHz
		local tau = 0.423 / doppler
		local rho = if fadeState.Initialized then math.exp(-dt / tau) else 0
		local s = math.sqrt(math.max(1 - rho * rho, 0))
		fadeState.G1 = rho * fadeState.G1 + s * gaussian(rng)
		fadeState.G2 = rho * fadeState.G2 + s * gaussian(rng)
		fadeState.Initialized = true
		g1, g2 = fadeState.G1, fadeState.G2
	else
		g1, g2 = gaussian(rng), gaussian(rng)
	end
	local fast = RFMath.RicianPowerGainDb(g1, g2, k, F.DeepFadeFloorDb)
	local jitter = math.clamp((1 - stability) * F.EquipmentJitterMaxDb * gaussian(rng), -F.EquipmentJitterMaxDb, F.EquipmentJitterMaxDb)
	return shadow, fast, jitter
end

--------------------------------------------------------------------------------
-- Core propagation
--------------------------------------------------------------------------------

--[[
	propagate(): shared physics for links, interference and (later) detection.
	Returns a breakdown table; never decides intelligibility.
]]
local function propagate(txRecord: DeviceRecord, emitter, rxRecord: DeviceRecord?, rxPos: Vector3, rxCF: CFrame, rxAntenna, frequencyMHz: number, options)
	local mps = config.Units.MetersPerStud
	local txPos = txRecord.Position
	local txCF = txRecord.AntennaCFrame
	local delta = rxPos - txPos
	local dStuds = delta.Magnitude
	local dMeters = math.max(dStuds * mps, config.Units.MinLinkDistanceMeters)
	local dir = if dStuds > 1e-4 then delta / dStuds else Vector3.new(0, 0, -1)

	local exclude = { txRecord.Root }
	if rxRecord then
		table.insert(exclude, rxRecord.Root)
	end
	local geometry = terrainService:AnalyzePath(txPos, rxPos, {
		ExcludeInstances = exclude,
		Priority = options.Priority or 2,
		Force = options.Force == true,
	})

	local out = {
		DistanceStuds = dStuds,
		DistanceMeters = dMeters,
		Geometry = geometry,
		Losses = nil,
		AnalysisMode = "Deferred",
		Stale = true,
	}
	if geometry == nil then
		return out
	end
	out.AnalysisMode = geometry.Mode
	out.Stale = geometry.Approximate
	local losses = terrainService:ComputeLosses(geometry, frequencyMHz)
	out.Losses = losses

	local groundTx = terrainService:GetEndpointGround(geometry, txPos)
	local groundRx = terrainService:GetEndpointGround(geometry, rxPos)
	local hTx = effectiveHeightMeters(txPos, groundTx, geometry.MeanInteriorGround, emitter.Antenna, mps)
	local hRx = effectiveHeightMeters(rxPos, groundRx, geometry.MeanInteriorGround, rxAntenna, mps)
	local rangeMeters = dMeters * config.Units.RangeScale
	local basic, fspl, planeEarth, model = RFMath.BasicTransmissionLossDb(rangeMeters, hTx, hRx, frequencyMHz)

	local ta = emitter.Antenna
	local txGain = RFMath.AntennaGainDbi(ta.Pattern, ta.GainDbi, ta.BeamwidthDeg, ta.FrontToBackDb, ta.ElevationFloorDb, txCF.UpVector, txCF.LookVector, dir)
	local ra = rxAntenna
	local rxGain = RFMath.AntennaGainDbi(ra.Pattern, ra.GainDbi, ra.BeamwidthDeg, ra.FrontToBackDb, ra.ElevationFloorDb, rxCF.UpVector, rxCF.LookVector, -dir)
	local polarization = RFMath.PolarizationLossDb(ta.Polarization, antennaAxis(txCF, ta.Polarization), ra.Polarization, antennaAxis(rxCF, ra.Polarization), dir, 20)
	local weather = environment:GetPathWeatherLossDb(frequencyMHz, dMeters)

	local shadow, fast, jitter = 0, 0, 0
	if not options.Deterministic then
		shadow, fast, jitter = computeFading(losses.Class, txRecord, rxRecord, txPos, rxPos, frequencyMHz, emitter.Stability, options.FadeState)
	end

	local eirp = emitter.TxPowerDbm + txGain
	local totalLoss = basic + losses.ExcessDb + weather + polarization
	local received = eirp + rxGain - totalLoss + shadow + fast + jitter

	out.HeightTx = hTx
	out.HeightRx = hRx
	out.Basic = basic
	out.Fspl = fspl
	out.PlaneEarth = planeEarth
	out.BasicModel = model
	out.TxGain = txGain
	out.RxGain = rxGain
	out.Polarization = polarization
	out.Weather = weather
	out.Shadow = shadow
	out.Fast = fast
	out.Jitter = jitter
	out.Eirp = eirp
	out.TotalLoss = totalLoss - shadow - fast - jitter
	out.Received = received
	return out
end

-- Generic received power of one emitter at an arbitrary receiving point.
function RF:ComputeReceivedPower(txRecord: DeviceRecord, emitterIndex: number, rxPosition: Vector3, rxCFrame: CFrame?, rxAntenna, options)
	local emitter = txRecord.Emitters[emitterIndex or 1]
	if not emitter then
		return -math.huge, nil
	end
	local cf = rxCFrame or CFrame.new(rxPosition)
	local antenna = rxAntenna
		or { Pattern = "Isotropic", GainDbi = 0, BeamwidthDeg = 360, FrontToBackDb = 0, ElevationFloorDb = 0, Polarization = "Vertical", HeightOffsetStuds = 0 }
	local breakdown = propagate(txRecord, emitter, nil, rxPosition, cf, antenna, emitter.FrequencyMHz, options or {})
	return breakdown.Received or -math.huge, breakdown
end

-- Quick estimate without terrain (used to rank interferers before detailed analysis).
local function estimateReceived(entry, rxPos: Vector3, rxAntenna): number
	local mps = config.Units.MetersPerStud
	local record = entry.Record
	local emitter = entry.Emitter
	local d = math.max((rxPos - record.Position).Magnitude * mps * config.Units.RangeScale, 1)
	local hTx = math.max(emitter.Antenna.HeightOffsetStuds * mps, 0.5)
	local hRx = math.max(rxAntenna.HeightOffsetStuds * mps, 0.5)
	local basic = RFMath.BasicTransmissionLossDb(d, hTx, hRx, emitter.FrequencyMHz)
	return emitter.TxPowerDbm + emitter.Antenna.GainDbi + rxAntenna.GainDbi - basic
end

function RF:ComputeInterferenceDbm(receiver, rxRecord: DeviceRecord?, rxPos: Vector3, rxCF: CFrame, excludeEmitterId: string?, options)
	options = options or {}
	local I = config.Interference
	if not I.Enabled or activeCount == 0 then
		return -math.huge, 0, {}
	end
	stats.InterferenceEvaluations += 1
	local couplingOptions = {
		AdjacentChannelRejectionDb = I.AdjacentChannelRejectionDb,
		AdjacentChannelSpan = I.AdjacentChannelSpan,
		MinUsefulOverlap = I.MinUsefulOverlap,
	}
	local candidates = {}
	local maxRange = I.MaxCandidateRangeStuds
	for _, entry in pairs(activeEmissions) do
		local record = entry.Record
		local emitter = entry.Emitter
		if emitter.Id ~= excludeEmitterId and record ~= rxRecord and record.InWorld then
			if (record.Position - rxPos).Magnitude <= maxRange then
				local _, coupling = SignalCompatibility.EnergyCoupling(emitter.FrequencyMHz, emitter.BandwidthKHz, receiver.FrequencyMHz, receiver.BandwidthKHz, couplingOptions)
				if coupling < math.huge then
					local duty = 10 * math.log10(math.max(emitter.DutyCycle, 1e-6))
					local estimate = estimateReceived(entry, rxPos, receiver.Antenna) - coupling + duty
					table.insert(candidates, { Entry = entry, Coupling = coupling, Duty = duty, Estimate = estimate })
				end
			end
		end
	end
	if #candidates == 0 then
		return -math.huge, 0, {}
	end
	table.sort(candidates, function(a, b)
		return a.Estimate > b.Estimate
	end)
	local profile = context.Scheduler:GetProfile()
	local detailed = math.min(I.MaxDetailedInterferers, profile.MaxDetailedInterferers)
	local totalLinear = 0
	local contributions = {}
	for i, c in ipairs(candidates) do
		local power = c.Estimate
		local mode = "Estimate"
		if i <= detailed then
			local breakdown = propagate(c.Entry.Record, c.Entry.Emitter, rxRecord, rxPos, rxCF, receiver.Antenna, c.Entry.Emitter.FrequencyMHz, {
				Force = options.Force,
				Deterministic = options.Deterministic,
				Priority = 3,
			})
			if breakdown.Received then
				power = breakdown.Received - c.Coupling + c.Duty
				mode = "Detailed"
			end
		end
		power -= receiver.InterferenceRejectionDb
		totalLinear += RFMath.DbToLinear(power)
		if i <= 8 then
			table.insert(contributions, { EmitterId = c.Entry.Emitter.Id, DeviceId = c.Entry.Record.Id, PowerDbm = power, Mode = mode })
		end
	end
	return RFMath.LinearToDb(totalLinear), #candidates, contributions
end

--------------------------------------------------------------------------------
-- Link evaluation
--------------------------------------------------------------------------------

local function emptyCompatibility(): Types.CompatibilityResult
	return {
		FrequencyOffsetMHz = 0,
		OverlapFraction = 0,
		CouplingLossDb = math.huge,
		InBand = false,
		ModulationMatch = false,
		NetworkMatch = false,
		SecurityMatch = false,
		Intelligible = false,
		Reasons = {},
	}
end

function RF:EvaluateLink(txRecord: DeviceRecord, rxRecord: DeviceRecord, options): LinkResult
	options = options or {}
	local t0 = os.clock()
	stats.Evaluations += 1
	if options.Force then
		stats.ForcedEvaluations += 1
	end
	if options.RefreshPose then
		registry:RefreshPose(txRecord)
		registry:RefreshPose(rxRecord)
	end
	local emitter = txRecord.Emitters[options.EmitterIndex or 1]
	local receiver = rxRecord.Receivers[options.ReceiverIndex or 1]
	local reasons = {}
	local previous: LinkResult? = options.Previous

	local result: any = {
		TxDeviceId = txRecord.Id,
		RxDeviceId = rxRecord.Id,
		EmitterId = emitter and emitter.Id or "",
		ReceiverId = receiver and receiver.Id or "",
		FrequencyMHz = emitter and emitter.FrequencyMHz or 0,
		DistanceStuds = (rxRecord.Position - txRecord.Position).Magnitude,
		DistanceMeters = (rxRecord.Position - txRecord.Position).Magnitude * config.Units.MetersPerStud,
		TxActive = false,
		EirpDbm = -math.huge,
		TxPowerDbm = emitter and emitter.TxPowerDbm or -math.huge,
		TxGainDbi = 0,
		RxGainDbi = 0,
		PolarizationLossDb = 0,
		FsplDb = 0,
		PlaneEarthDb = 0,
		BasicLossDb = 0,
		BasicModel = "None",
		EffectiveHeightTxM = 0,
		EffectiveHeightRxM = 0,
		Propagation = nil,
		WeatherLossDb = 0,
		ShadowFadingDb = 0,
		FastFadingDb = 0,
		EquipmentJitterDb = 0,
		TotalPathLossDb = math.huge,
		ReceivedPowerDbm = -math.huge,
		InBandSignalDbm = -math.huge,
		NoiseFloorDbm = 0,
		ExternalNoiseFigureDb = 0,
		InterferenceDbm = -math.huge,
		InterfererCount = 0,
		SnrDb = -math.huge,
		SinrDb = -math.huge,
		Compatibility = emptyCompatibility(),
		Quality = nil,
		AnalysisMode = "Deferred",
		Stale = false,
		Timestamp = os.clock(),
		Reasons = reasons,
	}

	local function finish(state: string?)
		local powered = txRecord.PowerState == "On" and rxRecord.PowerState == "On"
		if state then
			result.Quality = {
				State = state,
				Score = 0,
				MarginDb = -math.huge,
				SmoothedMarginDb = if previous and previous.Quality then previous.Quality.SmoothedMarginDb else -20,
				PacketLoss = 1,
				NoiseLevel = 1,
				DropoutRate = 1,
				Readability = 1,
				Strength = 1,
			}
		else
			result.Quality = qualityService:Evaluate({
				SinrDb = result.SinrDb,
				RequiredSinrDb = receiver.RequiredSinrDb,
				ReceivedPowerDbm = result.InBandSignalDbm,
				SensitivityDbm = receiver.SensitivityDbm,
				Compatible = result.Compatibility.Intelligible,
				Powered = powered,
				Previous = previous and previous.Quality or nil,
			})
		end
		local ms = (os.clock() - t0) * 1000
		stats.EvaluationMsAvg = stats.EvaluationMsAvg * 0.95 + ms * 0.05
		if ms > stats.EvaluationMsMax then
			stats.EvaluationMsMax = ms
		end
		return result :: LinkResult
	end

	if not emitter then
		table.insert(reasons, "NO_EMITTER")
		return finish("NoSignal")
	end
	if not receiver then
		table.insert(reasons, "NO_RECEIVER")
		return finish("NoSignal")
	end
	if txRecord.PowerState ~= "On" then
		table.insert(reasons, "TX_" .. string.upper(txRecord.PowerState))
	end
	if rxRecord.PowerState ~= "On" then
		table.insert(reasons, "RX_" .. string.upper(rxRecord.PowerState))
	end
	if not txRecord.InWorld or not rxRecord.InWorld then
		table.insert(reasons, "NOT_IN_WORLD")
		return finish("Offline")
	end
	result.TxActive = txRecord.PowerState == "On" and emitter.Transmitting

	local compatibility = SignalCompatibility.Evaluate(emitter, receiver, {
		AdjacentChannelRejectionDb = config.Interference.AdjacentChannelRejectionDb,
		AdjacentChannelSpan = config.Interference.AdjacentChannelSpan,
		MinUsefulOverlap = config.Interference.MinUsefulOverlap,
	})
	result.Compatibility = compatibility
	for _, r in ipairs(compatibility.Reasons) do
		table.insert(reasons, r)
	end

	local breakdown = propagate(txRecord, emitter, rxRecord, rxRecord.Position, rxRecord.AntennaCFrame, receiver.Antenna, emitter.FrequencyMHz, {
		Force = options.Force,
		Deterministic = options.Deterministic,
		Priority = options.Priority,
		FadeState = options.FadeState,
	})
	result.AnalysisMode = breakdown.AnalysisMode
	if breakdown.Losses == nil then
		stats.DeferredEvaluations += 1
		table.insert(reasons, "ANALYSIS_DEFERRED")
		if previous then
			-- Keep the last authoritative answer instead of inventing a new one.
			local copy = table.clone(previous)
			copy.Stale = true
			copy.AnalysisMode = "Cached"
			copy.Timestamp = previous.Timestamp
			copy.Reasons = table.clone(previous.Reasons)
			table.insert(copy.Reasons, "ANALYSIS_DEFERRED")
			return copy
		end
		return finish("NoSignal")
	end

	result.Stale = breakdown.Stale
	result.Propagation = breakdown.Losses
	result.DistanceStuds = breakdown.DistanceStuds
	result.DistanceMeters = breakdown.DistanceMeters
	result.EirpDbm = breakdown.Eirp
	result.TxGainDbi = breakdown.TxGain
	result.RxGainDbi = breakdown.RxGain
	result.PolarizationLossDb = breakdown.Polarization
	result.FsplDb = breakdown.Fspl
	result.PlaneEarthDb = breakdown.PlaneEarth
	result.BasicLossDb = breakdown.Basic
	result.BasicModel = breakdown.BasicModel
	result.EffectiveHeightTxM = breakdown.HeightTx
	result.EffectiveHeightRxM = breakdown.HeightRx
	result.WeatherLossDb = breakdown.Weather
	result.ShadowFadingDb = breakdown.Shadow
	result.FastFadingDb = breakdown.Fast
	result.EquipmentJitterDb = breakdown.Jitter
	result.TotalPathLossDb = breakdown.TotalLoss
	result.ReceivedPowerDbm = breakdown.Received
	result.InBandSignalDbm = if compatibility.CouplingLossDb < math.huge then breakdown.Received - compatibility.CouplingLossDb else -math.huge

	local fa = environment:GetExternalNoiseFigureDb(rxRecord.Position, receiver.FrequencyMHz)
	result.ExternalNoiseFigureDb = fa
	result.NoiseFloorDbm = RFMath.SystemNoiseFloorDbm(receiver.BandwidthKHz * 1000, receiver.NoiseFigureDb, fa)

	local includeInterference = options.IncludeInterference ~= false
	if includeInterference then
		local i, count = self:ComputeInterferenceDbm(receiver, rxRecord, rxRecord.Position, rxRecord.AntennaCFrame, emitter.Id, {
			Force = options.Force,
			Deterministic = options.Deterministic,
		})
		result.InterferenceDbm = i
		result.InterfererCount = count
		if count > 0 then
			table.insert(reasons, string.format("INTERFERENCE:%d", count))
		end
	end
	local noisePlusInterference = RFMath.PowerSumDbm(result.NoiseFloorDbm, result.InterferenceDbm)
	result.SnrDb = result.InBandSignalDbm - result.NoiseFloorDbm
	result.SinrDb = result.InBandSignalDbm - noisePlusInterference
	if breakdown.Stale then
		table.insert(reasons, "APPROXIMATE_ANALYSIS")
	end
	return finish(nil)
end

--------------------------------------------------------------------------------
-- Watched links (scheduler driven)
--------------------------------------------------------------------------------

function RF:WatchLink(txId: string, rxId: string, options): string?
	options = options or {}
	local tx = registry:GetDevice(txId)
	local rx = registry:GetDevice(rxId)
	if not tx or not rx then
		return nil
	end
	nextWatchNumber += 1
	local id = SharedUtilities.ShortId("LINK", nextWatchNumber)
	local watch: Watch = {
		Id = id,
		TxId = txId,
		RxId = rxId,
		EmitterIndex = options.EmitterIndex or 1,
		ReceiverIndex = options.ReceiverIndex or 1,
		Priority = math.clamp(options.Priority or 2, 1, 3),
		Label = options.Label or (tx.DisplayName .. " -> " .. rx.DisplayName),
		IncludeInterference = options.IncludeInterference ~= false,
		Deterministic = options.Deterministic == true,
		NextDue = 0,
		LastTxPos = nil,
		LastRxPos = nil,
		LastResult = nil,
		FadeState = newFadeState(nextWatchNumber * 7919),
		Evaluations = 0,
		CreatedAt = os.clock(),
	}
	watches[id] = watch
	table.insert(watchList, watch)
	return id
end

function RF:UnwatchLink(id: string, reason: string?)
	local watch = watches[id]
	if not watch then
		return
	end
	watches[id] = nil
	local index = table.find(watchList, watch)
	if index then
		table.remove(watchList, index)
	end
	RF.LinkRemoved:Fire(id, reason or "Unwatched")
end

function RF:GetWatch(id: string)
	return watches[id]
end

function RF:GetWatches()
	return watchList
end

function RF:EvaluateWatch(watch: Watch, force: boolean?)
	local tx = registry:GetDevice(watch.TxId)
	local rx = registry:GetDevice(watch.RxId)
	if not tx or not rx then
		self:UnwatchLink(watch.Id, "DeviceUnregistered")
		return nil
	end
	local result = self:EvaluateLink(tx, rx, {
		EmitterIndex = watch.EmitterIndex,
		ReceiverIndex = watch.ReceiverIndex,
		Priority = watch.Priority,
		Force = force,
		Deterministic = watch.Deterministic,
		IncludeInterference = watch.IncludeInterference,
		Previous = watch.LastResult,
		FadeState = watch.FadeState,
	})
	watch.Evaluations += 1
	stats.WatchEvaluations += 1
	watch.LastTxPos = tx.Position
	watch.LastRxPos = rx.Position
	local deferred = result.AnalysisMode == "Deferred" and watch.LastResult == nil
	if not deferred then
		watch.LastResult = result
		RF.LinkUpdated:Fire(watch.Id, result)
	end
	local profile = context.Scheduler:GetProfile()
	local interval = config.Scheduler.LinkIntervals[watch.Priority] * profile.LinkIntervalMultiplier
	-- Retry deferred analyses on the next frames instead of waiting a full interval.
	local retrySoon = result.AnalysisMode == "Deferred" or (result.AnalysisMode == "Cached" and result.Stale)
	watch.NextDue = os.clock() + (if retrySoon then 0.05 else interval)
	return result
end

local function isDue(watch: Watch, now: number): boolean
	if now >= watch.NextDue then
		return true
	end
	local tx = registry:GetDevice(watch.TxId)
	local rx = registry:GetDevice(watch.RxId)
	local threshold = config.Scheduler.LinkMoveThresholdStuds
	if tx and watch.LastTxPos and (tx.Position - watch.LastTxPos).Magnitude > threshold then
		return true
	end
	if rx and watch.LastRxPos and (rx.Position - watch.LastRxPos).Magnitude > threshold then
		return true
	end
	return false
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

function RF:Init(ctx)
	context = ctx
	config = ctx.Config
	registry = ctx.Registry
	terrainService = ctx.Terrain
	qualityService = ctx.Quality
	environment = ctx.Environment
end

function RF:Start()
	registry.DeviceRegistered:Connect(refreshActive)
	registry.DeviceChanged:Connect(function(record, kind)
		if kind == "Emission" or kind == "Configuration" or kind == "Pose" then
			refreshActive(record)
		end
	end)
	registry.DeviceUnregistered:Connect(function(record)
		removeAllFor(record)
		for i = #watchList, 1, -1 do
			local watch = watchList[i]
			if watch.TxId == record.Id or watch.RxId == record.Id then
				self:UnwatchLink(watch.Id, "DeviceUnregistered")
			end
		end
	end)
	context.Power.PowerStateChanged:Connect(function(record)
		refreshActive(record)
	end)
	for _, record in ipairs(registry:GetDeviceList()) do
		refreshActive(record)
	end

	context.Scheduler:AddJob("LinkEvaluation", 0, 3, function(_, budget)
		local count = #watchList
		if count == 0 then
			return
		end
		local deadline = os.clock() + budget * 0.85
		local now = os.clock()
		local visited = 0
		while visited < count and os.clock() < deadline do
			if watchCursor > #watchList then
				watchCursor = 1
			end
			local watch = watchList[watchCursor]
			watchCursor += 1
			visited += 1
			if watch and isDue(watch, now) then
				self:EvaluateWatch(watch, false)
			end
		end
	end)

	-- InWorld can change without an event (tool owner died, etc.); re-check lazily.
	context.Scheduler:AddJob("EmissionAudit", 2, 7, function()
		for _, record in ipairs(registry:GetDeviceList()) do
			refreshActive(record)
		end
	end)
end

function RF:GetStats()
	local out = table.clone(stats)
	out.ActiveEmissions = activeCount
	out.WatchedLinks = #watchList
	return out
end

return RF
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000017">
				<Properties>
					<string name="Name">SignalQualityService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	SignalQualityService
	Maps a computed link budget to a player-facing quality state. Presentation
	layers (radio audio, text traffic, data links) consume QualityResult and never
	recompute RF themselves.

	margin = SINR - RequiredSinr(receiver profile)

	State (with hysteresis so a link hovering on a threshold does not flicker):
	  Clear     margin >= 15 dB   clear voice / data
	  Good      margin >=  8 dB   minor hiss
	  Degraded  margin >=  3 dB   occasional noise / dropouts
	  Broken    margin >= -1 dB   distorted, interrupted, partial messages
	  Unusable  margin <  -1 dB   incomplete / unintelligible
	  NoSignal  received power far below sensitivity, or margin < -10 dB
	  Incompatible  energy present but wrong mode / network / security / frequency
	  Offline   transmitter or receiver not powered

	Derived presentation values (all 0..1 unless noted):
	  Score, PacketLoss, NoiseLevel, DropoutRate, Readability (1..5), Strength (1..5)
	Readability/Strength follow the familiar radio-check "loud and clear" scale.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EWShared")
local RFMath = require(Shared.RFMath)

local SignalQualityService = {}

local config
local ORDER = { "Clear", "Good", "Degraded", "Broken", "Unusable" }
local RANK = { Clear = 1, Good = 2, Degraded = 3, Broken = 4, Unusable = 5 }

function SignalQualityService:Init(ctx)
	config = ctx.Config
end

local function thresholdFor(state: string): number?
	local t = config.Quality.Thresholds
	if state == "Clear" then
		return t.Clear
	elseif state == "Good" then
		return t.Good
	elseif state == "Degraded" then
		return t.Degraded
	elseif state == "Broken" then
		return t.Broken
	end
	return nil
end

-- Pure classification with optional hysteresis against the previous state.
function SignalQualityService:ClassifyMargin(margin: number, previousState: string?): string
	local h = config.Quality.HysteresisDb
	local raw = "Unusable"
	for _, state in ipairs(ORDER) do
		local threshold = thresholdFor(state)
		if threshold and margin >= threshold then
			raw = state
			break
		end
	end
	if previousState and RANK[previousState] and RANK[raw] and raw ~= previousState then
		-- Moving to a worse state requires dropping below the previous threshold by h;
		-- moving to a better state requires exceeding the new threshold by h.
		if RANK[raw] > RANK[previousState] then
			local prevThreshold = thresholdFor(previousState)
			if prevThreshold and margin > prevThreshold - h then
				return previousState
			end
		else
			local newThreshold = thresholdFor(raw)
			if newThreshold and margin < newThreshold + h then
				return previousState
			end
		end
	end
	return raw
end

--[[
	Evaluate(params) -> QualityResult
	params = {
	  SinrDb, RequiredSinrDb, ReceivedPowerDbm, SensitivityDbm,
	  Compatible: boolean, Powered: boolean,
	  Previous: QualityResult?   (for hysteresis and smoothing)
	}
]]
function SignalQualityService:Evaluate(params)
	local q = config.Quality
	local margin = params.SinrDb - params.RequiredSinrDb
	local previous = params.Previous
	local function finite(x: number?): boolean
		return x ~= nil and x == x and x ~= math.huge and x ~= -math.huge
	end
	local smoothed = margin
	if previous and finite(previous.SmoothedMarginDb) and finite(margin) then
		smoothed = previous.SmoothedMarginDb + (margin - previous.SmoothedMarginDb) * q.SmoothingAlpha
	end

	local state
	if not params.Powered then
		state = "Offline"
	elseif params.ReceivedPowerDbm < params.SensitivityDbm - q.SensitivityFloorMarginDb or margin < q.NoSignalMarginDb then
		state = "NoSignal"
	elseif not params.Compatible then
		state = "Incompatible"
	else
		state = self:ClassifyMargin(smoothed, previous and previous.State or nil)
	end

	local usable = state ~= "Offline" and state ~= "NoSignal" and state ~= "Incompatible"
	local score = if usable then RFMath.Logistic(margin, q.ScoreMidpointDb, q.ScoreSlope) else 0
	local packetLoss = if usable then 1 - RFMath.Logistic(margin, q.PacketLossMidpointDb, q.PacketLossSlope) else 1
	local noise = if usable then math.clamp(1 - RFMath.Logistic(margin, 10, 0.3), 0.02, 1) else 1
	local dropout = if usable then math.clamp(packetLoss * 0.8, 0, 1) else 1

	local readability = 1
	if usable then
		readability = math.clamp(math.floor(1 + score * 4.999), 1, 5)
	end
	local aboveSensitivity = params.ReceivedPowerDbm - params.SensitivityDbm
	local strength = math.clamp(math.floor(1 + math.clamp(aboveSensitivity, 0, 40) / 10), 1, 5)
	if params.ReceivedPowerDbm < params.SensitivityDbm then
		strength = 1
	end

	return {
		State = state,
		Score = score,
		MarginDb = margin,
		SmoothedMarginDb = smoothed,
		PacketLoss = packetLoss,
		NoiseLevel = noise,
		DropoutRate = dropout,
		Readability = readability,
		Strength = strength,
	}
end

return SignalQualityService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000018">
				<Properties>
					<string name="Name">SpatialIndex</string>
					<ProtectedString name="Source"><![CDATA[--[[
	SpatialIndex
	Uniform XZ spatial hash used for candidate filtering (interference sources,
	nearby devices, future electronic-support scans). It answers "which devices
	could matter here" cheaply; it never decides whether a link works - the RF
	engine does that with the full propagation model.

	API
	  SpatialIndex.new(cellSize) -> index
	  index:Update(id, position)   insert or move
	  index:Remove(id)
	  index:QueryRadius(position, radius, out?) -> { id }   (cell-conservative)
	  index:Count() -> number
]]

local SpatialIndex = {}
SpatialIndex.__index = SpatialIndex

local OFFSET = 524288 -- 2^19, keeps cell coordinates positive for numeric keys
local STRIDE = 1048576 -- 2^20

local function cellKey(cx: number, cz: number): number
	return (cx + OFFSET) * STRIDE + (cz + OFFSET)
end

function SpatialIndex.new(cellSize: number)
	return setmetatable({
		CellSize = cellSize,
		Cells = {} :: { [number]: { [string]: boolean } },
		ItemCell = {} :: { [string]: number },
		ItemPosition = {} :: { [string]: Vector3 },
		Items = 0,
	}, SpatialIndex)
end

function SpatialIndex:Update(id: string, position: Vector3)
	local cs = self.CellSize
	local key = cellKey(math.floor(position.X / cs), math.floor(position.Z / cs))
	self.ItemPosition[id] = position
	local old = self.ItemCell[id]
	if old == key then
		return
	end
	if old then
		local bucket = self.Cells[old]
		if bucket then
			bucket[id] = nil
			if next(bucket) == nil then
				self.Cells[old] = nil
			end
		end
	else
		self.Items += 1
	end
	local bucket = self.Cells[key]
	if not bucket then
		bucket = {}
		self.Cells[key] = bucket
	end
	bucket[id] = true
	self.ItemCell[id] = key
end

function SpatialIndex:Remove(id: string)
	local old = self.ItemCell[id]
	if not old then
		return
	end
	local bucket = self.Cells[old]
	if bucket then
		bucket[id] = nil
		if next(bucket) == nil then
			self.Cells[old] = nil
		end
	end
	self.ItemCell[id] = nil
	self.ItemPosition[id] = nil
	self.Items -= 1
end

function SpatialIndex:QueryRadius(position: Vector3, radius: number, out: { string }?): { string }
	local result = out or {}
	local cs = self.CellSize
	local minX = math.floor((position.X - radius) / cs)
	local maxX = math.floor((position.X + radius) / cs)
	local minZ = math.floor((position.Z - radius) / cs)
	local maxZ = math.floor((position.Z + radius) / cs)
	local r2 = radius * radius
	local cells = self.Cells
	local positions = self.ItemPosition
	-- For huge radii, iterating items is cheaper than iterating empty cells.
	if (maxX - minX + 1) * (maxZ - minZ + 1) > self.Items * 2 then
		for id, p in pairs(positions) do
			local dx, dz = p.X - position.X, p.Z - position.Z
			if dx * dx + dz * dz <= r2 then
				table.insert(result, id)
			end
		end
		return result
	end
	for cx = minX, maxX do
		for cz = minZ, maxZ do
			local bucket = cells[cellKey(cx, cz)]
			if bucket then
				for id in pairs(bucket) do
					local p = positions[id]
					local dx, dz = p.X - position.X, p.Z - position.Z
					if dx * dx + dz * dz <= r2 then
						table.insert(result, id)
					end
				end
			end
		end
	end
	return result
end

function SpatialIndex:Count(): number
	return self.Items
end

return SpatialIndex
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000019">
				<Properties>
					<string name="Name">TerrainPropagationService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	TerrainPropagationService
	Turns real map geometry (Roblox Terrain + BaseParts) between two endpoints
	into RF propagation losses. This is the module that makes mountains, valleys,
	buildings, forests, tunnels and water matter.

	TWO STAGES
	  1. AnalyzePath(a, b, options) -> PathGeometry          (expensive, CACHED)
	       Frequency-independent geometry gathered with documented spatial APIs:
	         * Workspace:Raycast + RaycastParams / RaycastResult
	         * Terrain:ReadVoxels (terrain solidity / water under the LOS)
	       - Height profile: downward probes into a cached height field
	         (terrain + anchored static structures), sampled along the path
	       - Terrain mass under the line of sight, verified voxel-by-voxel so
	         caves, tunnels, arches and basements are handled correctly
	       - Structure penetrations: forward ray + reverse include-filtered ray
	         per obstacle to measure entry/exit thickness, cumulative walls,
	         cavities inside MeshParts/Unions handled by a forward include ray
	       - Fresnel "spindle" sub-paths (bounded multi-ray sampling) through
	         the first-Fresnel ellipsoid to detect partial obstruction by edges
	       - Vegetation depth (tagged foliage and LeafyGrass/Grass parts)
	       - Water along the path and at submerged endpoints
	  2. ComputeLosses(geometry, frequencyMHz) -> PropagationLosses   (cheap math)
	       - Deygout multi-edge diffraction (ITU-R P.526 J(v)) over the profile
	       - Through-path: terrain penetration + structures + vegetation + water
	       - Over-the-top path: diffraction + clutter around the endpoints
	       - The two paths are combined as incoherent alternative paths, so the
	         least-loss path dominates (signals go OVER a hill rather than
	         THROUGH it, but THROUGH a thin wall rather than over a tall building)

	WHAT IS NOT SIMULATED (documented, not faked)
	  * No specular reflection / multipath ray tracing, no exact UTD diffraction,
	    no waveguide propagation along tunnels. Multipath is represented
	    statistically by the fading model in RFSimulationService.

	CACHING / INVALIDATION
	  * Height field cells (HeightCellStuds) are cached; cleared by region on
	    NotifyTerrainChanged / InvalidateRegion, automatically when large
	    anchored parts are added/removed, and fully after HeightCacheMaxAgeSeconds.
	  * PathGeometry is cached per quantized endpoint pair (symmetric) with a TTL
	    and a region-revision stamp, so map edits invalidate affected paths only.

	PUBLIC API
	  TPS:AnalyzePath(a, b, options) -> PathGeometry?
	      options = { ExcludeInstances: {Instance}?, Priority: number?, Force: boolean?,
	                  SpindleSubPaths: number?, NoCache: boolean? }
	  TPS:ComputeLosses(geometry, frequencyMHz) -> PropagationLosses
	  TPS:SampleGround(x, z, force) -> (groundY?, waterY?, isStructure)
	  TPS:GetEndpointGround(geometry, position) -> groundY
	  TPS:NotifyTerrainChanged(minCorner, maxCorner)   (alias InvalidateRegion)
	  TPS:ClearCaches()
	  TPS:BuildDebugPath(geometry, losses) -> table (for developer visualisation)
	  TPS:GetStats() -> table
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EWShared")
local RFMath = require(Shared.RFMath)
local MaterialProfiles = require(Shared.MaterialProfiles)
local SharedUtilities = require(Shared.SharedUtilities)
local Types = require(Shared.EWTypes)

type PathGeometry = Types.PathGeometry
type PropagationLosses = Types.PropagationLosses
type ObstacleHit = Types.ObstacleHit
type SubPath = Types.SubPath

local TPS = {}

local context
local config
local P -- config.Propagation
local terrain: Terrain = workspace.Terrain

local OFFSET = 524288
local STRIDE = 1048576
local AIR = Enum.Material.Air
local WATER = Enum.Material.Water

-- Height field cache
local heightCache: { [number]: number } = {}
local waterCache: { [number]: number } = {}
local structureCells: { [number]: boolean } = {}
local heightCount = 0
local heightCacheBornAt = os.clock()

-- Region revisions (coarse grid) for path-cache invalidation
local regionRevision: { [number]: number } = {}

-- Path geometry cache
type CacheEntry = { Geometry: PathGeometry, CreatedAt: number, LastUsed: number, Stamp: number }
local pathCache: { [string]: CacheEntry } = {}
local pathCacheCount = 0

-- Classification cache (weak; cleared on maintenance)
local classifyCache = setmetatable({}, { __mode = "k" }) :: { [Instance]: any }

-- Raycast filters
local excludeBase: { Instance } = {}
local vegetationRoots: { Instance } = {}
local filtersDirty = true
local heightParams = RaycastParams.new()
local heightParamsNoWater = RaycastParams.new()
local structParams = RaycastParams.new()
local vegParams = RaycastParams.new()
local includeParams = RaycastParams.new()

local bag = SharedUtilities.ConnectionBag.new()
local pendingInvalidations: { { Min: Vector3, Max: Vector3 } } = {}
local invalidationScheduled = false

local stats = {
	Analyses = 0,
	CacheHits = 0,
	CacheMisses = 0,
	CacheStaleReuse = 0,
	Deferred = 0,
	ProfileOnly = 0,
	HeightProbes = 0,
	HeightRays = 0,
	StructureRays = 0,
	VoxelReads = 0,
	Invalidations = 0,
	AnalysisMsAvg = 0,
	AnalysisMsMax = 0,
	LastAnalysisRays = 0,
}

local VEGETATION_PROFILE = { Key = "Vegetation", Kind = "Vegetation", EntryLossDb = 0, LossDbPerMeter = 0, FrequencyExponent = 0 }

--------------------------------------------------------------------------------
-- Budget helper
--------------------------------------------------------------------------------

type Budget = { Forced: boolean, Rays: number, Voxels: number, Denied: boolean }

local function newBudget(forced: boolean): Budget
	return { Forced = forced, Rays = 0, Voxels = 0, Denied = false }
end

local function useRays(budget: Budget, n: number): boolean
	local scheduler = context.Scheduler
	if budget.Forced then
		scheduler:ConsumeRaycasts(n)
		budget.Rays += n
		return true
	end
	if scheduler:TryConsumeRaycasts(n) then
		budget.Rays += n
		return true
	end
	budget.Denied = true
	return false
end

local function useVoxels(budget: Budget, n: number): boolean
	local scheduler = context.Scheduler
	if budget.Forced then
		scheduler:ConsumeVoxelReads(n)
		budget.Voxels += n
		return true
	end
	if scheduler:TryConsumeVoxelReads(n) then
		budget.Voxels += n
		return true
	end
	budget.Denied = true
	return false
end

--------------------------------------------------------------------------------
-- Filters and part classification
--------------------------------------------------------------------------------

local function markFiltersDirty()
	filtersDirty = true
end

local function rebuildFilters()
	if not filtersDirty then
		return
	end
	filtersDirty = false
	local base = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(base, player.Character)
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged("EWIgnore")) do
		table.insert(base, inst)
	end
	local debugFolder = workspace:FindFirstChild("EWDebug")
	if debugFolder then
		table.insert(base, debugFolder)
	end
	excludeBase = base

	vegetationRoots = CollectionService:GetTagged(P.VegetationTag)

	local heightList = table.clone(base)
	for _, v in ipairs(vegetationRoots) do
		table.insert(heightList, v)
	end
	heightParams.FilterType = Enum.RaycastFilterType.Exclude
	heightParams.FilterDescendantsInstances = heightList
	heightParams.IgnoreWater = false
	heightParams.RespectCanCollide = P.RespectCanCollide
	heightParamsNoWater.FilterType = Enum.RaycastFilterType.Exclude
	heightParamsNoWater.FilterDescendantsInstances = heightList
	heightParamsNoWater.IgnoreWater = true
	heightParamsNoWater.RespectCanCollide = P.RespectCanCollide

	vegParams.FilterType = Enum.RaycastFilterType.Include
	vegParams.FilterDescendantsInstances = vegetationRoots
	vegParams.IgnoreWater = true
	vegParams.RespectCanCollide = false

	structParams.FilterType = Enum.RaycastFilterType.Exclude
	structParams.IgnoreWater = true
	structParams.RespectCanCollide = P.RespectCanCollide

	includeParams.FilterType = Enum.RaycastFilterType.Include
	includeParams.IgnoreWater = true
	includeParams.RespectCanCollide = false

	if P.RaycastCollisionGroup then
		heightParams.CollisionGroup = P.RaycastCollisionGroup
		heightParamsNoWater.CollisionGroup = P.RaycastCollisionGroup
		structParams.CollisionGroup = P.RaycastCollisionGroup
	end
end

local function isIgnoredInstance(part: Instance): boolean
	if part:GetAttribute("EWIgnore") == true or CollectionService:HasTag(part, "EWIgnore") then
		return true
	end
	return false
end

-- Returns the structure material profile for a hit part, or nil if the part is
-- not a significant RF obstacle (decorative, tiny, invisible, character parts).
local function classifyPart(part: BasePart)
	local cached = classifyCache[part]
	if cached ~= nil then
		return cached or nil
	end
	local result = nil
	if part ~= terrain and not isIgnoredInstance(part) then
		local parent = part.Parent
		local override = part:GetAttribute("EWMaterial")
		if override == nil and parent then
			override = parent:GetAttribute("EWMaterial")
		end
		local significant = true
		if override == nil then
			local size = part.Size
			local maxDim = math.max(size.X, size.Y, size.Z)
			if part.Transparency >= P.IgnoreTransparencyAbove then
				significant = false
			elseif maxDim < P.MinObstacleMaxDimension or size.X * size.Y * size.Z < P.MinObstacleVolume then
				significant = false
			elseif parent and (parent:IsA("Accessory") or (parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") ~= nil)) then
				significant = false
			end
		end
		if significant then
			if CollectionService:HasTag(part, P.VegetationTag) then
				result = VEGETATION_PROFILE
			else
				local profile = MaterialProfiles.GetStructure(if type(override) == "string" then override else part.Material.Name)
				if profile.Kind ~= "Ignore" then
					result = profile
				end
			end
		end
	end
	classifyCache[part] = result or false
	return result
end

-- Static surface for the height field: terrain or a significant anchored part.
local function isStaticSurface(inst: Instance): boolean
	if inst == terrain then
		return true
	end
	if not inst:IsA("BasePart") then
		return false
	end
	local part = inst :: BasePart
	if not part.Anchored then
		return false
	end
	local profile = classifyPart(part)
	return profile ~= nil and profile.Kind ~= "Vegetation" and profile.Kind ~= "Water"
end

--------------------------------------------------------------------------------
-- Height field
--------------------------------------------------------------------------------

local function cellKey(cx: number, cz: number): number
	return (cx + OFFSET) * STRIDE + (cz + OFFSET)
end

local function coarseKey(x: number, z: number): number
	local cs = P.RegionRevisionCellStuds
	return cellKey(math.floor(x / cs), math.floor(z / cs))
end

local function probeColumn(x: number, z: number): (number, number?, boolean, number)
	local top = P.HeightProbeTop
	local bottom = P.HeightProbeBottom
	local rays = 1
	local result = workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, bottom - top, 0), heightParams)
	local waterY: number? = nil
	local skips = 0
	while result do
		if result.Material == WATER and waterY == nil then
			waterY = result.Position.Y
			local o = result.Position - Vector3.new(0, 0.05, 0)
			rays += 1
			result = workspace:Raycast(o, Vector3.new(0, bottom - o.Y, 0), heightParamsNoWater)
		elseif not isStaticSurface(result.Instance) and skips < P.MaxSkipHitsPerProbe then
			skips += 1
			local o = result.Position - Vector3.new(0, 0.05, 0)
			rays += 1
			result = workspace:Raycast(o, Vector3.new(0, bottom - o.Y, 0), if waterY then heightParamsNoWater else heightParams)
		else
			break
		end
	end
	if not result then
		return bottom, waterY, false, rays
	end
	return result.Position.Y, waterY, result.Instance ~= terrain, rays
end

-- Ground (top static surface) at a world XZ. Returns nil when not cached and the
-- raycast budget denies a probe (callers degrade gracefully).
function TPS:SampleGround(x: number, z: number, force: boolean?, budget: Budget?): (number?, number?, boolean)
	local cs = P.HeightCellStuds
	local cx, cz = math.floor(x / cs), math.floor(z / cs)
	local key = cellKey(cx, cz)
	local y = heightCache[key]
	if y ~= nil then
		return y, waterCache[key], structureCells[key] == true
	end
	local b = budget or newBudget(force == true)
	-- Reserve two rays (water + ground); extra skip rays are accounted afterwards.
	if not useRays(b, 2) then
		return nil, nil, false
	end
	rebuildFilters()
	local gy, wy, isStructure, rays = probeColumn((cx + 0.5) * cs, (cz + 0.5) * cs)
	if rays > 2 then
		if b.Forced then
			context.Scheduler:ConsumeRaycasts(rays - 2)
		else
			context.Scheduler:TryConsumeRaycasts(rays - 2)
		end
		b.Rays += rays - 2
	end
	stats.HeightProbes += 1
	stats.HeightRays += rays
	heightCache[key] = gy
	if wy then
		waterCache[key] = wy
	end
	if isStructure then
		structureCells[key] = true
	end
	heightCount += 1
	if heightCount > P.MaxHeightCells then
		TPS:ClearCaches()
	end
	return gy, wy, isStructure
end

--------------------------------------------------------------------------------
-- Region revisions / invalidation
--------------------------------------------------------------------------------

local function pathStamp(a: Vector3, b: Vector3): number
	local cs = P.RegionRevisionCellStuds
	local dx, dz = b.X - a.X, b.Z - a.Z
	local length = math.sqrt(dx * dx + dz * dz)
	local steps = math.max(1, math.ceil(length / (cs * 0.5)))
	local sum = 0
	local lastKey = nil
	for i = 0, steps do
		local t = i / steps
		local key = coarseKey(a.X + dx * t, a.Z + dz * t)
		if key ~= lastKey then
			sum += regionRevision[key] or 0
			lastKey = key
		end
	end
	return sum
end

function TPS:InvalidateRegion(minCorner: Vector3, maxCorner: Vector3)
	local lo = Vector3.new(math.min(minCorner.X, maxCorner.X), 0, math.min(minCorner.Z, maxCorner.Z))
	local hi = Vector3.new(math.max(minCorner.X, maxCorner.X), 0, math.max(minCorner.Z, maxCorner.Z))
	stats.Invalidations += 1
	-- Height cells
	local cs = P.HeightCellStuds
	local cx0, cx1 = math.floor(lo.X / cs), math.floor(hi.X / cs)
	local cz0, cz1 = math.floor(lo.Z / cs), math.floor(hi.Z / cs)
	local area = (cx1 - cx0 + 1) * (cz1 - cz0 + 1)
	if area <= heightCount then
		for cx = cx0, cx1 do
			for cz = cz0, cz1 do
				local key = cellKey(cx, cz)
				if heightCache[key] ~= nil then
					heightCache[key] = nil
					waterCache[key] = nil
					structureCells[key] = nil
					heightCount -= 1
				end
			end
		end
	else
		for key in pairs(heightCache) do
			local cx = math.floor(key / STRIDE) - OFFSET
			local cz = (key % STRIDE) - OFFSET
			if cx >= cx0 and cx <= cx1 and cz >= cz0 and cz <= cz1 then
				heightCache[key] = nil
				waterCache[key] = nil
				structureCells[key] = nil
				heightCount -= 1
			end
		end
	end
	-- Region revisions
	local rs = P.RegionRevisionCellStuds
	for rx = math.floor(lo.X / rs), math.floor(hi.X / rs) do
		for rz = math.floor(lo.Z / rs), math.floor(hi.Z / rs) do
			local key = cellKey(rx, rz)
			regionRevision[key] = (regionRevision[key] or 0) + 1
		end
	end
	table.clear(classifyCache)
end

-- Call after scripted terrain edits (Terrain:FillBlock, WriteVoxels, explosions...).
function TPS:NotifyTerrainChanged(minCorner: Vector3, maxCorner: Vector3)
	self:InvalidateRegion(minCorner, maxCorner)
end

function TPS:ClearCaches()
	table.clear(heightCache)
	table.clear(waterCache)
	table.clear(structureCells)
	heightCount = 0
	heightCacheBornAt = os.clock()
	table.clear(pathCache)
	pathCacheCount = 0
	table.clear(classifyCache)
	-- Bump everything: any stale geometry still referenced elsewhere is invalid.
	for key, rev in pairs(regionRevision) do
		regionRevision[key] = rev + 1
	end
end

local function queuePartInvalidation(part: BasePart)
	local size = part.Size
	if math.max(size.X, size.Y, size.Z) < P.AutoInvalidateMinPartSize then
		return
	end
	local cf = part.CFrame
	local half = size / 2
	-- Conservative axis-aligned bounds of the rotated part.
	local r = math.abs(cf.RightVector.X) * half.X + math.abs(cf.UpVector.X) * half.Y + math.abs(cf.LookVector.X) * half.Z
	local f = math.abs(cf.RightVector.Z) * half.X + math.abs(cf.UpVector.Z) * half.Y + math.abs(cf.LookVector.Z) * half.Z
	local p = cf.Position
	table.insert(pendingInvalidations, { Min = Vector3.new(p.X - r, 0, p.Z - f), Max = Vector3.new(p.X + r, 0, p.Z + f) })
	if not invalidationScheduled then
		invalidationScheduled = true
		task.defer(function()
			invalidationScheduled = false
			local list = pendingInvalidations
			pendingInvalidations = {}
			for _, box in ipairs(list) do
				TPS:InvalidateRegion(box.Min, box.Max)
			end
		end)
	end
end

--------------------------------------------------------------------------------
-- Ray tracing helpers
--------------------------------------------------------------------------------

local function castLong(origin: Vector3, unit: Vector3, length: number, params: RaycastParams, budget: Budget): (RaycastResult?, number, boolean)
	-- Splits long rays into segments; returns (result, distanceFromOrigin, budgetOk).
	local segment = config.Units.MaxRaySegmentStuds
	local travelled = 0
	while travelled < length do
		if not useRays(budget, 1) then
			return nil, travelled, false
		end
		local step = math.min(segment, length - travelled)
		local result = workspace:Raycast(origin + unit * travelled, unit * step, params)
		stats.StructureRays += 1
		if result then
			return result, travelled + result.Distance, true
		end
		travelled += step
	end
	return nil, length, true
end

local function isConvexPart(part: BasePart): boolean
	return part:IsA("Part") or part:IsA("WedgePart") or part:IsA("CornerWedgePart") or part:IsA("TrussPart")
end

-- Distance (along the ray) at which the ray leaves the solid piece of `part` it entered at hitDist.
local function findExit(part: BasePart, origin: Vector3, unit: Vector3, hitDist: number, total: number, budget: Budget): (number, boolean)
	local probeLen = math.min(total - hitDist, part.Size.Magnitude + 0.5)
	if probeLen <= 0.02 then
		return hitDist, false
	end
	includeParams.FilterDescendantsInstances = { part }
	local farDist = hitDist + probeLen
	if not isConvexPart(part) then
		-- MeshParts / Unions may contain cavities: find the next entry into the same part.
		if useRays(budget, 1) then
			stats.StructureRays += 1
			local fwd = workspace:Raycast(origin + unit * (hitDist + 0.02), unit * (probeLen - 0.02), includeParams)
			if fwd then
				farDist = hitDist + 0.02 + fwd.Distance
			end
		end
	end
	if not useRays(budget, 1) then
		return math.min(hitDist + 1, total), true
	end
	stats.StructureRays += 1
	local back = workspace:Raycast(origin + unit * farDist, -unit * (farDist - hitDist), includeParams)
	local exitDist = farDist
	if back then
		exitDist = farDist - back.Distance
	end
	if exitDist < hitDist then
		exitDist = hitDist
	end
	return exitDist, (exitDist - hitDist) > P.MaxPenetrationStudsPerObstacle
end

-- Traces significant obstacles between origin and target.
-- mode "Structure": all significant parts (vegetation-material parts add vegetation depth)
-- mode "Vegetation": every hit is vegetation (include-filtered foliage)
local function traceObstacles(
	origin: Vector3,
	target: Vector3,
	params: RaycastParams,
	mode: string,
	distanceOffset: number,
	budget: Budget
): ({ ObstacleHit }, number, boolean, boolean)
	local obstacles: { ObstacleHit } = {}
	local vegetation = 0
	local delta = target - origin
	local total = delta.Magnitude
	if total < 0.05 then
		return obstacles, vegetation, true, false
	end
	local unit = delta / total
	local travelled = 0
	local guard = 0
	local truncated = false
	while travelled < total - 0.05 do
		guard += 1
		if guard > P.MaxObstaclesPerRay * 3 then
			truncated = true
			break
		end
		local result, hitAt, ok = castLong(origin + unit * travelled, unit, total - travelled, params, budget)
		if not ok then
			return obstacles, vegetation, false, truncated
		end
		if not result then
			break
		end
		local hitDist = travelled + hitAt
		local part = result.Instance :: BasePart
		local profile
		if mode == "Vegetation" then
			profile = VEGETATION_PROFILE
		else
			profile = classifyPart(part)
		end
		if not profile then
			-- Insignificant part: continue from just inside it (rays starting inside
			-- a part never hit that part again).
			travelled = hitDist + 0.02
			continue
		end
		local exitDist, capped = findExit(part, origin, unit, hitDist, total, budget)
		local thickness = exitDist - hitDist
		if profile.Kind == "Vegetation" then
			vegetation += thickness
		else
			local fixed = part:GetAttribute("EWAttenuationDb")
			table.insert(obstacles, {
				Instance = part,
				MaterialKey = profile.Key,
				Kind = profile.Kind,
				DistanceFromAStuds = distanceOffset + hitDist,
				ThicknessStuds = thickness,
				EntryPosition = origin + unit * hitDist,
				ExitPosition = origin + unit * exitDist,
				Capped = capped,
				FixedLossDb = if type(fixed) == "number" then fixed else nil,
			} :: any)
			if #obstacles >= P.MaxObstaclesPerRay then
				truncated = true
				break
			end
		end
		travelled = exitDist + 0.02
	end
	return obstacles, vegetation, true, truncated
end

local function readVoxel(position: Vector3): (Enum.Material, number)
	local base = Vector3.new(math.floor(position.X / 4) * 4, math.floor(position.Y / 4) * 4, math.floor(position.Z / 4) * 4)
	local materials, occupancies = terrain:ReadVoxels(Region3.new(base, base + Vector3.new(4, 4, 4)), 4)
	stats.VoxelReads += 1
	return materials[1][1][1], occupancies[1][1][1]
end

--------------------------------------------------------------------------------
-- Path analysis
--------------------------------------------------------------------------------

local function quantKey(p: Vector3): string
	local q = P.PathQuantumStuds
	return string.format("%d,%d,%d", math.floor(p.X / q + 0.5), math.floor(p.Y / q + 0.5), math.floor(p.Z / q + 0.5))
end

local function emptyGeometry(a: Vector3, b: Vector3, mode): PathGeometry
	return {
		A = a,
		B = b,
		DistanceStuds = (b - a).Magnitude,
		HorizontalStuds = Vector2.new(b.X - a.X, b.Z - a.Z).Magnitude,
		SampleCount = 0,
		SampleSpacingStuds = 0,
		SampleDistances = {},
		SampleGround = {},
		SampleLos = {},
		SampleKind = {},
		SampleExcluded = {},
		GroundA = a.Y - 1,
		GroundB = b.Y - 1,
		MeanInteriorGround = math.min(a.Y, b.Y) - 1,
		TerrainSolidStuds = 0,
		TerrainSolidMaterials = {},
		WaterPathStuds = 0,
		CavityStuds = 0,
		EndpointWaterDepthA = 0,
		EndpointWaterDepthB = 0,
		SubPaths = {},
		EndpointClutterRadiusStuds = P.EndpointClutterRadiusStuds,
		Mode = mode,
		RaycastsUsed = 0,
		VoxelReadsUsed = 0,
		ComputedAt = os.clock(),
		Approximate = false,
		Notes = {},
	}
end

-- Floor under an endpoint that sits beneath a roof, overhang or water surface.
local function floorBelow(position: Vector3, budget: Budget): number?
	if not useRays(budget, 1) then
		return nil
	end
	local origin = position
	local direction = Vector3.new(0, math.max(P.HeightProbeBottom - position.Y, -config.Units.MaxRaySegmentStuds), 0)
	if direction.Y >= 0 then
		return nil
	end
	local result = workspace:Raycast(origin, direction, heightParamsNoWater)
	local skips = 0
	while result and not isStaticSurface(result.Instance) and skips < P.MaxSkipHitsPerProbe do
		skips += 1
		if not useRays(budget, 1) then
			return nil
		end
		local o = result.Position - Vector3.new(0, 0.05, 0)
		result = workspace:Raycast(o, Vector3.new(0, math.max(P.HeightProbeBottom - o.Y, -config.Units.MaxRaySegmentStuds), 0), heightParamsNoWater)
	end
	return if result then result.Position.Y else nil
end

local function endpointWaterDepth(position: Vector3, waterY: number?, budget: Budget): number
	if waterY == nil or position.Y >= waterY then
		return 0
	end
	if useVoxels(budget, 1) then
		local material, occupancy = readVoxel(position)
		if material ~= WATER or occupancy < 0.5 then
			return 0 -- air pocket / submerged structure interior
		end
	end
	return waterY - position.Y
end

local function analyze(a: Vector3, b: Vector3, options, budget: Budget, previous: PathGeometry?): PathGeometry
	rebuildFilters()
	local profile = context.Scheduler:GetProfile()
	local geometry = emptyGeometry(a, b, "Full")
	local notes = geometry.Notes
	local D = geometry.DistanceStuds
	local H = geometry.HorizontalStuds
	if D < 0.05 then
		return geometry
	end

	------------------------------------------------------------------ endpoints
	local gA, wA = TPS:SampleGround(a.X, a.Z, budget.Forced, budget)
	local gB, wB = TPS:SampleGround(b.X, b.Z, budget.Forced, budget)
	-- A water surface is the reflecting "ground" for antennas above it.
	geometry.GroundA = if gA then math.max(gA, wA or -math.huge) else (a.Y - 1)
	geometry.GroundB = if gB then math.max(gB, wB or -math.huge) else (b.Y - 1)
	geometry.EndpointWaterDepthA = endpointWaterDepth(a, wA, budget)
	geometry.EndpointWaterDepthB = endpointWaterDepth(b, wB, budget)
	-- Indoors / under cover / submerged: the reflecting ground is the floor below.
	if geometry.GroundA > a.Y then
		geometry.GroundA = floorBelow(a, budget) or (a.Y - 1.5)
	end
	if geometry.GroundB > b.Y then
		geometry.GroundB = floorBelow(b, budget) or (b.Y - 1.5)
	end

	------------------------------------------------------------------ profile
	local maxSamples = math.min(P.ProfileMaxSamples, profile.ProfileMaxSamples)
	local n = 0
	if H >= 1 then
		n = math.clamp(math.floor(H / P.ProfileSpacingStuds), P.ProfileMinSamples, maxSamples)
	end
	local samples = {}
	local missing = 0
	for i = 1, n do
		local t = i / (n + 1)
		local p = a:Lerp(b, t)
		local g, w, isStructure = TPS:SampleGround(p.X, p.Z, budget.Forced, budget)
		if g == nil then
			missing += 1
		elseif w and w > g then
			-- Water surface is the profile surface; LOS below it is checked voxel-wise.
			g = w
		end
		table.insert(samples, { t = t, d = t * D, ground = g, water = w, structure = isStructure, los = p.Y, extra = false })
	end
	if n > 0 and missing > 0 then
		if missing > n * 0.5 then
			geometry.Mode = "Deferred"
			stats.Deferred += 1
			return geometry
		end
		-- Fill gaps by interpolating cached neighbours (marked approximate).
		geometry.Approximate = true
		table.insert(notes, string.format("%d/%d profile cells interpolated (raycast budget)", missing, n))
		for i, s in ipairs(samples) do
			if s.ground == nil then
				local before, after
				for j = i - 1, 1, -1 do
					if samples[j].ground ~= nil then
						before = samples[j]
						break
					end
				end
				for j = i + 1, n do
					if samples[j].ground ~= nil then
						after = samples[j]
						break
					end
				end
				if before and after then
					s.ground = before.ground + (after.ground - before.ground) * ((s.t - before.t) / (after.t - before.t))
				else
					s.ground = (before and before.ground) or (after and after.ground) or math.min(geometry.GroundA, geometry.GroundB)
				end
			end
		end
	end

	------------------------------------------------------------------ structures
	local exclude = table.clone(excludeBase)
	table.insert(exclude, terrain)
	for _, v in ipairs(vegetationRoots) do
		table.insert(exclude, v)
	end
	if options.ExcludeInstances then
		for _, inst in ipairs(options.ExcludeInstances) do
			table.insert(exclude, inst)
		end
	end
	structParams.FilterDescendantsInstances = exclude

	local subPaths: { SubPath } = {}
	local structureOk = true
	local centerObstacles, centerVeg, ok, truncated = traceObstacles(a, b, structParams, "Structure", 0, budget)
	if not ok then
		structureOk = false
	end
	if truncated then
		table.insert(notes, "Obstacle limit reached on center ray (remaining structure treated as one opaque obstacle)")
		table.insert(centerObstacles, {
			Instance = nil,
			MaterialKey = "Default",
			Kind = "Opaque",
			DistanceFromAStuds = D * 0.5,
			ThicknessStuds = P.MaxPenetrationStudsPerObstacle,
			EntryPosition = a:Lerp(b, 0.5),
			ExitPosition = a:Lerp(b, 0.5),
			Capped = true,
		} :: any)
	end
	-- Tagged foliage along the center ray.
	if #vegetationRoots > 0 and structureOk then
		local _, vegLength, vegOk = traceObstacles(a, b, vegParams, "Vegetation", 0, budget)
		if vegOk then
			centerVeg += vegLength
		else
			geometry.Approximate = true
		end
	end
	if structureOk then
		table.insert(subPaths, { Obstacles = centerObstacles, VegetationStuds = centerVeg, Weight = 2, OffsetStuds = 0 })
	end

	-- Fresnel spindle sub-paths.
	local spindles = options.SpindleSubPaths
	if spindles == nil then
		spindles = math.min(P.SpindleSubPaths, profile.SpindleSubPaths)
		if P.SpindleOnlyWhenObstructed and (options.Priority or 2) > 1 and #centerObstacles == 0 then
			spindles = 0
		end
	end
	if structureOk and spindles > 0 and D > 4 then
		local mps = config.Units.MetersPerStud
		local lambda = RFMath.WavelengthMeters(P.SpindleReferenceMHz)
		local half = D * mps / 2
		local radiusStuds = math.min(RFMath.FresnelRadiusMeters(half, half, lambda) * P.SpindleFresnelFraction / mps, P.SpindleMaxOffsetStuds)
		if radiusStuds > 0.5 then
			local dir = (b - a).Unit
			local u = dir:Cross(Vector3.yAxis)
			if u.Magnitude < 1e-3 then
				u = Vector3.xAxis
			end
			u = u.Unit
			local w = u:Cross(dir).Unit
			local offsets = { u, -u, w, -w }
			local mid = a:Lerp(b, 0.5)
			for j = 1, math.min(spindles, 4) do
				local m = mid + offsets[j] * radiusStuds
				local first, vegA, okA = traceObstacles(a, m, structParams, "Structure", 0, budget)
				if not okA then
					geometry.Approximate = true
					break
				end
				local second, vegB, okB = traceObstacles(m, b, structParams, "Structure", (m - a).Magnitude, budget)
				if not okB then
					geometry.Approximate = true
					break
				end
				for _, o in ipairs(second) do
					table.insert(first, o)
				end
				table.insert(subPaths, { Obstacles = first, VegetationStuds = vegA + vegB, Weight = 1, OffsetStuds = radiusStuds })
			end
		end
	end

	if not structureOk then
		if previous and #previous.SubPaths > 0 then
			subPaths = previous.SubPaths
			table.insert(notes, "Structure data reused from previous analysis (raycast budget)")
		else
			geometry.Mode = "ProfileOnly"
			stats.ProfileOnly += 1
			table.insert(notes, "Structure tracing skipped (raycast budget) - terrain only")
		end
		geometry.Approximate = true
	end
	geometry.SubPaths = subPaths

	-- Obstacles on the center ray become explicit diffraction-profile points so a
	-- thin tall wall between two profile samples is never missed.
	if structureOk then
		for _, o in ipairs(centerObstacles) do
			local part = o.Instance
			if part and part:IsA("BasePart") then
				local cf, size = part.CFrame, part.Size
				local half = size / 2
				-- Top of the part's world bounding box (exact for walls, vehicles, crates).
				local aabbTop = cf.Position.Y
					+ math.abs(cf.RightVector.Y) * half.X
					+ math.abs(cf.UpVector.Y) * half.Y
					+ math.abs(cf.LookVector.Y) * half.Z
				local huge = part.Anchored and math.max(size.X, size.Y, size.Z) > 200
				for _, pos in ipairs({ o.EntryPosition, o.ExitPosition }) do
					local top: number = aabbTop
					local w: number? = nil
					if huge then
						-- Very large static meshes (rock formations): the bounding box would
						-- exaggerate, so use the real cached surface height at this point.
						local g, wy = TPS:SampleGround(pos.X, pos.Z, budget.Forced, budget)
						if g then
							top, w = g, wy
						end
					end
					local t = math.clamp((pos - a):Dot(b - a) / (D * D), 0, 1)
					table.insert(samples, { t = t, d = t * D, ground = top, water = w, structure = true, los = a.Y + (b.Y - a.Y) * t, extra = true })
				end
			end
		end
		table.sort(samples, function(x, y)
			return x.d < y.d
		end)
	end

	------------------------------------------------------------------ profile arrays
	local count = #samples
	local spacing = if n > 0 then D / (n + 1) else 0
	local clutterR = P.EndpointClutterRadiusStuds
	local groundExcl = P.EndpointGroundExclusionStuds
	local sumGround, sumCount = 0, 0
	local solidStuds = 0
	local solidMaterials = {}
	local waterStuds = 0
	local cavityStuds = 0
	local voxelChecks = 0
	for i, s in ipairs(samples) do
		geometry.SampleDistances[i] = s.d
		geometry.SampleGround[i] = s.ground
		geometry.SampleLos[i] = s.los
		geometry.SampleKind[i] = if s.structure then 1 else 0
		local fromA, fromB = s.d, D - s.d
		local excluded = fromA < groundExcl or fromB < groundExcl or (s.structure and (fromA < clutterR or fromB < clutterR))
		geometry.SampleExcluded[i] = excluded
		if not excluded and not (s.los < s.ground and s.structure) then
			sumGround += s.ground
			sumCount += 1
		end
		-- Terrain mass / water under the line of sight (regular samples only).
		if not s.extra and spacing > 0 then
			if s.los < s.ground then
				local solid = not s.structure
				local materialName = "Default"
				if voxelChecks < P.MaxVoxelReadsPerPath and useVoxels(budget, 1) then
					voxelChecks += 1
					local p = a:Lerp(b, s.t)
					local material, occupancy = readVoxel(p)
					if material == WATER and occupancy > 0.5 then
						solid = false
						waterStuds += spacing
					elseif material ~= AIR and occupancy > 0.5 then
						solid = true
						materialName = material.Name
					else
						-- Open space under the surface: the line of sight is NOT blocked
						-- here, so the covering surface must not act as a diffraction edge.
						solid = false
						geometry.SampleExcluded[i] = true
						if not s.structure then
							cavityStuds += spacing -- tunnel / cave / bunker (terrain-covered)
						end
					end
				elseif voxelChecks >= P.MaxVoxelReadsPerPath then
					geometry.Approximate = true
				end
				if solid then
					solidStuds += spacing
					solidMaterials[materialName] = (solidMaterials[materialName] or 0) + spacing
				end
			elseif s.water and s.los < s.water then
				waterStuds += spacing
			end
		end
	end
	geometry.SampleCount = count
	geometry.SampleSpacingStuds = spacing
	geometry.MeanInteriorGround = if sumCount > 0 then sumGround / sumCount else math.min(geometry.GroundA, geometry.GroundB)
	geometry.TerrainSolidStuds = solidStuds
	geometry.TerrainSolidMaterials = solidMaterials
	geometry.WaterPathStuds = waterStuds
	geometry.CavityStuds = cavityStuds
	geometry.RaycastsUsed = budget.Rays
	geometry.VoxelReadsUsed = budget.Voxels
	geometry.ComputedAt = os.clock()
	return geometry
end

local function evictIfNeeded()
	if pathCacheCount <= P.PathCacheMaxEntries then
		return
	end
	local cutoff = os.clock() - P.PathCacheTtlSeconds * 0.5
	for key, entry in pairs(pathCache) do
		if entry.LastUsed < cutoff then
			pathCache[key] = nil
			pathCacheCount -= 1
		end
	end
	if pathCacheCount > P.PathCacheMaxEntries * 0.9 then
		table.clear(pathCache)
		pathCacheCount = 0
	end
end

function TPS:AnalyzePath(a: Vector3, b: Vector3, options): PathGeometry?
	options = options or {}
	local t0 = os.clock()
	local ka, kb = quantKey(a), quantKey(b)
	local key, first, second
	if ka <= kb then
		key, first, second = ka .. "|" .. kb, a, b
	else
		key, first, second = kb .. "|" .. ka, b, a
	end
	local now = os.clock()
	local entry = pathCache[key]
	local previous: PathGeometry? = entry and entry.Geometry or nil
	if entry and not options.NoCache then
		local fresh = (now - entry.CreatedAt) <= P.PathCacheTtlSeconds and entry.Stamp == pathStamp(first, second)
		if fresh then
			entry.LastUsed = now
			stats.CacheHits += 1
			return entry.Geometry
		end
	end
	stats.CacheMisses += 1

	local forced = options.Force == true
	-- Not enough budget for a meaningful analysis: reuse stale data if we have it.
	if not forced and context.Scheduler:RemainingRaycasts() < 4 then
		if previous then
			stats.CacheStaleReuse += 1
			return previous
		end
		stats.Deferred += 1
		return nil
	end

	local budget = newBudget(forced)
	local geometry = analyze(first, second, options, budget, previous)
	stats.Analyses += 1
	stats.LastAnalysisRays = budget.Rays
	local ms = (os.clock() - t0) * 1000
	stats.AnalysisMsAvg = stats.AnalysisMsAvg * 0.95 + ms * 0.05
	if ms > stats.AnalysisMsMax then
		stats.AnalysisMsMax = ms
	end
	if geometry.Mode == "Deferred" then
		if previous then
			stats.CacheStaleReuse += 1
			return previous
		end
		return nil
	end
	if not options.NoCache then
		if not pathCache[key] then
			pathCacheCount += 1
		end
		pathCache[key] = { Geometry = geometry, CreatedAt = now, LastUsed = now, Stamp = pathStamp(first, second) }
		evictIfNeeded()
	end
	return geometry
end

--------------------------------------------------------------------------------
-- Frequency-dependent losses
--------------------------------------------------------------------------------

local function waterLossPerMeter(frequencyMHz: number): number
	return P.WaterLossDbPerMeterAt100MHz * (math.max(frequencyMHz, 1) / 100) ^ P.WaterFrequencyExponent
end

local function obstacleLossDb(o, frequencyMHz: number, mps: number): number
	if o.FixedLossDb then
		return o.FixedLossDb
	end
	if o.Kind == "Opaque" or o.Capped then
		return MaterialProfiles.OpaqueLossDb
	end
	local profile = MaterialProfiles.GetStructure(o.MaterialKey)
	return MaterialProfiles.StructureLossDb(profile, o.ThicknessStuds * mps, frequencyMHz)
end

local scratchD = {}
local scratchH = {}
local scratchFlat = {}

function TPS:ComputeLosses(geometry: PathGeometry, frequencyMHz: number): PropagationLosses
	local mps = config.Units.MetersPerStud
	local lambda = RFMath.WavelengthMeters(frequencyMHz)
	local Dm = geometry.DistanceStuds * mps
	local explanation = {}

	------------------------------------------------------------------ diffraction
	-- The plane-earth basic loss already accounts for a smooth ground plane, so
	-- diffraction is reported as the EXCESS of the real profile over a smooth
	-- baseline profile (straight line between the ground under each terminal).
	-- Flat ground therefore adds 0 dB here; ridges, hills and buildings add loss.
	local n = geometry.SampleCount
	local k = P.EarthKFactor
	local baseA = if geometry.GroundA > geometry.A.Y then geometry.A.Y - 1.5 else geometry.GroundA
	local baseB = if geometry.GroundB > geometry.B.Y then geometry.B.Y - 1.5 else geometry.GroundB
	local Ds0 = math.max(geometry.DistanceStuds, 1e-6)
	for i = 1, n do
		local dStuds = geometry.SampleDistances[i]
		local d = dStuds * mps
		local bulge = RFMath.EarthBulgeMeters(d, Dm - d, k)
		scratchD[i] = d
		scratchH[i] = geometry.SampleGround[i] * mps + bulge
		scratchFlat[i] = (baseA + (baseB - baseA) * (dStuds / Ds0)) * mps + bulge
	end
	local deygout = RFMath.DeygoutLossDb(
		scratchD,
		scratchH,
		geometry.SampleExcluded,
		n,
		geometry.A.Y * mps,
		geometry.B.Y * mps,
		Dm,
		lambda,
		P.MaxDiffractionDepth
	)
	local smooth = RFMath.DeygoutLossDb(
		scratchD,
		scratchFlat,
		geometry.SampleExcluded,
		n,
		geometry.A.Y * mps,
		geometry.B.Y * mps,
		Dm,
		lambda,
		P.MaxDiffractionDepth
	)
	local diffraction = math.max(0, deygout.LossDb - smooth.LossDb)
	local principalDistance, principalHeight = nil, nil
	if deygout.PrincipalIndex then
		local i = deygout.PrincipalIndex
		principalDistance = geometry.SampleDistances[i]
		principalHeight = geometry.SampleGround[i] - geometry.SampleLos[i]
		if diffraction > 0.5 then
			table.insert(
				explanation,
				string.format(
					"%s edge %.0f studs from A rises %.1f studs %s the line of sight (v=%.2f): %.1f dB diffraction over %d edge(s)",
					if geometry.SampleKind[i] == 1 then "Structure" else "Terrain",
					principalDistance,
					math.abs(principalHeight),
					if principalHeight >= 0 then "above" else "below",
					deygout.PrincipalV,
					diffraction,
					deygout.Edges
				)
			)
		end
	end

	------------------------------------------------------------------ terrain mass
	local terrainDb = 0
	for materialName, studs in pairs(geometry.TerrainSolidMaterials) do
		local profile = MaterialProfiles.GetTerrain(materialName)
		terrainDb += studs * mps * MaterialProfiles.TerrainLossDbPerMeter(profile, frequencyMHz)
	end
	terrainDb = math.min(terrainDb, P.TerrainPenetrationMaxDb)
	if geometry.TerrainSolidStuds > 0 then
		table.insert(explanation, string.format("Line of sight passes through %.0f studs of solid terrain: %.1f dB if penetrated", geometry.TerrainSolidStuds, terrainDb))
	end

	------------------------------------------------------------------ water
	local wpm = waterLossPerMeter(frequencyMHz)
	local endpointWaterDb = 0
	for _, depth in ipairs({ geometry.EndpointWaterDepthA, geometry.EndpointWaterDepthB }) do
		if depth > 0 then
			endpointWaterDb += P.WaterInterfaceLossDb + depth * mps * wpm
		end
	end
	endpointWaterDb = math.min(endpointWaterDb, P.WaterMaxLossDb)
	if endpointWaterDb > 0 then
		table.insert(explanation, string.format("Submerged endpoint(s): %.1f dB water loss", endpointWaterDb))
	end
	local pathWaterDb = 0
	if geometry.WaterPathStuds > 0 then
		pathWaterDb = math.min(P.WaterInterfaceLossDb + geometry.WaterPathStuds * mps * wpm, P.WaterMaxLossDb)
		table.insert(explanation, string.format("Line of sight crosses %.0f studs of water: %.1f dB", geometry.WaterPathStuds, pathWaterDb))
	end

	------------------------------------------------------------------ cavities (tunnels / caves)
	local cavityDb = 0
	if geometry.CavityStuds > 0 then
		local perMeter = P.CavityLossDbPerMeterAt300MHz * (math.max(frequencyMHz, 1) / 300) ^ P.CavityFrequencyExponent
		cavityDb = math.min(geometry.CavityStuds * mps * perMeter, P.CavityMaxLossDb)
		table.insert(explanation, string.format("Line of sight runs %.0f studs through terrain-covered open space (tunnel/cave): %.1f dB", geometry.CavityStuds, cavityDb))
	end

	------------------------------------------------------------------ structures + vegetation
	local subLosses = {}
	local subWeights = {}
	local centerDb, clutterDb, vegetationDb = 0, 0, 0
	local clutterR = geometry.EndpointClutterRadiusStuds
	local Ds = geometry.DistanceStuds
	local fGHz = frequencyMHz / 1000
	for index, sub in ipairs(geometry.SubPaths) do
		local total = 0
		for _, o in ipairs(sub.Obstacles) do
			local l = obstacleLossDb(o, frequencyMHz, mps)
			total += l
			if index == 1 and (o.DistanceFromAStuds <= clutterR or o.DistanceFromAStuds >= Ds - clutterR) then
				clutterDb += l
			end
		end
		if index == 1 then
			centerDb = total
			-- Foliage is a volume loss along the direct path (Weissberger); it is not
			-- averaged over the spindle paths, which only probe structure edges.
			vegetationDb = math.min(RFMath.WeissbergerLossDb(sub.VegetationStuds * mps, fGHz, P.VegetationMinFrequencyGHz), P.VegetationMaxLossDb)
		end
		table.insert(subLosses, math.min(total, MaterialProfiles.OpaqueLossDb * 2))
		table.insert(subWeights, sub.Weight)
	end
	local structureDb = if #subLosses > 0 then RFMath.PowerAverageLossDb(subLosses, subWeights) else 0
	local center = geometry.SubPaths[1]
	if center and #center.Obstacles > 0 then
		local parts = {}
		for i, o in ipairs(center.Obstacles) do
			if i > 4 then
				table.insert(parts, string.format("+%d more", #center.Obstacles - 4))
				break
			end
			table.insert(parts, string.format("%s %.1f studs (%.1f dB)", o.MaterialKey, o.ThicknessStuds, obstacleLossDb(o, frequencyMHz, mps)))
		end
		table.insert(explanation, string.format("Direct ray penetrates %d obstacle(s): %s", #center.Obstacles, table.concat(parts, ", ")))
	end
	if #geometry.SubPaths > 1 then
		table.insert(explanation, string.format("Fresnel-zone sampling (%d paths): effective structure loss %.1f dB (center %.1f dB)", #geometry.SubPaths, structureDb, centerDb))
	end
	if vegetationDb > 0.1 and center then
		table.insert(explanation, string.format("Vegetation depth %.0f studs: %.1f dB", center.VegetationStuds, vegetationDb))
	end
	if clutterDb > 0 then
		table.insert(explanation, string.format("Obstacles within %d studs of an endpoint (must be passed on any path): %.1f dB", clutterR, clutterDb))
	end

	------------------------------------------------------------------ combine paths
	-- When the direct ray is clear, J(v) already describes the whole terrain
	-- effect (Fresnel-zone intrusion) and there is no separate "through" path.
	-- When the direct ray is blocked, the signal can either be diffracted over
	-- the obstruction or penetrate it; the two are combined as incoherent
	-- alternative paths. Without a real diffraction edge both "paths" would be
	-- the same physical path, so the smaller one is used instead of a power sum.
	local directBlocked = geometry.TerrainSolidStuds > 0 or geometry.WaterPathStuds > 0 or (center ~= nil and #center.Obstacles > 0)
	local overTop = diffraction + clutterDb + endpointWaterDb + cavityDb
	local through = terrainDb + structureDb + vegetationDb + pathWaterDb + endpointWaterDb + cavityDb
	local excess, dominant
	if not directBlocked then
		excess = diffraction + structureDb + vegetationDb + endpointWaterDb + cavityDb
		overTop = excess
		through = excess
		dominant = "Direct"
	elseif diffraction > 0.5 then
		excess = RFMath.ParallelLossDb(overTop, through)
		if math.abs(overTop - through) < 3 then
			dominant = "Mixed"
		elseif overTop < through then
			dominant = "OverTheTop"
		else
			dominant = "Through"
		end
	else
		excess = math.min(overTop, through)
		dominant = if overTop < through then "OverTheTop" else "Through"
	end
	if excess < 0 then
		excess = 0
	end

	local lineOfSight = deygout.PrincipalV < 0 and geometry.TerrainSolidStuds == 0 and (center == nil or #center.Obstacles == 0) and geometry.WaterPathStuds == 0
	local class
	if lineOfSight and excess < P.PartialObstructionMinDb then
		class = "Unobstructed"
	elseif lineOfSight and excess < P.ObstructedMinDb then
		class = "PartiallyObstructed"
	elseif excess < P.PartialObstructionMinDb then
		class = "PartiallyObstructed"
	elseif excess < P.HeavyObstructionMinDb then
		class = "Obstructed"
	else
		class = "HeavilyObstructed"
	end
	if lineOfSight and diffraction > 0 then
		table.insert(explanation, string.format("Line of sight is clear but terrain intrudes into the Fresnel zone (v=%.2f)", deygout.PrincipalV))
	end
	table.insert(
		explanation,
		string.format("Over-the-top path %.1f dB vs through path %.1f dB -> excess %.1f dB (%s, %s)", overTop, through, excess, dominant, class)
	)
	if geometry.Approximate then
		table.insert(explanation, "Approximate: " .. table.concat(geometry.Notes, "; "))
	end

	return {
		FrequencyMHz = frequencyMHz,
		DiffractionDb = diffraction,
		DiffractionEdges = deygout.Edges,
		PrincipalV = deygout.PrincipalV,
		PrincipalEdgeDistanceStuds = principalDistance,
		PrincipalEdgeHeightStuds = principalHeight,
		TerrainPenetrationDb = terrainDb,
		StructureDb = structureDb,
		StructureCenterDb = centerDb,
		EndpointClutterDb = clutterDb,
		VegetationDb = vegetationDb,
		WaterDb = pathWaterDb + endpointWaterDb,
		CavityDb = cavityDb,
		OverTheTopDb = overTop,
		ThroughPathDb = through,
		ExcessDb = excess,
		DominantPath = dominant,
		Class = class,
		LineOfSight = lineOfSight,
		Explanation = explanation,
	}
end

function TPS:GetEndpointGround(geometry: PathGeometry, position: Vector3): number
	if (position - geometry.A).Magnitude <= (position - geometry.B).Magnitude then
		return geometry.GroundA
	end
	return geometry.GroundB
end

-- Serializable path description for the developer debug renderer.
function TPS:BuildDebugPath(geometry: PathGeometry, losses: PropagationLosses?)
	local obstacles = {}
	for subIndex, sub in ipairs(geometry.SubPaths) do
		for _, o in ipairs(sub.Obstacles) do
			table.insert(obstacles, { Entry = o.EntryPosition, Exit = o.ExitPosition, Material = o.MaterialKey, Center = subIndex == 1 })
		end
	end
	local edge = nil
	if losses and losses.PrincipalEdgeDistanceStuds then
		local t = losses.PrincipalEdgeDistanceStuds / math.max(geometry.DistanceStuds, 1e-6)
		local p = geometry.A:Lerp(geometry.B, t)
		edge = Vector3.new(p.X, p.Y + (losses.PrincipalEdgeHeightStuds or 0), p.Z)
	end
	return {
		A = geometry.A,
		B = geometry.B,
		Class = losses and losses.Class or "Unobstructed",
		ExcessDb = losses and losses.ExcessDb or 0,
		Obstacles = obstacles,
		Edge = edge,
	}
end

function TPS:GetStats()
	local out = table.clone(stats)
	out.HeightCells = heightCount
	out.PathCacheEntries = pathCacheCount
	out.HeightCacheAgeSeconds = os.clock() - heightCacheBornAt
	local hits, misses = stats.CacheHits, stats.CacheMisses
	out.CacheHitRate = if hits + misses > 0 then hits / (hits + misses) else 0
	return out
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

function TPS:Init(ctx)
	context = ctx
	config = ctx.Config
	P = config.Propagation
	P.HeightCacheMaxAgeSeconds = P.HeightCacheMaxAgeSeconds or 300
end

function TPS:Start()
	local function onCharacter()
		markFiltersDirty()
	end
	local function hookPlayer(player: Player)
		bag:Add(player.CharacterAdded:Connect(onCharacter))
		bag:Add(player.CharacterRemoving:Connect(onCharacter))
	end
	bag:Add(Players.PlayerAdded:Connect(function(player)
		hookPlayer(player)
		markFiltersDirty()
	end))
	bag:Add(Players.PlayerRemoving:Connect(markFiltersDirty))
	for _, player in ipairs(Players:GetPlayers()) do
		hookPlayer(player)
	end
	for _, tag in ipairs({ "EWIgnore", P.VegetationTag }) do
		bag:Add(CollectionService:GetInstanceAddedSignal(tag):Connect(function()
			markFiltersDirty()
			table.clear(classifyCache)
		end))
		bag:Add(CollectionService:GetInstanceRemovedSignal(tag):Connect(function()
			markFiltersDirty()
			table.clear(classifyCache)
		end))
	end
	-- Large anchored parts appearing/disappearing (buildings spawned, walls destroyed).
	bag:Add(workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("BasePart") and inst.Anchored then
			queuePartInvalidation(inst)
		end
	end))
	bag:Add(workspace.DescendantRemoving:Connect(function(inst)
		if inst:IsA("BasePart") and inst.Anchored then
			queuePartInvalidation(inst)
		end
	end))

	context.Scheduler:AddJob("PropagationCacheMaintenance", config.Scheduler.CacheMaintenanceSeconds, 8, function()
		local now = os.clock()
		for key, entry in pairs(pathCache) do
			if now - entry.CreatedAt > P.PathCacheTtlSeconds * 2 then
				pathCache[key] = nil
				pathCacheCount -= 1
			end
		end
		table.clear(classifyCache)
		if P.HeightCacheMaxAgeSeconds > 0 and now - heightCacheBornAt > P.HeightCacheMaxAgeSeconds then
			-- Self-heal after un-notified map edits.
			TPS:ClearCaches()
		end
	end)
end

return TPS
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX0000001A">
			<Properties>
				<string name="Name">Tests</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX0000001B">
				<Properties>
					<string name="Name">EWTestEnvironment</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EWTestEnvironment
	Builds a reproducible RF test range out of REAL Roblox Terrain and parts at
	EWConfig.TestEnvironment.Origin (default far from typical map content).
	Nothing here scripts an outcome: the stations are ordinary EW devices and
	every result comes from the propagation engine reading this geometry.

	LAYOUT (studs, relative to Origin; flat Grass ground with its top at Y = 0)

	         z = +750   F_W ---------- [ forest ] ---------- F_E
	         z = +400   W_TUNNEL ------------->[ tunnel ]TUNNEL   (tunnel carved into ridge)
	         z = +250   W_RIDGE ------[ RIDGE, top 140 ]------ E_RIDGE      SUMMIT on top, AIR 300 up
	         z = -350   W_OPEN ------------------------------- E_OPEN       (clear line of sight)
	         z = -575                         UW_TX ---- [ pond ] UW_RX (submerged) / SURF_RX (buoy)
	         z = -850..-1150  BLDG_TX ---- RX_OPEN / RX_WOOD / RX_CONCRETE / RX_METAL
	         z = -1300  TC_W ---------- (berm added/removed by test) ---------- TC_E

	Ridge: horizontal terrain cylinder (Rock), radius 210, axis along Z from
	z = -100 to z = +600, crest 140 studs above the plain, ~400 studs wide.
]]

local CollectionService = game:GetService("CollectionService")

local EWTestEnvironment = {}

local RIDGE_RADIUS = 210
local RIDGE_CENTER_Y = -70
local RIDGE_Z0, RIDGE_Z1 = -100, 600
local ANTENNA_HEIGHT = 5.5

-- Property order matters: Shape and Size first, then placement via CFrame, Parent last.
local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	for k, v in pairs(props) do
		if k ~= "Shape" and k ~= "Position" and k ~= "CFrame" and k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	if props.CFrame then
		p.CFrame = props.CFrame
	elseif props.Position then
		p.CFrame = CFrame.new(props.Position)
	end
	if props.Parent then
		p.Parent = props.Parent
	end
	return p
end

function EWTestEnvironment.RidgeHeightAt(x: number): number
	local r2 = RIDGE_RADIUS * RIDGE_RADIUS - x * x
	if r2 <= 0 then
		return 0
	end
	return math.max(0, RIDGE_CENTER_Y + math.sqrt(r2))
end

local function makeBox(parent: Instance, name: string, center: Vector3, inner: Vector3, thickness: number, material: Enum.Material, color: Color3)
	local model = Instance.new("Model")
	model.Name = name
	local t = thickness
	local h = inner.Y
	local walls = {
		{ Vector3.new(inner.X + 2 * t, h, t), Vector3.new(0, h / 2, inner.Z / 2 + t / 2) },
		{ Vector3.new(inner.X + 2 * t, h, t), Vector3.new(0, h / 2, -inner.Z / 2 - t / 2) },
		{ Vector3.new(t, h, inner.Z), Vector3.new(inner.X / 2 + t / 2, h / 2, 0) },
		{ Vector3.new(t, h, inner.Z), Vector3.new(-inner.X / 2 - t / 2, h / 2, 0) },
		{ Vector3.new(inner.X + 2 * t, t, inner.Z + 2 * t), Vector3.new(0, h + t / 2, 0) },
	}
	for i, w in ipairs(walls) do
		part({
			Name = "Wall" .. i,
			Size = w[1],
			Position = center + w[2],
			Material = material,
			Color = color,
			Parent = model,
		})
	end
	model.Parent = parent
	return model
end

-- Creates one EW station: an ordinary device made of a stand and a radio part
-- holding the EWDetectable BoolValue and an EWAntenna attachment.
function EWTestEnvironment.CreateStation(env, name: string, basePosition: Vector3, options)
	options = options or {}
	local model = Instance.new("Model")
	model.Name = "Station_" .. name
	local antennaY = basePosition.Y + (options.AntennaHeight or ANTENNA_HEIGHT)
	if not options.NoStand then
		part({
			Name = "Stand",
			Size = Vector3.new(0.6, antennaY - basePosition.Y - 0.5, 0.6),
			Position = Vector3.new(basePosition.X, (basePosition.Y + antennaY - 0.5) / 2, basePosition.Z),
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Color = Color3.fromRGB(60, 60, 60),
			Parent = model,
		})
	end
	local radio = part({
		Name = "Radio",
		Size = Vector3.new(1, 1, 1),
		Position = Vector3.new(basePosition.X, antennaY - 0.5, basePosition.Z),
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Color = options.Color or Color3.fromRGB(90, 110, 60),
		Material = Enum.Material.SmoothPlastic,
		Parent = model,
	})
	local antenna = Instance.new("Attachment")
	antenna.Name = "EWAntenna"
	antenna.Position = Vector3.new(0, 0.5, 0)
	antenna.Parent = radio
	model.PrimaryPart = radio
	model:SetAttribute("ElectronicType", options.ElectronicType or "Communications")
	model:SetAttribute("SignalProfile", options.Profile or "UHF_FM_VOICE")
	model:SetAttribute("CustomDisplayName", name)
	if options.Channel then
		model:SetAttribute("TransmissionChannel", options.Channel)
	end
	if options.EmissionEnabled ~= nil then
		model:SetAttribute("EmissionEnabled", options.EmissionEnabled)
	end
	local flag = Instance.new("BoolValue")
	flag.Name = "EWDetectable"
	flag.Value = true
	flag.Parent = radio
	model.Parent = env.Folder
	env.Stations[name] = { Model = model, Name = name }
	return model
end

-- Moves a station so its base sits on the ground (or a given Y) at x, z.
function EWTestEnvironment.MoveStation(env, name: string, x: number, z: number, baseY: number?)
	local station = env.Stations[name]
	local y = baseY
	if y == nil then
		y = env.Context.Terrain:SampleGround(env.Origin.X + x, env.Origin.Z + z, true) or env.Origin.Y
	end
	local target = Vector3.new(env.Origin.X + x, (y :: number) + ANTENNA_HEIGHT - 0.5, env.Origin.Z + z)
	station.Model:PivotTo(CFrame.new(target))
	return target + Vector3.new(0, 1, 0) -- antenna position
end

function EWTestEnvironment.GetRecord(env, name: string)
	local station = env.Stations[name]
	return env.Context.Registry:GetByRoot(station.Model)
end

function EWTestEnvironment.Build(context, log: (string) -> ())
	local config = context.Config
	local O: Vector3 = config.TestEnvironment.Origin
	local terrain = workspace.Terrain
	local t0 = os.clock()

	local existing = workspace:FindFirstChild(config.TestEnvironment.FolderName)
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = config.TestEnvironment.FolderName
	folder.Parent = workspace

	local env = {
		Context = context,
		Origin = O,
		Folder = folder,
		Stations = {},
		RidgeTop = RIDGE_CENTER_Y + RIDGE_RADIUS,
	}

	------------------------------------------------------------------ terrain
	-- Ground slab: x -1200..1200, z -1500..900, top at Y = 0 (40 studs thick).
	terrain:FillBlock(CFrame.new(O + Vector3.new(0, -20, -300)), Vector3.new(2400, 40, 2400), Enum.Material.Grass)
	-- Clear anything left above the slab in the lanes we use (previous berm etc.).
	terrain:FillBlock(CFrame.new(O + Vector3.new(0, 100, -1300)), Vector3.new(2400, 200, 200), Enum.Material.Air)
	-- Ridge: horizontal cylinder along Z.
	local ridgeLength = RIDGE_Z1 - RIDGE_Z0
	terrain:FillCylinder(
		CFrame.new(O + Vector3.new(0, RIDGE_CENTER_Y, (RIDGE_Z0 + RIDGE_Z1) / 2)) * CFrame.Angles(math.rad(90), 0, 0),
		ridgeLength,
		RIDGE_RADIUS,
		Enum.Material.Rock
	)
	-- Tunnel into the west flank of the ridge at z = 400 (floor Y = 4, ceiling Y = 16).
	terrain:FillBlock(CFrame.new(O + Vector3.new(-160, 10, 400)), Vector3.new(200, 12, 12), Enum.Material.Air)
	-- Pond: x 400..700, z -650..-500, 24 studs deep.
	terrain:FillBlock(CFrame.new(O + Vector3.new(550, -12, -575)), Vector3.new(300, 24, 150), Enum.Material.Water)
	log(string.format("Terrain built in %.2f s", os.clock() - t0))

	------------------------------------------------------------------ structures
	local structures = Instance.new("Folder")
	structures.Name = "Structures"
	structures.Parent = folder
	-- Light wooden hut, concrete bunker, metal container (each encloses an RX station).
	makeBox(structures, "WoodHut", O + Vector3.new(300, 0, -950), Vector3.new(12, 10, 12), 1, Enum.Material.WoodPlanks, Color3.fromRGB(150, 110, 70))
	makeBox(structures, "ConcreteBunker", O + Vector3.new(300, 0, -1050), Vector3.new(12, 10, 12), 2, Enum.Material.Concrete, Color3.fromRGB(140, 140, 135))
	makeBox(structures, "MetalContainer", O + Vector3.new(300, 0, -1150), Vector3.new(12, 10, 12), 0.3, Enum.Material.DiamondPlate, Color3.fromRGB(80, 95, 80))

	-- Forest patch between F_W and F_E (tagged foliage, canopy spans the antenna height).
	local forest = Instance.new("Folder")
	forest.Name = "Forest"
	forest.Parent = folder
	for ix = -6, 6 do
		for iz = -2, 2 do
			local tree = Instance.new("Model")
			tree.Name = "Tree"
			local x = ix * 22 + (iz % 2) * 11
			local z = 750 + iz * 22
			part({
				Name = "Trunk",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(16, 1.6, 1.6),
				CFrame = CFrame.new(O + Vector3.new(x, 8, z)) * CFrame.Angles(0, 0, math.rad(90)),
				Material = Enum.Material.Wood,
				Color = Color3.fromRGB(90, 64, 40),
				Parent = tree,
			})
			part({
				Name = "Canopy",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(15, 15, 15),
				Position = O + Vector3.new(x, 9, z),
				Material = Enum.Material.LeafyGrass,
				Color = Color3.fromRGB(60, 110, 50),
				CanCollide = false,
				Parent = tree,
			})
			CollectionService:AddTag(tree, "EWVegetation")
			tree.Parent = forest
		end
	end

	------------------------------------------------------------------ stations
	local stations = Instance.new("Folder")
	stations.Name = "Stations"
	stations.Parent = folder
	env.Folder = stations
	local function ground(x, z)
		return context.Terrain:SampleGround(O.X + x, O.Z + z, true) or O.Y
	end
	context.Terrain:ClearCaches()
	local function at(x, z, y)
		return Vector3.new(O.X + x, y or ground(x, z), O.Z + z)
	end

	EWTestEnvironment.CreateStation(env, "W_OPEN", at(-700, -350))
	EWTestEnvironment.CreateStation(env, "E_OPEN", at(700, -350))
	EWTestEnvironment.CreateStation(env, "W_RIDGE", at(-700, 250))
	EWTestEnvironment.CreateStation(env, "E_RIDGE", at(700, 250))
	EWTestEnvironment.CreateStation(env, "SUMMIT", at(0, 250))
	EWTestEnvironment.CreateStation(env, "AIR", at(-700, 250, O.Y + 300), { NoStand = true, Color = Color3.fromRGB(200, 200, 60) })
	EWTestEnvironment.CreateStation(env, "W_TUNNEL", at(-700, 400))
	EWTestEnvironment.CreateStation(env, "TUNNEL", at(-80, 400, O.Y + 4))
	EWTestEnvironment.CreateStation(env, "BLDG_TX", at(-300, -950))
	EWTestEnvironment.CreateStation(env, "RX_OPEN", at(300, -850))
	EWTestEnvironment.CreateStation(env, "RX_WOOD", at(300, -950, O.Y))
	EWTestEnvironment.CreateStation(env, "RX_CONCRETE", at(300, -1050, O.Y))
	EWTestEnvironment.CreateStation(env, "RX_METAL", at(300, -1150, O.Y))
	EWTestEnvironment.CreateStation(env, "TC_W", at(-500, -1300))
	EWTestEnvironment.CreateStation(env, "TC_E", at(500, -1300))
	EWTestEnvironment.CreateStation(env, "F_W", at(-500, 750))
	EWTestEnvironment.CreateStation(env, "F_E", at(500, 750))
	EWTestEnvironment.CreateStation(env, "UW_TX", at(250, -575))
	EWTestEnvironment.CreateStation(env, "SURF_RX", at(550, -545, O.Y - 2.5), { NoStand = true, AntennaHeight = ANTENNA_HEIGHT })
	EWTestEnvironment.CreateStation(env, "UW_RX", at(550, -605, O.Y - 18), { NoStand = true, AntennaHeight = ANTENNA_HEIGHT })
	EWTestEnvironment.CreateStation(env, "MOBILE", at(-700, -700))

	context.Registry:Flush()
	context.Terrain:ClearCaches()
	for name in pairs(env.Stations) do
		local record = EWTestEnvironment.GetRecord(env, name)
		if record then
			context.Registry:RefreshPose(record)
		else
			log("WARNING: station not registered: " .. name)
		end
	end
	log(string.format("Test range ready at %s (%d stations) in %.2f s", tostring(O), #stations:GetChildren(), os.clock() - t0))
	return env
end

-- Adds / removes the terrain berm used by the terrain-change test. Returns the
-- affected region so callers can notify the propagation service.
function EWTestEnvironment.SetBerm(env, present: boolean): (Vector3, Vector3)
	local O = env.Origin
	local center = O + Vector3.new(0, 40, -1300)
	local size = Vector3.new(60, 80, 200)
	workspace.Terrain:FillBlock(CFrame.new(center), size, if present then Enum.Material.Ground else Enum.Material.Air)
	return center - size / 2 - Vector3.new(8, 8, 8), center + size / 2 + Vector3.new(8, 8, 8)
end

return EWTestEnvironment
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000001C">
				<Properties>
					<string name="Name">EWTestRunner</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EWTestRunner
	Phase 1 Studio test suite. Run it by setting the attribute
	ServerScriptService.EWServer.EW_RunTests = true (before or during Play), or
	with the "Run Tests" button in the developer diagnostics panel.

	Every measurement goes through the production code path
	(RFSimulationService:EvaluateLink -> TerrainPropagationService) against real
	Terrain/parts built by EWTestEnvironment. Measurements use Force = true
	(bypass the per-frame budget) and Deterministic = true (no random fading)
	so results are reproducible; Test E deliberately uses the normal scheduler
	path instead.

	Tests: A Boolean registration | L Object lifecycle | B Mountain obstruction
	       TC Terrain change (reproducible) | C Buildings | E Dynamic movement
	       H Airborne | U Underground / water / vegetation | G Interference (core)
	       F Detection eligibility (core) | I Battery | J Security | K Performance
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EWShared")
local SharedUtilities = require(Shared.SharedUtilities)
local Env = require(script.Parent.EWTestEnvironment)

local EWTestRunner = {}

local BANDS = {
	{ Name = "VHF 45 MHz", Profile = "VHF_FM_VOICE", Freq = 45 },
	{ Name = "UHF 300 MHz", Profile = "UHF_FM_VOICE", Freq = 300 },
	{ Name = "L 1350 MHz", Profile = "MANET_DATA_LBAND", Freq = 1350 },
}

local function f1(x: number?): string
	return SharedUtilities.FormatDb(x)
end

local function newCheck(log)
	local check = { Failures = {}, Count = 0 }
	function check.That(cond: boolean, message: string)
		check.Count += 1
		if cond then
			log("    ok   " .. message)
		else
			table.insert(check.Failures, message)
			log("    FAIL " .. message)
		end
	end
	function check.Result(summary: string?)
		return #check.Failures == 0, summary or string.format("%d/%d checks", check.Count - #check.Failures, check.Count)
	end
	return check
end

local function settle(context)
	-- Deferred signal behaviour: let queued events fire, then process the registry queue.
	task.wait()
	context.Registry:Flush()
end

local function setProfile(context, env, names: { string }, band)
	for _, name in ipairs(names) do
		local model = env.Stations[name].Model
		model:SetAttribute("SignalProfile", band.Profile)
		model:SetAttribute("TransmissionChannel", band.Freq)
	end
	settle(context)
end

local function measure(context, env, txName: string, rxName: string, options)
	local tx = Env.GetRecord(env, txName)
	local rx = Env.GetRecord(env, rxName)
	assert(tx, "station not registered: " .. txName)
	assert(rx, "station not registered: " .. rxName)
	return context.RF:EvaluateLink(tx, rx, {
		Force = true,
		Deterministic = true,
		RefreshPose = true,
		IncludeInterference = options and options.Interference or false,
	})
end

local function describe(r): string
	local p = r.Propagation
	if not p then
		return string.format("%s (no propagation: %s)", r.Quality.State, table.concat(r.Reasons, ","))
	end
	return string.format(
		"%-9s margin %6s dB | SINR %6s | Rx %7s dBm | basic %5s (%s) excess %5s [diff %s terr %s struct %s veg %s water %s cav %s] %s/%s | %.0f studs",
		r.Quality.State,
		f1(r.Quality.MarginDb),
		f1(r.SinrDb),
		f1(r.InBandSignalDbm),
		f1(r.BasicLossDb),
		r.BasicModel,
		f1(p.ExcessDb),
		f1(p.DiffractionDb),
		f1(p.TerrainPenetrationDb),
		f1(p.StructureDb),
		f1(p.VegetationDb),
		f1(p.WaterDb),
		f1(p.CavityDb),
		p.Class,
		p.DominantPath,
		r.DistanceStuds
	)
end

local function explain(log, r, limit: number?)
	if r.Propagation then
		for i, line in ipairs(r.Propagation.Explanation) do
			if limit and i > limit then
				break
			end
			log("        . " .. line)
		end
	end
end

--------------------------------------------------------------------------------
-- Tests
--------------------------------------------------------------------------------

local Tests = {}

table.insert(Tests, {
	Name = "A  Boolean registration (EWDetectable only)",
	Run = function(context, env, log)
		local check = newCheck(log)
		local registry = context.Registry
		local model = Instance.new("Model")
		model.Name = "TestA_Device"
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = Vector3.new(3, 2, 2)
		p.Position = env.Origin + Vector3.new(0, 1, -600)
		p.Parent = model
		local flag = Instance.new("BoolValue")
		flag.Name = "EWDetectable"
		flag.Value = true
		flag.Parent = model
		model.Parent = env.Folder
		settle(context)

		local record = registry:GetByRoot(model)
		check.That(record ~= nil, "Model with only a BoolValue registers automatically")
		if not record then
			model:Destroy()
			return check.Result()
		end
		check.That(record.DefinitionId == "Generic", "default definition assigned (Generic)")
		check.That(record.Emitters[1].ProfileId == "UNINTENTIONAL_EMISSION", "default signal profile assigned (UNINTENTIONAL_EMISSION)")
		check.That(record.DetectionClass == "PassiveElectronic", "detection class is PassiveElectronic, not a transmitter")
		check.That(registry:IsEligibleForDetection(record), "eligible for detection while EWDetectable = true")
		local function inDetectable()
			for _, entry in ipairs(context.RF:GetDetectableEmissions()) do
				if entry.Record == record then
					return true
				end
			end
			return false
		end
		check.That(inDetectable(), "weak unintentional emission present in detectable emissions")

		flag.Value = false
		settle(context)
		check.That(registry:GetByRoot(model) == record, "EWDetectable = false keeps the device tracked (state preserved)")
		check.That(not registry:IsEligibleForDetection(record), "EWDetectable = false removes it from detection eligibility")
		check.That(not inDetectable(), "EWDetectable = false removes it from detectable emissions")

		flag.Value = true
		settle(context)
		check.That(registry:IsEligibleForDetection(record), "EWDetectable = true restores eligibility")

		flag:Destroy()
		settle(context)
		check.That(registry:GetByRoot(model) == nil, "removing the BoolValue unregisters the device")

		-- BoolValue inside a BasePart of a Model -> root is the Model.
		local flag2 = Instance.new("BoolValue")
		flag2.Name = "EWDetectable"
		flag2.Value = true
		flag2.Parent = p
		settle(context)
		check.That(registry:GetByRoot(model) ~= nil, "BoolValue inside a BasePart resolves to the parent Model as root")

		-- Lone BasePart in a Folder -> root is the part itself.
		local lone = Instance.new("Part")
		lone.Anchored = true
		lone.Size = Vector3.new(2, 2, 2)
		lone.Position = env.Origin + Vector3.new(10, 1, -600)
		local flag3 = Instance.new("BoolValue")
		flag3.Name = "EWDetectable"
		flag3.Value = true
		flag3.Parent = lone
		lone.Parent = env.Folder
		settle(context)
		check.That(registry:GetByRoot(lone) ~= nil, "BoolValue inside a loose BasePart registers the part as root")

		-- Created with default name, renamed after parenting (common scripting pattern).
		local lateModel = Instance.new("Model")
		local latePart = Instance.new("Part")
		latePart.Anchored = true
		latePart.Position = env.Origin + Vector3.new(20, 1, -600)
		latePart.Parent = lateModel
		lateModel.Parent = env.Folder
		local late = Instance.new("BoolValue")
		late.Value = true
		late.Parent = lateModel
		late.Name = "EWDetectable"
		settle(context)
		task.wait()
		settle(context)
		check.That(registry:GetByRoot(lateModel) ~= nil, "BoolValue renamed to EWDetectable after parenting is detected")

		model:Destroy()
		lone:Destroy()
		lateModel:Destroy()
		settle(context)
		check.That(registry:GetByRoot(model) == nil and registry:GetByRoot(lone) == nil, "destroyed devices are unregistered")
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "L  Object lifecycle (spawn/equip/unequip/move/disable/destroy/recreate)",
	Run = function(context, env, log)
		local check = newCheck(log)
		local registry = context.Registry
		local power = context.Power
		settle(context)
		local baselineConnections = SharedUtilities.GetLiveConnectionCount()
		local baselineDevices = registry:Count()

		local function makeTool(serial: string)
			local tool = Instance.new("Tool")
			tool.Name = "TestL_Radio"
			local handle = Instance.new("Part")
			handle.Name = "Handle"
			handle.Size = Vector3.new(1, 2, 1)
			handle.Anchored = true
			handle.CanCollide = false
			handle.Position = env.Origin + Vector3.new(0, 1.5, -620)
			handle.Parent = tool
			tool:SetAttribute("ElectronicType", "Communications")
			tool:SetAttribute("EWSerial", serial)
			local flag = Instance.new("BoolValue")
			flag.Name = "EWDetectable"
			flag.Value = true
			flag.Parent = handle
			return tool
		end

		local tool = makeTool("TEST-L-001")
		tool.Parent = env.Folder
		settle(context)
		local record = registry:GetByRoot(tool)
		check.That(record ~= nil, "Tool registers with the Tool as root (BoolValue inside Handle)")
		if not record then
			tool:Destroy()
			return check.Result()
		end
		check.That(record.Battery ~= nil, "Communications definition gives the tool a battery")
		power:SetCharge(record, 0.5)

		tool.Parent = ServerStorage
		settle(context)
		check.That(registry:GetByRoot(tool) == nil, "moving the tool out of the world unregisters it")
		tool.Parent = env.Folder
		settle(context)
		local restored = registry:GetByRoot(tool)
		check.That(restored ~= nil, "returning the tool to the world re-registers it")
		if restored then
			local fraction = power:GetBatteryFraction(restored) or -1
			check.That(math.abs(fraction - 0.5) < 0.01, string.format("battery state persisted across containers (%.2f)", fraction))
		end

		-- Real equip / unequip when a player character is available (Play mode).
		local player = Players:GetPlayers()[1]
		local character = player and player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local backpack = player and player:FindFirstChildOfClass("Backpack")
		if humanoid and backpack then
			local handle = tool:FindFirstChild("Handle") :: BasePart
			handle.Anchored = false
			handle.Massless = true
			tool.Parent = backpack
			settle(context)
			local carried = registry:GetByRoot(tool)
			check.That(carried ~= nil and carried.OwnerUserId == player.UserId, "tool in Backpack is registered and owned by the player")
			humanoid:EquipTool(tool)
			task.wait(0.2)
			settle(context)
			local equipped = registry:GetByRoot(tool)
			check.That(equipped ~= nil and equipped == carried, "equipping keeps the same record (no re-registration)")
			humanoid:UnequipTools()
			task.wait(0.2)
			settle(context)
			check.That(registry:GetByRoot(tool) == carried, "unequipping keeps the same record")
			if carried then
				check.That(carried.InWorld, "carried tool has a world position (follows the character)")
			end
		else
			log("    (no player character - equip/unequip checks skipped; run in Play mode to include them)")
		end

		tool:Destroy()
		settle(context)
		check.That(registry:GetByRoot(tool) == nil, "destroying the tool unregisters it")
		local recreated = makeTool("TEST-L-001")
		recreated.Parent = env.Folder
		settle(context)
		local r2 = registry:GetByRoot(recreated)
		check.That(r2 ~= nil, "recreated tool registers")
		if r2 then
			local fraction = power:GetBatteryFraction(r2) or -1
			check.That(math.abs(fraction - 0.5) < 0.01, string.format("state restored by EWSerial after destroy/recreate (%.2f)", fraction))
		end
		recreated:Destroy()

		-- BoolValue moved from one model to another: root migrates.
		local a = Instance.new("Model")
		local pa = Instance.new("Part")
		pa.Anchored = true
		pa.Position = env.Origin + Vector3.new(30, 1, -620)
		pa.Parent = a
		local b = Instance.new("Model")
		local pb = Instance.new("Part")
		pb.Anchored = true
		pb.Position = env.Origin + Vector3.new(40, 1, -620)
		pb.Parent = b
		local flag = Instance.new("BoolValue")
		flag.Name = "EWDetectable"
		flag.Value = true
		flag.Parent = pa
		a.Parent = env.Folder
		b.Parent = env.Folder
		settle(context)
		check.That(registry:GetByRoot(a) ~= nil and registry:GetByRoot(b) == nil, "flag registers its owning model")
		flag.Parent = pb
		settle(context)
		check.That(registry:GetByRoot(a) == nil and registry:GetByRoot(b) ~= nil, "moving the BoolValue migrates the device to the new root")
		a:Destroy()
		b:Destroy()
		task.wait()
		settle(context)
		task.wait()
		settle(context)

		local connections = SharedUtilities.GetLiveConnectionCount()
		check.That(registry:Count() == baselineDevices, string.format("device count back to baseline (%d)", registry:Count()))
		check.That(connections == baselineConnections, string.format("no lingering connections (%d now, %d before)", connections, baselineConnections))
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "B  Mountain obstruction (same distance, open vs ridge)",
	Run = function(context, env, log)
		local check = newCheck(log)
		for _, band in ipairs(BANDS) do
			setProfile(context, env, { "W_OPEN", "E_OPEN", "W_RIDGE", "E_RIDGE", "SUMMIT" }, band)
			local open = measure(context, env, "W_OPEN", "E_OPEN")
			local ridge = measure(context, env, "W_RIDGE", "E_RIDGE")
			local summit = measure(context, env, "SUMMIT", "E_RIDGE")
			log("  " .. band.Name)
			log("    open   " .. describe(open))
			log("    ridge  " .. describe(ridge))
			explain(log, ridge, 3)
			log("    summit " .. describe(summit))
			if band.Freq ~= 1350 then
				check.That(math.abs(open.DistanceStuds - ridge.DistanceStuds) < 1, band.Name .. ": open and ridge pairs are the same distance")
				check.That(ridge.Propagation.ExcessDb >= open.Propagation.ExcessDb + 15, band.Name .. ": ridge adds >= 15 dB excess loss")
				check.That(ridge.SinrDb <= open.SinrDb - 15, band.Name .. ": ridge SINR at least 15 dB worse")
				check.That(ridge.Propagation.Class == "Obstructed" or ridge.Propagation.Class == "HeavilyObstructed", band.Name .. ": ridge path classified obstructed")
				check.That(open.Propagation.Class == "Unobstructed" or open.Propagation.Class == "PartiallyObstructed", band.Name .. ": open path classified unobstructed/partial")
				check.That(summit.Quality.MarginDb >= ridge.Quality.MarginDb + 15, band.Name .. ": moving onto the ridge crest restores the link (>= 15 dB better)")
			else
				check.That(ridge.Quality.MarginDb < open.Quality.MarginDb - 30, band.Name .. ": L-band is far more terrain-sensitive (>= 30 dB worse)")
			end
		end
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "TC Terrain change: adding/removing real Terrain changes link quality",
	Run = function(context, env, log)
		local check = newCheck(log)
		for _, band in ipairs({ BANDS[1], BANDS[2] }) do
			setProfile(context, env, { "TC_W", "TC_E" }, band)
			local before = measure(context, env, "TC_W", "TC_E")
			local lo, hi = Env.SetBerm(env, true)
			context.Terrain:NotifyTerrainChanged(lo, hi)
			local during = measure(context, env, "TC_W", "TC_E")
			lo, hi = Env.SetBerm(env, false)
			context.Terrain:NotifyTerrainChanged(lo, hi)
			local after = measure(context, env, "TC_W", "TC_E")
			log("  " .. band.Name)
			log("    flat        " .. describe(before))
			log("    with berm   " .. describe(during))
			explain(log, during, 2)
			log("    berm removed" .. describe(after))
			check.That(during.Propagation.ExcessDb >= before.Propagation.ExcessDb + 8, band.Name .. ": Terrain:FillBlock berm adds >= 8 dB")
			check.That(during.Quality.MarginDb <= before.Quality.MarginDb - 8, band.Name .. ": link margin drops >= 8 dB with the berm")
			check.That(math.abs(after.Propagation.ExcessDb - before.Propagation.ExcessDb) <= 1.0, band.Name .. ": removing the berm restores the original link (+-1 dB)")
		end
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "C  Building obstruction (open / wood / concrete / metal)",
	Run = function(context, env, log)
		local check = newCheck(log)
		for _, band in ipairs(BANDS) do
			setProfile(context, env, { "BLDG_TX", "RX_OPEN", "RX_WOOD", "RX_CONCRETE", "RX_METAL" }, band)
			local open = measure(context, env, "BLDG_TX", "RX_OPEN")
			local wood = measure(context, env, "BLDG_TX", "RX_WOOD")
			local concrete = measure(context, env, "BLDG_TX", "RX_CONCRETE")
			local metal = measure(context, env, "BLDG_TX", "RX_METAL")
			log("  " .. band.Name)
			log("    open     " .. describe(open))
			log("    wood     " .. describe(wood))
			log("    concrete " .. describe(concrete))
			explain(log, concrete, 2)
			log("    metal    " .. describe(metal))
			local e0, e1, e2, e3 = open.Propagation.ExcessDb, wood.Propagation.ExcessDb, concrete.Propagation.ExcessDb, metal.Propagation.ExcessDb
			check.That(e1 > e0, band.Name .. ": wood hut attenuates more than open space")
			check.That(e2 > e1 + 2, band.Name .. ": concrete bunker attenuates clearly more than wood")
			check.That(e3 > e1 + 5, band.Name .. ": metal container attenuates strongly")
		end
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "E  Dynamic movement (scheduler-driven, no scripted regions)",
	Run = function(context, env, log)
		local check = newCheck(log)
		local band = BANDS[2]
		setProfile(context, env, { "MOBILE", "E_RIDGE" }, band)
		local mobile = Env.GetRecord(env, "MOBILE")
		local rx = Env.GetRecord(env, "E_RIDGE")
		local watchId = context.RF:WatchLink(mobile.Id, rx.Id, { Priority = 1, Deterministic = true, Label = "TestE MOBILE->E_RIDGE" })
		local watch = context.RF:GetWatch(watchId)
		local route = {}
		local function leg(x0, z0, x1, z1, step)
			local d = math.sqrt((x1 - x0) ^ 2 + (z1 - z0) ^ 2)
			local n = math.max(1, math.floor(d / step))
			for i = 0, n do
				local t = i / n
				table.insert(route, { x0 + (x1 - x0) * t, z0 + (z1 - z0) * t })
			end
		end
		leg(-700, -700, -700, 250, 95) -- open -> behind the ridge
		leg(-700, 250, 0, 250, 100) -- climb to the crest
		leg(0, 250, -700, -700, 160) -- back to the start
		local samples = {}
		local evaluationsBefore = watch.Evaluations
		for _, point in ipairs(route) do
			local antenna = Env.MoveStation(env, "MOBILE", point[1], point[2])
			local movedAt = os.clock()
			local deadline = movedAt + 5
			-- Wait for a FRESH scheduler evaluation at the new position (not a stale reuse).
			repeat
				task.wait(0.05)
				local fresh = watch.LastResult ~= nil
					and watch.LastResult.Timestamp >= movedAt
					and watch.LastResult.AnalysisMode ~= "Cached"
					and watch.LastTxPos ~= nil
					and (watch.LastTxPos - antenna).Magnitude < 1.5
			until fresh or os.clock() > deadline
			local r = watch.LastResult
			if r then
				table.insert(samples, { X = point[1], Z = point[2], Margin = r.Quality.MarginDb, State = r.Quality.State, Class = r.Propagation and r.Propagation.Class or "?" })
				log(string.format("    (%5.0f,%5.0f) %-9s margin %6s dB %s", point[1], point[2], r.Quality.State, f1(r.Quality.MarginDb), r.Propagation and r.Propagation.Class or ""))
			end
		end
		context.RF:UnwatchLink(watchId, "TestComplete")
		Env.MoveStation(env, "MOBILE", -700, -700)
		local evaluations = watch.Evaluations - evaluationsBefore
		check.That(#samples >= #route * 0.9, string.format("watched link updated for %d/%d positions", #samples, #route))
		check.That(evaluations >= #route * 0.9, string.format("updates came from the scheduler (%d evaluations, none forced)", evaluations))
		if #samples > 3 then
			local start = samples[1].Margin
			local worst, worstIndex = math.huge, 1
			for i, s in ipairs(samples) do
				if s.Margin < worst then
					worst, worstIndex = s.Margin, i
				end
			end
			local crestIndex = nil
			for i, s in ipairs(samples) do
				if s.X == 0 and s.Z == 250 then
					crestIndex = i
					break
				end
			end
			local finish = samples[#samples].Margin
			check.That(worst <= start - 15, string.format("moving behind the ridge degrades the link (start %s, worst %s at %.0f,%.0f)", f1(start), f1(worst), samples[worstIndex].X, samples[worstIndex].Z))
			if crestIndex then
				check.That(samples[crestIndex].Margin >= worst + 15, "climbing to the crest improves the link >= 15 dB")
			end
			check.That(math.abs(finish - start) <= 2, string.format("returning to the start restores the link (%s vs %s)", f1(finish), f1(start)))
		end
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "H  Airborne platform vs ground (altitude helps, but does not guarantee)",
	Run = function(context, env, log)
		local check = newCheck(log)
		for _, band in ipairs({ BANDS[2], BANDS[3] }) do
			setProfile(context, env, { "AIR", "W_RIDGE", "E_RIDGE", "TUNNEL" }, band)
			local ground = measure(context, env, "W_RIDGE", "E_RIDGE")
			local air = measure(context, env, "AIR", "E_RIDGE")
			local airToTunnel = measure(context, env, "AIR", "TUNNEL")
			log("  " .. band.Name)
			log("    ground->ground " .. describe(ground))
			log("    air->ground    " .. describe(air))
			log("    air->tunnel    " .. describe(airToTunnel))
			check.That(air.Propagation.ExcessDb <= ground.Propagation.ExcessDb - 15, band.Name .. ": elevated platform clears the ridge (>= 15 dB less excess)")
			check.That(air.Quality.MarginDb >= ground.Quality.MarginDb + 15, band.Name .. ": elevated platform link margin >= 15 dB better")
			check.That(airToTunnel.Quality.MarginDb <= air.Quality.MarginDb - 20, band.Name .. ": altitude does not reach a receiver deep in a tunnel")
		end
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "U  Underground, water and vegetation",
	Run = function(context, env, log)
		local check = newCheck(log)
		for _, band in ipairs({ BANDS[1], BANDS[2] }) do
			setProfile(context, env, { "W_TUNNEL", "TUNNEL", "W_RIDGE", "UW_TX", "SURF_RX", "UW_RX", "F_W", "F_E" }, band)
			local aligned = measure(context, env, "W_TUNNEL", "TUNNEL")
			local offAxis = measure(context, env, "W_RIDGE", "TUNNEL")
			local surface = measure(context, env, "UW_TX", "SURF_RX")
			local submerged = measure(context, env, "UW_TX", "UW_RX")
			local forest = measure(context, env, "F_W", "F_E")
			log("  " .. band.Name)
			log("    tunnel (straight, LOS out the mouth) " .. describe(aligned))
			explain(log, aligned, 2)
			log("    tunnel (off-axis through rock)       " .. describe(offAxis))
			log("    buoy antenna above water             " .. describe(surface))
			log("    submerged antenna                    " .. describe(submerged))
			log("    through forest                       " .. describe(forest))
			check.That(offAxis.Propagation.ExcessDb >= aligned.Propagation.ExcessDb + 15, band.Name .. ": receiver deep underground off-axis is heavily degraded")
			check.That(submerged.Propagation.ExcessDb >= surface.Propagation.ExcessDb + 8, band.Name .. ": submerged antenna loses >= 8 dB")
			check.That(forest.Propagation.VegetationDb > 1, band.Name .. ": vegetation contributes attenuation")
			if band.Freq < 100 then
				check.That(aligned.Propagation.ExcessDb >= 20, band.Name .. ": low VHF cannot escape a tunnel (below waveguide cutoff)")
			end
		end
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "G  Interference (core): co-channel degrades, off-channel does not",
	Run = function(context, env, log)
		local check = newCheck(log)
		local band = BANDS[2]
		setProfile(context, env, { "BLDG_TX", "RX_OPEN" }, band)
		local baseline = measure(context, env, "BLDG_TX", "RX_OPEN", { Interference = true })
		local interferer = Env.CreateStation(env, "TEST_INTERFERER", env.Origin + Vector3.new(380, 0, -800), {
			ElectronicType = "ActiveTransmitter",
			Profile = "UHF_FM_VOICE",
			Channel = 300,
			EmissionEnabled = true,
		})
		settle(context)
		local interfered = measure(context, env, "BLDG_TX", "RX_OPEN", { Interference = true })
		interferer:SetAttribute("TransmissionChannel", 310)
		settle(context)
		local offChannel = measure(context, env, "BLDG_TX", "RX_OPEN", { Interference = true })
		log("    baseline     " .. describe(baseline) .. " I=" .. f1(baseline.InterferenceDbm))
		log("    co-channel   " .. describe(interfered) .. " I=" .. f1(interfered.InterferenceDbm))
		log("    off-channel  " .. describe(offChannel) .. " I=" .. f1(offChannel.InterferenceDbm))
		check.That(interfered.SinrDb <= baseline.SinrDb - 10, "co-channel emitter reduces SINR >= 10 dB")
		check.That(math.abs(offChannel.SinrDb - baseline.SinrDb) <= 1, "emitter moved 10 MHz away has no effect")
		local rx = Env.GetRecord(env, "RX_OPEN")
		check.That(rx.PowerState == "On", "interference degrades communication without powering the receiver down")
		interferer:Destroy()
		env.Stations.TEST_INTERFERER = nil
		settle(context)
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "F  Detection eligibility (core): active, deactivated, non-detectable",
	Run = function(context, env, log)
		local check = newCheck(log)
		local beacon = Env.CreateStation(env, "TEST_BEACON", env.Origin + Vector3.new(0, 0, -700), {
			ElectronicType = "ActiveTransmitter",
			Profile = "BEACON_UHF",
			EmissionEnabled = true,
		})
		settle(context)
		local record = Env.GetRecord(env, "TEST_BEACON")
		local function listed(list)
			for _, entry in ipairs(list) do
				if entry.Record == record then
					return true
				end
			end
			return false
		end
		check.That(listed(context.RF:GetDetectableEmissions()), "active detectable transmitter is listed")
		beacon:SetAttribute("EmissionEnabled", false)
		settle(context)
		check.That(not listed(context.RF:GetActiveEmissions()), "deactivated transmitter stops emitting")
		beacon:SetAttribute("EmissionEnabled", true)
		local flag = beacon:FindFirstChild("EWDetectable", true) :: BoolValue
		flag.Value = false
		settle(context)
		check.That(listed(context.RF:GetActiveEmissions()), "EWDetectable = false: still physically emitting")
		check.That(not listed(context.RF:GetDetectableEmissions()), "EWDetectable = false: excluded from detection results")
		beacon:Destroy()
		env.Stations.TEST_BEACON = nil
		settle(context)
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "I  Battery exhaustion, replacement and boot",
	Run = function(context, env, log)
		local check = newCheck(log)
		local power = context.Power
		setProfile(context, env, { "W_OPEN", "E_OPEN" }, BANDS[2])
		local tx = Env.GetRecord(env, "W_OPEN")
		local idle = power:CurrentDrawW(tx)
		context.Registry:SetEmitterTransmitting(tx, 1, true)
		local keyed = power:CurrentDrawW(tx)
		context.Registry:SetEmitterTransmitting(tx, 1, false)
		check.That(keyed > idle * 2, string.format("transmitting draws more power (%.1f W vs %.1f W)", keyed, idle))
		local before = measure(context, env, "W_OPEN", "E_OPEN")
		power:SetCharge(tx, 0)
		local dead = measure(context, env, "W_OPEN", "E_OPEN")
		check.That(tx.PowerState == "Depleted", "empty battery shuts the radio down (Depleted)")
		check.That(dead.Quality.State == "Offline", "link is Offline while the transmitter is depleted")
		local ok = power:SetPower(tx, true)
		check.That(not ok, "cannot power on with an empty battery")
		power:ReplaceBattery(tx, 1)
		check.That(tx.PowerState == "Off", "battery swap leaves the radio Off")
		power:SetPower(tx, true)
		check.That(tx.PowerState == "Booting", "power-on starts the boot sequence")
		local deadline = os.clock() + 6
		repeat
			task.wait(0.25)
		until tx.PowerState == "On" or os.clock() > deadline
		check.That(tx.PowerState == "On", "boot completes")
		local after = measure(context, env, "W_OPEN", "E_OPEN")
		check.That(after.Quality.State == before.Quality.State, "link quality returns after battery replacement")
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "J  Security validation (server-side)",
	Run = function(context, env, log)
		local check = newCheck(log)
		local security = context.Security
		local schema = {
			Action = { Type = "string", Enum = { "TogglePower", "SetPower", "QueryStatus" } },
			Device = { Type = "Instance" },
			On = { Type = "boolean", Optional = true },
		}
		local someDevice = env.Stations.W_OPEN.Model
		local cases = {
			{ "non-table payload", "TogglePower" },
			{ "missing device", { Action = "TogglePower" } },
			{ "wrong device type", { Action = "TogglePower", Device = "W_OPEN" } },
			{ "unknown action", { Action = "Explode", Device = someDevice } },
			{ "unexpected field", { Action = "TogglePower", Device = someDevice, Range = 1e9 } },
			{ "oversized string", { Action = string.rep("A", 500), Device = someDevice } },
			{ "wrong field type", { Action = "SetPower", Device = someDevice, On = "yes" } },
		}
		for _, case in ipairs(cases) do
			local ok, reason = security:ValidatePayload(case[2], schema)
			check.That(not ok, "rejects " .. case[1] .. " (" .. tostring(reason) .. ")")
		end
		local valid = security:ValidatePayload({ Action = "SetPower", Device = someDevice, On = true }, schema)
		check.That(valid, "accepts a well-formed request")

		local fakePlayer = { UserId = -42, Name = "FakePlayer", Character = nil }
		local allowed = 0
		for _ = 1, 30 do
			if security:CheckRate(fakePlayer :: any, "DeviceCommand") then
				allowed += 1
			end
		end
		check.That(allowed < 30, string.format("rate limiter blocks a 30-request burst (%d allowed)", allowed))

		local record = Env.GetRecord(env, "W_OPEN")
		local ok1, why1 = security:CanControlDevice(fakePlayer :: any, record)
		check.That(not ok1, "world device cannot be controlled without a nearby character (" .. tostring(why1) .. ")")
		local previousOwner = record.OwnerUserId
		record.OwnerUserId = 999999
		local ok2, why2 = security:CanControlDevice(fakePlayer :: any, record)
		record.OwnerUserId = previousOwner
		check.That(not ok2 and why2 == "NOT_OWNER", "another player's carried device cannot be controlled")
		local player = Players:GetPlayers()[1]
		if player and player.Character then
			local ok3, why3 = security:CanControlDevice(player, Env.GetRecord(env, "E_OPEN"))
			check.That(not ok3, "real player far from a world device is refused (" .. tostring(why3) .. ")")
		end
		log("    Client-side remote abuse test: see docs/PHASE1_GUIDE.md (Test J)")
		return check.Result()
	end,
})

table.insert(Tests, {
	Name = "K  Performance stress (moving devices, watched links, active emitters)",
	Run = function(context, env, log)
		local check = newCheck(log)
		local scheduler = context.Scheduler
		local profile, profileName = scheduler:GetProfile()
		local deviceCount, linkCount, emitterCount = 60, 40, 6
		local folder = Instance.new("Folder")
		folder.Name = "StressDevices"
		folder.Parent = env.Folder
		local models = {}
		for i = 1, deviceCount do
			local angle = (i / deviceCount) * math.pi * 2
			local radius = 300 + (i % 5) * 120
			local x, z = math.cos(angle) * radius, -350 + math.sin(angle) * radius * 0.6
			local model = Env.CreateStation(env, "STRESS_" .. i, env.Origin + Vector3.new(x, 0, z), {
				Profile = "UHF_FM_VOICE",
				Channel = 300 + (i % 4) * 0.025,
				EmissionEnabled = i <= emitterCount,
			})
			model.Parent = folder
			table.insert(models, { Model = model, Angle = angle, Radius = radius })
		end
		settle(context)
		local watchIds = {}
		for i = 1, linkCount do
			local a = Env.GetRecord(env, "STRESS_" .. i)
			local b = Env.GetRecord(env, "STRESS_" .. ((i + 17) % deviceCount + 1))
			if a and b then
				table.insert(watchIds, context.RF:WatchLink(a.Id, b.Id, { Priority = 2 }))
			end
		end
		scheduler:ResetMaxima()
		local before = scheduler:GetStats()
		local rfBefore = context.RF:GetStats()
		local terrainBefore = context.Terrain:GetStats()
		local t0 = os.clock()
		local duration = 10
		local mover = RunService.Heartbeat:Connect(function(dt)
			for _, m in ipairs(models) do
				m.Angle += dt * 0.15
				local x, z = math.cos(m.Angle) * m.Radius, -350 + math.sin(m.Angle) * m.Radius * 0.6
				m.Model:PivotTo(CFrame.new(env.Origin + Vector3.new(x, 5, z)))
			end
		end)
		task.wait(duration)
		mover:Disconnect()
		local elapsed = os.clock() - t0
		local after = scheduler:GetStats()
		local rfAfter = context.RF:GetStats()
		local terrainAfter = context.Terrain:GetStats()
		local frames = after.Frames - before.Frames
		local evaluations = rfAfter.WatchEvaluations - rfBefore.WatchEvaluations
		local rays = after.RaycastsTotal - before.RaycastsTotal
		local overBudget = after.OverBudgetFrames - before.OverBudgetFrames
		local hits = terrainAfter.CacheHits - terrainBefore.CacheHits
		local misses = terrainAfter.CacheMisses - terrainBefore.CacheMisses
		log(string.format("    profile %s: %d devices (%d emitting), %d watched links, %.1f s", profileName, deviceCount, emitterCount, #watchIds, elapsed))
		log(string.format("    frames %d | EW frame cost avg %.2f ms max %.2f ms (budget %.1f ms) | over-budget frames %d", frames, after.FrameCostMsAvg, after.FrameCostMsMax, profile.FrameBudgetMs, overBudget))
		log(string.format("    link evaluations %d (%.0f/s) | raycasts %d (%.0f/s, budget %d/frame) | path cache hits %d misses %d", evaluations, evaluations / elapsed, rays, rays / elapsed, profile.RaycastsPerFrame, hits, misses))
		for _, job in ipairs(after.Jobs) do
			log(string.format("      job %-28s avg %.3f ms max %.3f ms runs %d skipped %d errors %d", job.Name, job.AvgCostMs, job.MaxCostMs, job.Runs, job.Skipped, job.Errors))
		end
		check.That(evaluations >= #watchIds, "every watched link was evaluated at least once under load")
		check.That(after.FrameCostMsAvg <= profile.FrameBudgetMs * 1.5, "average EW frame cost stays near the profile budget")
		check.That(rays / math.max(frames, 1) <= profile.RaycastsPerFrame * 1.1, "raycast usage respects the per-frame budget")
		for _, id in ipairs(watchIds) do
			context.RF:UnwatchLink(id, "TestComplete")
		end
		for i = 1, deviceCount do
			env.Stations["STRESS_" .. i] = nil
		end
		folder:Destroy()
		settle(context)
		return check.Result()
	end,
})

--------------------------------------------------------------------------------
-- Runner
--------------------------------------------------------------------------------

function EWTestRunner.RunAll(context, log: (string) -> ())
	log("==== EW PHASE 1 TEST SUITE ====")
	log(string.format("MetersPerStud %.2f | RangeScale %.1f", context.Config.Units.MetersPerStud, context.Config.Units.RangeScale))
	local env = Env.Build(context, log)
	local results = {}
	for _, test in ipairs(Tests) do
		log("---- " .. test.Name)
		local t0 = os.clock()
		local ok, passed, summary = pcall(test.Run, context, env, log)
		if not ok then
			log("    ERROR " .. tostring(passed))
			table.insert(results, { Name = test.Name, Passed = false, Summary = "error: " .. tostring(passed) })
		else
			table.insert(results, { Name = test.Name, Passed = passed, Summary = summary })
		end
		log(string.format("     => %s (%.1f s)", if ok and passed then "PASS" else "FAIL", os.clock() - t0))
	end
	log("==== SUMMARY ====")
	local passedCount = 0
	for _, r in ipairs(results) do
		if r.Passed then
			passedCount += 1
		end
		log(string.format("  %s  %s  (%s)", if r.Passed then "PASS" else "FAIL", r.Name, r.Summary))
	end
	log(string.format("%d/%d tests passed. Test range kept at %s for inspection.", passedCount, #results, tostring(env.Origin)))
	return results
end

return EWTestRunner
